---
interface Props {
  type?: 'LocalBusiness' | 'TouristAttraction' | 'WebSite';
  name?: string;
  description?: string;
  image?: string;
}

const {
  type = 'TouristAttraction',
  name = "Robbie's of Islamorada",
  description = "World-famous tarpon feeding marina, boat rentals, charter fishing, & seaside dining in Islamorada, Florida Keys.",
  image = "https://robbies.com/assets/home/hero-tarpon.jpg"
} = Astro.props;

const schemaData = {
  "@context": "https://schema.org",
  "@type": type,
  "name": name,
  "description": description,
  "image": image,
  "url": "https://robbies.com",
  "telephone": "+1-305-664-8070",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "77522 Overseas Hwy",
    "addressLocality": "Islamorada",
    "addressRegion": "FL",
    "postalCode": "33036",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 24.8967,
    "longitude": -80.6865
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "opens": "07:00",
      "closes": "20:00"
    }
  ],
  "sameAs": [
    "https://www.facebook.com/robbiesmarina",
    "https://www.instagram.com/robbiesmarina"
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
