---
import { ChevronLeft, ChevronRight } from '@lucide/astro';

const slides = [
  {
    id: 1,
    title: "PARTY BOAT FISHING",
    subtitle: "Get ready for the fishing trip of a lifetime!",
    buttonText: "BOOK ONLINE NOW",
    buttonUrl: "https://www.robbies.com/islamorada-fishing.htm",
    image: "/assets/home/imgi_218_CAPTAIN-MICHAEL-PARTYBOAT-FISHING.webp"
  },
  {
    id: 2,
    title: "BEACH DINING",
    subtitle: "Monday - Saturday: 10:30 AM - Sunset<br />Sunday: 11 AM - Sunset",
    buttonText: "",
    buttonUrl: "#",
    image: "/assets/home/imgi_30_Beach-Dining-is-Back-1.webp"
  },
  {
    id: 3,
    title: "THE HUNGRY TARPON RESTAURANT",
    subtitle: "Keys-style waterfront Restaurant and Bar with scenic views and a tropical atmosphere!",
    buttonText: "HUNGRY TARPON MENU",
    buttonUrl: "https://www.robbies.com/hungry-tarpon-restaurant.htm",
    image: "/assets/home/imgi_32_hungry-tarpon.webp"
  },
  {
    id: 4,
    title: "FEED THE TARPON",
    subtitle: "Best Tarpon Feeding in Islamorada, Florida",
    buttonText: "LEARN MORE",
    buttonUrl: "https://www.robbies.com/tarpon-feeding.htm",
    image: "/assets/home/imgi_31_Feed-Tarpon.webp"
  },
  {
    id: 5,
    title: "FLORIDA KEYS SNORKELING",
    subtitle: "Best Snorkeling Tours in Islamorada, Florida",
    buttonText: "BOOK ONLINE NOW",
    buttonUrl: "https://www.robbies.com/",
    image: "/assets/home/imgi_210_snork.webp"
  },
  {
    id: 6,
    title: "EXPERIENCE LUXURY ON FOUR ACES",
    subtitle: "Experience Luxury on Four Aces",
    buttonText: "LEARN MORE",
    buttonUrl: "https://www.robbies.com/",
    image: "/assets/home/imgi_211_luxury.webp"
  }
];
---

<!-- Full-Width Showcase Carousel (Flechas compactas elegantes, Imágenes Alta Res, Barra Indicadora y Sombras Sutiles) -->
<section class="w-full relative overflow-hidden bg-slate-950 select-none">
  <div 
    id="home-carousel-wrapper"
    class="relative w-full h-[65vh] sm:h-[75vh] md:h-[82vh] lg:h-[88vh] min-h-[520px] max-h-[850px] cursor-grab active:cursor-grabbing overflow-hidden"
  >
    <!-- Slides Track -->
    <div id="home-carousel-track" class="w-full h-full relative">
      {slides.map((slide, index) => (
        <div 
          class={`carousel-slide absolute inset-0 w-full h-full transition-all duration-700 ease-in-out ${index === 0 ? 'opacity-100 z-10 scale-100 pointer-events-auto' : 'opacity-0 z-0 scale-95 pointer-events-none'}`}
          data-index={index}
        >
          <!-- High-Res Background Image -->
          <img 
            src={slide.image} 
            alt={slide.title} 
            class="w-full h-full object-cover block"
            loading={index === 0 ? "eager" : "lazy"}
          />

          <!-- Overlay Text Content Box -->
          <div class="absolute inset-0 z-20 max-w-[1180px] mx-auto px-6 sm:px-12 md:px-16 flex items-center justify-center sm:justify-start">
            <div class="max-w-2xl text-center sm:text-left text-white my-auto">
              
              <!-- Title -->
              <h2 class="font-heading font-black text-2xl xs:text-3xl sm:text-4xl md:text-[46px] lg:text-[54px] text-white tracking-tight uppercase leading-[1.12] mb-3 sm:mb-4 drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]">
                {slide.title}
              </h2>

              <!-- Subtitle -->
              <p class="font-heading font-normal text-base sm:text-xl md:text-[22px] lg:text-[25px] text-white/95 tracking-wide mb-6 sm:mb-8 leading-relaxed drop-shadow-[0_1px_3px_rgba(0,0,0,0.5)]" set:html={slide.subtitle}>
              </p>

              <!-- CTA Button -->
              {slide.buttonText && (
                <div>
                  <a 
                    href={slide.buttonUrl} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center justify-center bg-[#2B447A] hover:bg-[#1F3664] text-white font-heading font-extrabold text-xs sm:text-sm uppercase tracking-widest px-8 sm:px-11 py-3.5 sm:py-4 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-[1.03] active:scale-95 border border-white/20"
                  >
                    {slide.buttonText}
                  </a>
                </div>
              )}

            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Navigation Arrow Left (<) - Tamaño compacto y elegante -->
    <button 
      id="carousel-prev-btn"
      aria-label="Previous Slide"
      class="absolute left-2.5 sm:left-5 top-1/2 -translate-y-1/2 z-30 p-2 sm:p-2.5 bg-black/30 hover:bg-[#2B447A] text-white rounded-full transition-all duration-200 focus:outline-none backdrop-blur-xs border border-white/20 hover:scale-105 cursor-pointer shadow-md"
    >
      <ChevronLeft class="w-4 h-4 sm:w-5 sm:h-5 stroke-[2]" />
    </button>

    <!-- Navigation Arrow Right (>) - Tamaño compacto y elegante -->
    <button 
      id="carousel-next-btn"
      aria-label="Next Slide"
      class="absolute right-2.5 sm:right-5 top-1/2 -translate-y-1/2 z-30 p-2 sm:p-2.5 bg-black/30 hover:bg-[#2B447A] text-white rounded-full transition-all duration-200 focus:outline-none backdrop-blur-xs border border-white/20 hover:scale-105 cursor-pointer shadow-md"
    >
      <ChevronRight class="w-4 h-4 sm:w-5 sm:h-5 stroke-[2]" />
    </button>

    <!-- Horizontal Progress Indicator Bar -->
    <div class="absolute bottom-6 inset-x-0 z-30 max-w-[280px] xs:max-w-[340px] sm:max-w-[420px] mx-auto px-4">
      <div class="relative w-full h-1.5 bg-white/25 rounded-full overflow-hidden backdrop-blur-xs border border-white/10">
        <div 
          id="carousel-progress-bar" 
          class="absolute top-0 left-0 h-full bg-white transition-all duration-500 ease-out rounded-full shadow-sm" 
          style="width: 16.66%;"
        ></div>
      </div>
    </div>

  </div>
</section>

<!-- Inline Script for Carousel Navigation, Progress Bar, Mouse Drag & Touch Swipe -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', initHomeCarousel);
  document.addEventListener('astro:page-load', initHomeCarousel);

  function initHomeCarousel() {
    const wrapper = document.getElementById('home-carousel-wrapper');
    const slides = document.querySelectorAll('.carousel-slide');
    const progressBar = document.getElementById('carousel-progress-bar');
    const prevBtn = document.getElementById('carousel-prev-btn');
    const nextBtn = document.getElementById('carousel-next-btn');

    if (!wrapper || slides.length === 0) return;

    let currentIndex = 0;
    const totalSlides = slides.length;
    let autoRotateTimer;
    let startX = 0;
    let currentX = 0;
    let isDragging = false;

    function goToSlide(index) {
      const targetIndex = (index + totalSlides) % totalSlides;
      
      slides.forEach((slide, i) => {
        if (i === targetIndex) {
          slide.classList.remove('opacity-0', 'z-0', 'scale-95', 'pointer-events-none');
          slide.classList.add('opacity-100', 'z-10', 'scale-100', 'pointer-events-auto');
        } else {
          slide.classList.remove('opacity-100', 'z-10', 'scale-100', 'pointer-events-auto');
          slide.classList.add('opacity-0', 'z-0', 'scale-95', 'pointer-events-none');
        }
      });

      if (progressBar) {
        const stepWidth = 100 / totalSlides;
        progressBar.style.width = `${stepWidth}%`;
        progressBar.style.transform = `translateX(${targetIndex * 100}%)`;
      }

      currentIndex = targetIndex;
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function resetAutoRotate() {
      clearInterval(autoRotateTimer);
      autoRotateTimer = setInterval(nextSlide, 5000);
    }

    // Button Click Listeners
    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      nextSlide();
      resetAutoRotate();
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      prevSlide();
      resetAutoRotate();
    });

    // Mouse Drag & Touch Swipe Support
    wrapper.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.clientX;
      currentX = e.clientX;
    });

    wrapper.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      currentX = e.clientX;
    });

    wrapper.addEventListener('mouseup', () => {
      if (!isDragging) return;
      isDragging = false;
      const diffX = currentX - startX;
      if (diffX < -40) {
        nextSlide();
        resetAutoRotate();
      } else if (diffX > 40) {
        prevSlide();
        resetAutoRotate();
      }
    });

    // Touch events for mobile swiping
    wrapper.addEventListener('touchstart', (e) => {
      isDragging = true;
      startX = e.touches[0].clientX;
      currentX = e.touches[0].clientX;
    }, { passive: true });

    wrapper.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      currentX = e.touches[0].clientX;
    }, { passive: true });

    wrapper.addEventListener('touchend', () => {
      if (!isDragging) return;
      isDragging = false;
      const diffX = currentX - startX;
      if (diffX < -40) {
        nextSlide();
        resetAutoRotate();
      } else if (diffX > 40) {
        prevSlide();
        resetAutoRotate();
      }
    });

    // Start auto rotation
    resetAutoRotate();
  }

  initHomeCarousel();
</script>
