---
import { MapPin } from '@lucide/astro';

const mapUrl = "https://www.google.com/maps?cid=8034933612749494732&g_mp=CiVnb29nbGUubWFwcy5wbGFjZXMudjEuUGxhY2VzLkdldFBsYWNlEAMYASAF&hl=en&gl=EC&source=embed";
const embedMapUrl = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3618.358509804245!2d-80.690772!3d24.882662!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88d739d9432cadf7%3A0x6f81d18cc5c799cc!2sRobbie's%20of%20Islamorada!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus";
---

<!-- Section: DIRECTIONS & Google Maps Embed (Réplica Exacta) -->
<section class="w-full bg-white border-t border-b border-slate-200 select-none overflow-hidden">
  <div class="w-full grid grid-cols-1 lg:grid-cols-2 items-stretch">
    
    <!-- Left Column: Directions Text Box -->
    <div class="w-full bg-white p-8 sm:p-12 md:p-16 lg:p-20 flex flex-col items-center justify-center text-center my-auto">
      <div class="max-w-md mx-auto space-y-4 flex flex-col items-center">
        
        <!-- Large Pin Icon -->
        <div class="p-3 bg-blue-50 text-[#2B447A] rounded-2xl mb-1 shadow-xs">
          <MapPin class="w-10 h-10 sm:w-12 sm:h-12 stroke-[2.2]" />
        </div>

        <!-- Title -->
        <h2 class="font-heading font-black text-3xl sm:text-4xl text-[#2B447A] tracking-tight uppercase leading-none">
          DIRECTIONS
        </h2>

        <!-- Address & How to Get Here Text -->
        <p class="font-sans text-sm sm:text-base text-slate-600 leading-relaxed font-normal pt-2">
          How to get to Robbie's of Islamorada: We are located at <strong class="font-bold text-slate-800">Mile Marker 77.5 Bayside</strong>. Address: <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-[#2B447A] hover:underline">77522 Overseas Hwy, Islamorada, FL 33036</a>.
        </p>

      </div>
    </div>

    <!-- Right Column: Interactive Google Maps Iframe -->
    <div class="relative w-full h-[360px] xs:h-[420px] sm:h-[480px] lg:h-auto min-h-[360px] lg:min-h-[500px] bg-slate-100 overflow-hidden border-t lg:border-t-0 lg:border-l border-slate-200">
      <iframe 
        src={embedMapUrl} 
        width="100%" 
        height="100%" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade"
        title="Robbie's of Islamorada Google Map Location"
        class="w-full h-full object-cover block border-0"
      ></iframe>
    </div>

  </div>
</section>
