---
const cards = [
  {
    id: "livecam",
    title: "ISLAMORADA LIVECAM",
    image: "/assets/home/imgi_16_islamorada.webp",
    url: "https://www.robbies.com/webcam.htm",
    baseText: "Not only do we bring you all the action on your docks, we are also now bringing you what’s going on under the docks. See for yourself! Now on livecam from Islamorada!",
    extraText: "",
    hasToggle: false
  },
  {
    id: "restaurant",
    title: "HUNGRY TARPON RESTAURANT",
    image: "/assets/home/imgi_17_Hungry-tarpon1.webp",
    url: "https://www.robbies.com/hungry-tarpon-restaurant.htm",
    baseText: "Experience a local’s dining experience on the water at any time of the day. We are open at 6:30AM for the early birds & sunrise chasers, & close down around 9PM. Don’t miss out",
    extraText: " on seeing the stars from the Hungry Tarpon deck if dining at night!",
    hasToggle: true
  },
  {
    id: "tarpon",
    title: "FEED THE TARPON",
    image: "/assets/home/imgi_18_feed-tarpon.webp",
    url: "https://www.robbies.com/tarpon-feeding.htm",
    baseText: "Maybe the “Silver Kings” just come here to see the humans, but toss a bait fish among them and the water churns as these monsters and the resident pelicans vie for the snack, causing quite a spectacle. Admission: $2.50 per person.",
    extraText: "Each bucket of fish is $5.00",
    hasToggle: true
  },
  {
    id: "shop",
    title: "ROBBIE’S SHOP ONLINE",
    image: "/assets/home/imgi_19_shop.webp",
    url: "https://shop.robbies.com/",
    baseText: "Explore the charm of the Florida Keys with Robbie’s of Islamorada’s online clothing collection. Browse our Shop Online section for a unique range of beachwear that captures the essence of island living.",
    extraText: " From vibrant, comfortable designs to casual, chic apparel, find your perfect Keys-inspired outfit with ease and convenience. Shop now and bring a piece of Islamorada’s charm into your wardrobe!",
    hasToggle: true
  }
];
---

<section class="w-full bg-[#F8FAFC] py-14 sm:py-16 md:py-20 px-4 sm:px-6 lg:px-8 border-b border-slate-200 overflow-hidden">
  <div class="max-w-[1180px] mx-auto">
    
    <!-- Mobile Swipeable Carousel & Desktop 4-Column Grid Container -->
    <div class="flex overflow-x-auto snap-x snap-mandatory lg:grid lg:grid-cols-4 gap-5 sm:gap-6 lg:gap-6 items-stretch pb-6 lg:pb-0 scrollbar-none">
      {cards.map((card) => (
        <div class="snap-center flex-shrink-0 w-[85vw] xs:w-[70vw] sm:w-[45vw] lg:w-auto bg-white rounded-3xl shadow-lg hover:shadow-xl transition-all duration-300 flex flex-col justify-between overflow-hidden border border-slate-200/80 h-full">
          
          <!-- Card Content Top Section -->
          <div>
            <!-- Card Image -->
            <div class="relative w-full aspect-[4/3] overflow-hidden bg-slate-100">
              <img 
                src={card.image} 
                alt={card.title} 
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
              />
            </div>

            <!-- Card Body Text Container -->
            <div class="p-5 sm:p-6">
              <!-- Title (Centrado) -->
              <h3 class="font-heading font-black text-sm sm:text-base text-[#2B447A] uppercase tracking-wide mb-3 text-center">
                {card.title}
              </h3>

              <!-- Description Text (Alineado a la Derecha sin Huecos Vacíos) -->
              <div class="font-body text-slate-600 text-xs sm:text-[13px] leading-relaxed text-right">
                {card.hasToggle ? (
                  <p class="inline-card-wrapper" id={`card-wrapper-${card.id}`}>
                    <span class="base-text">{card.baseText}</span>
                    <span class="extra-text hidden">{card.extraText}</span>
                    <button 
                      type="button" 
                      class="card-toggle-btn text-[#2B447A] font-bold underline hover:opacity-80 transition-opacity ml-1 cursor-pointer inline-whitespace-nowrap"
                    >
                      <span class="btn-text">Read More &gt;&gt;</span>
                    </button>
                  </p>
                ) : (
                  <p>{card.baseText}</p>
                )}
              </div>
            </div>
          </div>

          <!-- Bottom CTA Button Bar (Centrado 100%) -->
          <div class="mt-4">
            <a 
              href={card.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full bg-[#2B447A] hover:bg-[#1F3664] text-white font-heading font-bold text-xs sm:text-sm py-3 px-6 text-center block transition-colors duration-200 uppercase tracking-wider"
            >
              Learn More
            </a>
          </div>

        </div>
      ))}
    </div>

    <!-- Mobile Swipe Indicator Hint -->
    <div class="flex lg:hidden justify-center items-center gap-1.5 mt-4 text-xs font-semibold text-slate-400">
      <span>Desliza para ver más actividades</span>
      <span class="animate-bounce">→</span>
    </div>

  </div>
</section>

<!-- Hide Scrollbar Helper Styles -->
<style>
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<!-- Inline Script for Card Read More Inline Toggle (Zero Gap) -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', initCardInlineToggles);
  document.addEventListener('astro:page-load', initCardInlineToggles);

  function initCardInlineToggles() {
    document.querySelectorAll('.inline-card-wrapper').forEach((wrapper) => {
      const btn = wrapper.querySelector('.card-toggle-btn');
      const extraText = wrapper.querySelector('.extra-text');
      const btnText = wrapper.querySelector('.btn-text');

      if (btn && extraText && btnText) {
        let isExpanded = false;

        btn.onclick = (e) => {
          e.preventDefault();
          isExpanded = !isExpanded;

          if (isExpanded) {
            extraText.classList.remove('hidden');
            btnText.innerHTML = 'Read Less';
          } else {
            extraText.classList.add('hidden');
            btnText.innerHTML = 'Read More &gt;&gt;';
          }
        };
      }
    });
  }

  initCardInlineToggles();
</script>
