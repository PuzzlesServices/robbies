---
import { ChevronDown } from '@lucide/astro';

const cards = [
  {
    id: "livecam",
    title: "ISLAMORADA LIVECAM",
    image: "/assets/home/imgi_16_islamorada.webp",
    url: "https://www.robbies.com/webcam.htm",
    shortText: "Not only do we bring you all the action on your docks, we are also now bringing you what's going on under the docks. See for yourself! Now on livecam from Islamorada!",
    fullText: "Not only do we bring you all the action on your docks, we are also now bringing you what's going on under the docks. See for yourself! Now on livecam from Islamorada!",
    hasToggle: false
  },
  {
    id: "restaurant",
    title: "HUNGRY TARPON RESTAURANT",
    image: "/assets/home/imgi_17_Hungry-tarpon1.webp",
    url: "https://www.robbies.com/hungry-tarpon-restaurant.htm",
    shortText: "Experience a local's dining experience on the water at any time of the day. We are open at 6:30AM for the early birds & sunrise chasers, & close down around 9PM. Don",
    fullText: "Experience a local's dining experience on the water at any time of the day. We are open at 6:30AM for the early birds & sunrise chasers, & close down around 9PM. Don't miss out on seeing the stars from the Hungry Tarpon deck if dining at night!",
    hasToggle: true
  },
  {
    id: "tarpon",
    title: "FEED THE TARPON",
    image: "/assets/home/imgi_18_feed-tarpon.webp",
    url: "https://www.robbies.com/tarpon-feeding.htm",
    shortText: "Maybe the \"Silver Kings\" just come here to see the humans, but toss a bait fish among them and the water churns as these monsters and the resident pelicans vie for the snack, caus",
    fullText: "Maybe the \"Silver Kings\" just come here to see the humans, but toss a bait fish among them and the water churns as these monsters and the resident pelicans vie for the snack, causing quite a spectacle. Admission: $2.50 per person. Each bucket of fish is $5.00",
    hasToggle: true
  },
  {
    id: "shop",
    title: "ROBBIE'S SHOP ONLINE",
    image: "/assets/home/imgi_19_shop.webp",
    url: "https://shop.robbies.com/",
    shortText: "Explore the charm of the Florida Keys with Robbie's of Islamorada's online clothing collection. Browse our Shop Online section for a unique range of beachwear that captures the esse",
    fullText: "Explore the charm of the Florida Keys with Robbie's of Islamorada's online clothing collection. Browse our Shop Online section for a unique range of beachwear that captures the essence of island living. From vibrant, comfortable designs to casual, chic apparel, find your perfect Keys-inspired outfit with ease and convenience. Shop now and bring a piece of Islamorada's charm into your wardrobe!",
    hasToggle: true
  }
];
---

<section class="w-full bg-[#F8FAFC] py-14 sm:py-16 md:py-20 px-4 sm:px-6 lg:px-8 border-b border-slate-200 overflow-hidden">
  <div class="max-w-[1180px] mx-auto">
    
    <!-- Mobile Swipeable Carousel & Desktop 4-Column Grid Container -->
    <div class="flex overflow-x-auto snap-x snap-mandatory lg:grid lg:grid-cols-4 gap-5 sm:gap-6 lg:gap-6 items-stretch pb-6 lg:pb-0 scrollbar-none">
      {cards.map((card) => (
        <div class="snap-center flex-shrink-0 w-[85vw] xs:w-[70vw] sm:w-[45vw] lg:w-auto bg-white rounded-3xl shadow-lg hover:shadow-xl transition-all duration-300 flex flex-col justify-between overflow-hidden border border-slate-200/80 h-full">
          
          <!-- Card Content Top Section -->
          <div>
            <!-- Card Image -->
            <div class="relative w-full aspect-[4/3] overflow-hidden bg-slate-100">
              <img 
                src={card.image} 
                alt={card.title} 
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
              />
            </div>

            <!-- Card Body Text Container -->
            <div class="p-5 sm:p-6 text-center">
              <!-- Title -->
              <h3 class="font-heading font-black text-sm sm:text-base text-[#2B447A] uppercase tracking-wide mb-3 min-h-[40px] flex items-center justify-center">
                {card.title}
              </h3>

              <!-- Description Text with Smooth Read More / Read Less Toggle -->
              <div class="font-body text-slate-600 text-xs sm:text-[13px] leading-relaxed">
                {card.hasToggle ? (
                  <div class="card-toggle-wrapper" id={`card-wrapper-${card.id}`}>
                    
                    <!-- Short Base Text -->
                    <p class="inline">
                      {card.shortText}
                    </p>

                    <!-- Expandable Text Content (Smooth CSS Grid Rows Animation) -->
                    <div 
                      class="card-expand-content grid grid-rows-[0fr] opacity-0 transition-all duration-500 ease-in-out overflow-hidden"
                    >
                      <div class="overflow-hidden pt-1">
                        <span>{card.fullText.replace(card.shortText, '')}</span>
                      </div>
                    </div>

                    <!-- Styled Toggle Button with Chevron Icon -->
                    <div class="pt-2 text-center">
                      <button 
                        type="button"
                        class="card-toggle-btn inline-flex items-center gap-1 text-[#2B447A] font-extrabold text-xs hover:opacity-80 transition-opacity cursor-pointer px-2 py-0.5 rounded-full hover:bg-blue-50"
                        data-[#2B447A]
                      >
                        <span class="btn-label">Read More</span>
                        <ChevronDown class="btn-icon w-3.5 h-3.5 transition-transform duration-300 stroke-[2.5]" />
                      </button>
                    </div>

                  </div>
                ) : (
                  <p>{card.fullText}</p>
                )}
              </div>
            </div>
          </div>

          <!-- Bottom CTA Button Bar (Centrado 100%) -->
          <div class="mt-4">
            <a 
              href={card.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full bg-[#2B447A] hover:bg-[#1F3664] text-white font-heading font-bold text-xs sm:text-sm py-3 px-6 text-center block transition-colors duration-200 uppercase tracking-wider"
            >
              Learn More
            </a>
          </div>

        </div>
      ))}
    </div>

    <!-- Mobile Swipe Indicator Hint -->
    <div class="flex lg:hidden justify-center items-center gap-1.5 mt-4 text-xs font-semibold text-slate-400">
      <span>Desliza para ver más actividades</span>
      <span class="animate-bounce">→</span>
    </div>

  </div>
</section>

<!-- Hide Scrollbar Helper Styles -->
<style>
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<!-- Inline Script for Card Read More Toggle with Smooth Expansion -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', initCardToggles);
  document.addEventListener('astro:page-load', initCardToggles);

  function initCardToggles() {
    document.querySelectorAll('.card-toggle-wrapper').forEach((wrapper) => {
      const btn = wrapper.querySelector('.card-toggle-btn');
      const content = wrapper.querySelector('.card-expand-content');
      const label = wrapper.querySelector('.btn-label');
      const icon = wrapper.querySelector('.btn-icon');

      if (btn && content && label && icon) {
        let isExpanded = false;

        btn.onclick = (e) => {
          e.preventDefault();
          isExpanded = !isExpanded;

          if (isExpanded) {
            content.classList.remove('grid-rows-[0fr]', 'opacity-0');
            content.classList.add('grid-rows-[1fr]', 'opacity-100');
            label.textContent = 'Read Less';
            icon.style.transform = 'rotate(180deg)';
          } else {
            content.classList.remove('grid-rows-[1fr]', 'opacity-100');
            content.classList.add('grid-rows-[0fr]', 'opacity-0');
            label.textContent = 'Read More';
            icon.style.transform = 'rotate(0deg)';
          }
        };
      }
    });
  }

  initCardToggles();
</script>
