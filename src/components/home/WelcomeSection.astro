---
import { ChevronDown, ChevronUp } from '@lucide/astro';
---

<section class="w-full bg-[#F3F4F6] text-slate-800 py-14 sm:py-16 md:py-20 px-6 sm:px-10 border-b border-slate-200">
  <div class="max-w-[1180px] mx-auto text-center flex flex-col items-center justify-center">
    
    <!-- Main Title -->
    <h2 class="font-heading font-black text-xl sm:text-2xl md:text-3xl lg:text-[32px] text-[#2B447A] tracking-tight mb-4 sm:mb-5 leading-snug">
      Welcome to Robbie’s Marina of Islamorada
    </h2>

    <!-- Body Paragraph Container with Smooth Animated Toggle -->
    <div id="welcome-text-wrapper" class="font-body text-slate-700 text-xs sm:text-sm md:text-base leading-relaxed max-w-3xl mb-8">
      
      <!-- Always Visible Initial Paragraph -->
      <p class="mb-2">
        Home of the world-famous tarpon feeding! Here, you can discover the exciting things to do in the Florida Keys during your stop at Robbie’s.
      </p>

      <!-- Smooth Collapsible Content Container -->
      <div 
        id="welcome-collapsible-content" 
        class="grid grid-rows-[0fr] opacity-0 transition-all duration-500 ease-in-out overflow-hidden"
      >
        <div class="overflow-hidden space-y-4 pt-2 text-left sm:text-center">
          <p>
            Whether you want to hand-feed massive tarpon, seek some thrills with our water sports, or stock up on handcrafted souvenirs at our fun, local shops, we’ve got something for everyone at Robbie’s. Gorge on fresh, delicious seafood and sip one of our signature cocktails, local draft beer, or our famous loaded Trailer Trash Bloody Mary on the waterfront deck and enjoy the show of the tarpon feeding frenzy!
          </p>
          <p>
            As a must-visit destination in the Florida Keys, our site shares what to do and where to eat at Robbie’s Marina of Islamorada to help you plan your stop and create memorable moments with your family and friends. Remember, it’s not a trip to the Keys without a visit to Robbie’s!
          </p>
        </div>
      </div>

      <!-- Styled Read More / Read Less Toggle Button with Chevron Icon -->
      <div class="pt-3">
        <button 
          type="button" 
          id="welcome-toggle-btn"
          class="inline-flex items-center gap-1.5 text-[#2B447A] font-extrabold text-xs sm:text-sm hover:opacity-80 transition-all duration-200 cursor-pointer py-1 px-3 rounded-full hover:bg-blue-50/80 border border-blue-900/15"
          aria-expanded="false"
        >
          <span id="welcome-toggle-label">Read More</span>
          <ChevronDown id="welcome-toggle-icon" class="w-4 h-4 transition-transform duration-300 stroke-[2.5]" />
        </button>
      </div>

    </div>

    <!-- Pill CTA Button ("View Our Live Webcam") -->
    <div>
      <a 
        href="https://www.robbies.com/webcam.htm" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center justify-center bg-[#2B447A] hover:bg-[#1F3664] text-white font-heading font-bold text-xs sm:text-sm md:text-base px-8 sm:px-10 py-3 sm:py-3.5 rounded-full shadow-md hover:shadow-lg transition-all duration-200 hover:scale-[1.02] active:scale-95 border border-transparent"
      >
        View Our Live Webcam
      </a>
    </div>

  </div>
</section>

<!-- Inline Script for Smooth Accordion Transition -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', initWelcomeAccordion);
  document.addEventListener('astro:page-load', initWelcomeAccordion);

  function initWelcomeAccordion() {
    const toggleBtn = document.getElementById('welcome-toggle-btn');
    const content = document.getElementById('welcome-collapsible-content');
    const label = document.getElementById('welcome-toggle-label');
    const icon = document.getElementById('welcome-toggle-icon');

    if (toggleBtn && content && label && icon) {
      let isExpanded = false;

      toggleBtn.onclick = (e) => {
        e.preventDefault();
        isExpanded = !isExpanded;

        if (isExpanded) {
          content.classList.remove('grid-rows-[0fr]', 'opacity-0');
          content.classList.add('grid-rows-[1fr]', 'opacity-100');
          label.textContent = 'Read Less';
          icon.style.transform = 'rotate(180deg)';
          toggleBtn.setAttribute('aria-expanded', 'true');
        } else {
          content.classList.remove('grid-rows-[1fr]', 'opacity-100');
          content.classList.add('grid-rows-[0fr]', 'opacity-0');
          label.textContent = 'Read More';
          icon.style.transform = 'rotate(0deg)';
          toggleBtn.setAttribute('aria-expanded', 'false');
        }
      };
    }
  }

  initWelcomeAccordion();
</script>
