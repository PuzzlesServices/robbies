---
interface Props {
  videoSrc?: string;
  crownSrc?: string;
  badgeSrc?: string;
  line1?: string;
  line2?: string;
  subtitle?: string;
  buttonText?: string;
  buttonUrl?: string;
}

const {
  videoSrc = "/assets/home/ROBBIES_BANNER-VIDEO-RESUME-V5.mp4",
  crownSrc = "/assets/home/imgi_7_CROWN-2.png",
  badgeSrc = "/assets/home/imgi_6_Badge_Page.png",
  line1 = "VOTED THE #1 PLACE",
  line2 = "IN THE FLORIDA KEYS",
  subtitle = "THAT EVERY TOURIST SHOULD VISIT",
  buttonText = "Learn More",
  buttonUrl = "https://www.robbies.com/"
} = Astro.props;
---

<section class="relative w-full min-h-[480px] h-[72vh] md:h-[78vh] lg:h-[84vh] max-h-[800px] overflow-hidden bg-slate-950 flex items-center">
  <!-- Background Video (Original) -->
  <video 
    autoplay 
    loop 
    muted 
    playsinline 
    poster="/assets/home/imgi_18_feed-tarpon.webp"
    class="absolute inset-0 w-full h-full object-cover z-0"
  >
    <source src={videoSrc} type="video/mp4" />
    Your browser does not support the video tag.
  </video>

  <!-- Hero Content Container (Max-width 1180px) -->
  <div class="relative z-20 max-w-[1180px] w-full mx-auto px-5 sm:px-8 md:px-12 lg:px-12 flex items-center justify-between h-full py-8">
    
    <!-- Left Column: Crown, 2-line Title, Subtitle, Elongated CTA Button -->
    <div class="max-w-xl lg:max-w-2xl text-white my-auto">
      
      <!-- Crown Icon -->
      {crownSrc && (
        <div class="mb-2 sm:mb-3">
          <img 
            src={crownSrc} 
            alt="Crown Icon" 
            class="h-7 sm:h-9 md:h-10 w-auto object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)]"
          />
        </div>
      )}

      <!-- Main 2-Line Heading -->
      <h1 class="font-heading font-black text-xl xs:text-2xl sm:text-3xl md:text-[38px] lg:text-[44px] xl:text-[48px] text-white tracking-tight uppercase leading-[1.15] mb-2 sm:mb-3 drop-shadow-[0_3px_10px_rgba(0,0,0,0.8)]">
        <span>{line1}</span><br />
        <span>{line2}</span>
      </h1>

      <!-- Prominent Subtitle (font-normal / weight 400) -->
      <p class="font-heading font-normal text-sm xs:text-base sm:text-lg md:text-[21px] lg:text-[24px] text-white/95 tracking-wider uppercase mb-6 sm:mb-8 drop-shadow-[0_2px_6px_rgba(0,0,0,0.8)] leading-snug">
        {subtitle}
      </p>

      <!-- Elongated Premium CTA Button -->
      <div>
        <a 
          href={buttonUrl} 
          class="inline-flex items-center justify-center bg-[#2B447A] hover:bg-[#1F3664] text-white font-heading font-extrabold text-xs sm:text-sm uppercase tracking-widest px-10 sm:px-12 py-3 sm:py-3.5 rounded-full shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-[1.03] active:scale-95 border border-white/20"
        >
          {buttonText}
        </a>
      </div>

    </div>

    <!-- Right Column: 50th Anniversary Badge (Elevado 40px hacia arriba) -->
    {badgeSrc && (
      <div class="absolute top-1/2 -translate-y-1/2 -mt-10 right-4 sm:right-8 md:right-12 lg:right-12 z-20 pointer-events-none">
        <img 
          src={badgeSrc} 
          alt="50 Years of Adventure Badge" 
          class="w-20 xs:w-24 sm:w-32 md:w-40 lg:w-48 xl:w-52 h-auto object-contain drop-shadow-[0_4px_16px_rgba(0,0,0,0.6)]"
        />
      </div>
    )}

  </div>
</section>
