---
const logos = [
  {
    name: "National Geographic",
    src: "/assets/home/imgi_11_NATIONAL-GEOGRAPHIC_1.png",
    url: "https://www.nationalgeographic.com/travel/article/island-escapes"
  },
  {
    name: "Hilton Grand Vacations",
    src: "/assets/home/imgi_12_HILTON-GRAND-VACATIONS_1.png",
    url: "https://www.hiltongrandvacations.com/en/plan-your-vacation/where-to/where-to-go/10-winter-vacation-gems-use-your-hilton-honors-points-and-beat-the-winter-blues"
  },
  {
    name: "Vogue",
    src: "/assets/home/imgi_13_VOGUE_1.png",
    url: "https://www.vogue.com/article/best-winter-vacation-escapes-2016"
  },
  {
    name: "The New York Times",
    src: "/assets/home/imgi_14_THE-NEW-YORK-TIMES_1.png",
    url: "https://archive.nytimes.com/tmagazine.blogs.nytimes.com/2011/11/16/the-place-florida-part-four/"
  },
  {
    name: "CNN / Wanderlog",
    src: "/assets/home/imgi_15_CNN_1.png",
    url: "https://wanderlog.com/list/geoCategory/320998/best-spots-for-lunch-in-florida-keys"
  }
];
---

<!-- Section: FEATURED IN Press Bar (Ampliado y con Enlaces Oficiales) -->
<section class="w-full bg-[#2B447A] text-white py-8 sm:py-10 md:py-12 px-4 sm:px-6 lg:px-8 border-t border-b border-blue-900/40 select-none">
  <div class="max-w-[1180px] mx-auto flex flex-col items-center justify-center space-y-6">
    
    <!-- Section Title Label -->
    <span class="text-xs sm:text-sm font-heading font-extrabold tracking-widest text-white/90 uppercase">
      FEATURED IN:
    </span>

    <!-- Press Logos Grid / Flex Container (Imágenes más grandes) -->
    <div class="w-full flex flex-wrap items-center justify-center gap-8 sm:gap-12 md:gap-16 lg:gap-20 xl:gap-24">
      {logos.map((logo) => (
        <div class="flex items-center justify-center p-2 hover:scale-105 transition-transform duration-200">
          <a href={logo.url} target="_blank" rel="noopener noreferrer" title={logo.name} class="block">
            <img 
              src={logo.src} 
              alt={logo.name} 
              class="h-10 xs:h-12 sm:h-16 md:h-20 lg:h-24 xl:h-28 w-auto max-w-[200px] sm:max-w-[260px] object-contain brightness-0 invert opacity-95 hover:opacity-100 transition-opacity drop-shadow-sm"
              loading="lazy"
            />
          </a>
        </div>
      ))}
    </div>

  </div>
</section>
