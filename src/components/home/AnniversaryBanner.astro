---
interface Props {
  bgImage?: string;
  badgeImage?: string;
  topTitle?: string;
  subtitle?: string;
  mainHeading?: string;
  url?: string;
}

const {
  bgImage = "/assets/home/imgi_194_fb89dc4f136928a42a32991b5ec49634.Banner_50th.png",
  badgeImage = "/assets/home/imgi_6_Badge_Page.png",
  topTitle = "Celebrating 50 Years of Adventure",
  subtitle = "We're officially hitting the big 5-0. From a small bait shop to an Islamorada icon,",
  mainHeading = "THANK YOU FOR BEING PART OF OUR STORY SINCE 1976.",
  url = "https://www.robbies.com/"
} = Astro.props;
---

<section class="w-full bg-white py-8 sm:py-12 px-4 sm:px-6 lg:px-8 select-none">
  <div class="max-w-[1180px] mx-auto">
    
    <!-- 50th Anniversary Banner Container (Imagen 100% Original sin Capas Oscuras) -->
    <div class="relative w-full rounded-2xl sm:rounded-3xl lg:rounded-[32px] overflow-hidden shadow-xl sm:shadow-2xl border border-slate-200/80 group min-h-[300px] sm:min-h-[380px] md:min-h-[440px] flex items-center justify-center">
      
      <!-- Background Image (Original 100% Real sin Filtros ni Gradientes Oscuros) -->
      <img 
        src={bgImage} 
        alt="Robbie's 50th Anniversary Background" 
        class="absolute inset-0 w-full h-full object-cover z-0 transition-transform duration-700 group-hover:scale-[1.02]"
        loading="lazy"
      />

      <!-- Banner Foreground Content (Sin capas ni gradientes de oscurecimiento) -->
      <div class="relative z-20 w-full h-full px-4 sm:px-6 py-6 sm:py-10 flex flex-col items-center justify-between text-center text-white my-auto">
        
        <!-- Top Title -->
        <h3 class="font-heading font-extrabold text-sm xs:text-base sm:text-2xl md:text-3xl text-white tracking-wide drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)] mb-1 sm:mb-2">
          {topTitle}
        </h3>

        <!-- Center 50th Badge Image -->
        <div class="my-2 sm:my-4 transform transition-transform duration-300 hover:scale-105">
          <img 
            src={badgeImage} 
            alt="50 Years of Adventure Badge" 
            class="h-24 xs:h-28 sm:h-36 md:h-44 lg:h-48 w-auto object-contain drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)] mx-auto"
          />
        </div>

        <!-- Bottom Text Group -->
        <div class="max-w-3xl mx-auto space-y-1 sm:space-y-1.5">
          <p class="font-body text-xs sm:text-sm md:text-base text-white font-medium leading-snug drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]">
            {subtitle}
          </p>
          <h4 class="font-heading font-black text-xs sm:text-base md:text-lg lg:text-xl text-white tracking-wider uppercase drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
            {mainHeading}
          </h4>
        </div>

      </div>

    </div>

  </div>
</section>
