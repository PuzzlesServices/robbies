---

<!-- Section: THE BEST THINGS TO DO in Islamorada (8-Card Grid with Centered Learn More Buttons) -->
<section class="w-full bg-white py-16 sm:py-20 px-4 sm:px-6 lg:px-8 border-b border-slate-100 select-none overflow-hidden">
  <div class="max-w-[1180px] mx-auto space-y-10">
    
    <!-- Top Header: 5 Stars & Title -->
    <div class="text-center space-y-2">
      <!-- 5 Navy Stars -->
      <div class="flex items-center justify-center space-x-1 text-[#2B447A] mb-2">
        <Star class="w-6 h-6 fill-current stroke-none" />
        <Star class="w-6 h-6 fill-current stroke-none" />
        <Star class="w-6 h-6 fill-current stroke-none" />
        <Star class="w-6 h-6 fill-current stroke-none" />
        <Star class="w-6 h-6 fill-current stroke-none" />
      </div>

      <!-- Main Title -->
      <h2 class="font-heading font-black text-2xl sm:text-3xl md:text-[34px] text-[#2B447A] tracking-tight uppercase leading-snug">
        THE BEST THINGS TO DO
      </h2>
      <p class="font-sans text-sm text-slate-500 font-medium">
        in Islamorada
      </p>
    </div>

    <!-- 8 Cards Grid (4 Columns Desktop, 2 Columns Tablet, 1 Column Mobile) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-start">
      {items.map((card) => (
        <div class="w-full flex flex-col justify-between bg-white rounded-3xl border border-slate-200/80 shadow-md hover:shadow-lg transition-all duration-300 overflow-hidden self-stretch">
          
          <!-- Card Image Top -->
          <div class="relative w-full h-56 sm:h-64 overflow-hidden bg-slate-100">
            <img 
              src={card.image} 
              alt={card.title} 
              class="w-full h-full object-cover block transition-transform duration-500 hover:scale-105"
              loading="lazy"
            />
          </div>

          <!-- Card Content Box -->
          <div class="p-5 flex-1 flex flex-col justify-start text-left font-sans">
            <!-- Title -->
            <h3 class="font-heading font-extrabold text-slate-900 text-sm sm:text-base tracking-tight uppercase mb-3 leading-snug text-center">
              {card.title}
            </h3>

            <!-- List Content for Open Air Market -->
            {card.isList ? (
              <div class="grid grid-cols-2 gap-x-2 text-[11px] sm:text-xs text-slate-600 space-y-1 my-auto">
                <ul class="space-y-1">
                  {card.listItemsLeft?.map((li) => (
                    <li class="flex items-start">
                      <span class="mr-1 text-slate-400">•</span>
                      <span>{li}</span>
                    </li>
                  ))}
                </ul>
                <ul class="space-y-1">
                  {card.listItemsRight?.map((li) => (
                    <li class="flex items-start">
                      <span class="mr-1 text-slate-400">•</span>
                      <span>{li}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              /* Inline Read More / Read Less Toggle Text */
              <div class="text-xs sm:text-[13px] text-slate-600 leading-relaxed font-sans text-left">
                <span class="short-text-inline inline">
                  {card.shortText}
                </span>
                <span class="full-text-inline hidden">
                  {card.fullText}
                </span>
                
                <!-- Toggle Link -->
                <button 
                  type="button" 
                  class="read-toggle-btn text-[#2B447A] font-bold underline hover:text-[#1F3664] ml-1 cursor-pointer focus:outline-none inline"
                  aria-expanded="false"
                >
                  <span class="read-more-lbl inline">Read More &gt;&gt;</span>
                  <span class="read-less-lbl hidden">Read Less</span>
                </button>
              </div>
            )}
          </div>

          <!-- Bottom Blue Bar (Learn More Centrado) -->
          <a 
            href={card.url} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full bg-[#2B447A] hover:bg-[#1F3664] text-white py-3.5 px-6 flex items-center justify-center text-center font-heading font-extrabold text-xs uppercase tracking-wider transition-colors mt-auto"
          >
            Learn More
          </a>

        </div>
      ))}
    </div>

  </div>
</section>

<!-- Inline Script for Read More / Read Less Toggle Logic -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', initReadMoreToggles);
  document.addEventListener('astro:page-load', initReadMoreToggles);

  function initReadMoreToggles() {
    document.querySelectorAll('.read-toggle-btn').forEach((btn) => {
      btn.onclick = (e) => {
        e.preventDefault();
        const container = btn.parentElement;
        if (!container) return;

        const shortText = container.querySelector('.short-text-inline');
        const fullText = container.querySelector('.full-text-inline');
        const readMoreLbl = btn.querySelector('.read-more-lbl');
        const readLessLbl = btn.querySelector('.read-less-lbl');

        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          // Collapse to short text
          btn.setAttribute('aria-expanded', 'false');
          shortText?.classList.remove('hidden');
          shortText?.classList.add('inline');
          fullText?.classList.remove('inline');
          fullText?.classList.add('hidden');
          readMoreLbl?.classList.remove('hidden');
          readMoreLbl?.classList.add('inline');
          readLessLbl?.classList.remove('inline');
          readLessLbl?.classList.add('hidden');
        } else {
          // Expand to full text
          btn.setAttribute('aria-expanded', 'true');
          shortText?.classList.remove('inline');
          shortText?.classList.add('hidden');
          fullText?.classList.remove('hidden');
          fullText?.classList.add('inline');
          readMoreLbl?.classList.remove('inline');
          readMoreLbl?.classList.add('hidden');
          readLessLbl?.classList.remove('inline');
          readLessLbl?.classList.add('inline');
        }
      };
    });
  }

  initReadMoreToggles();
</script>
