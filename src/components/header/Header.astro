---
import TopBanner from './TopBanner.astro';
import { ShoppingBag, Search, Phone, Menu, X, ChevronDown } from '@lucide/astro';

const navItems = [
  { name: 'ACTIVITIES', id: 'activities', hasMega: true, url: 'https://www.robbies.com/' },
  { name: 'FISHING', id: 'fishing', hasMega: true, url: 'https://www.robbies.com/islamorada-fishing.htm' },
  { name: 'RESTAURANT', id: 'restaurant', hasMega: false, url: 'https://www.robbies.com/hungry-tarpon-restaurant.htm' },
  { name: 'SHOP', id: 'shop', hasMega: true, url: 'https://shop.robbies.com/' },
  { name: 'OPEN-AIR SHOPPING', id: 'open-air', hasMega: false, url: 'https://www.robbies.com/' },
  { name: 'WEBCAM', id: 'webcam', hasMega: false, url: 'https://www.robbies.com/webcam.htm' },
  { name: 'CONTACT US', id: 'contact', hasMega: true, url: 'https://www.robbies.com/' },
  { name: "VISITOR'S CENTER", id: 'visitor', hasMega: false, url: 'https://www.robbies.com/' },
];

const activitiesMega = {
  title: "ACTIVITIES IN ISLAMORADA",
  col1: [
    { name: "ALL ACTIVITIES", url: "https://www.robbies.com/" },
    { name: "MORNING ACTIVITIES", url: "https://www.robbies.com/" },
    { name: "EVENING ACTIVITIES", url: "https://www.robbies.com/" },
    { name: "TARPON FEEDING", url: "https://www.robbies.com/tarpon-feeding.htm" },
    { name: "JET SKI ADVENTURES", url: "https://www.robbies.com/jet-ski.htm" },
    { name: "SNORKELING", url: "https://www.robbies.com/snorkeling-tours.htm" },
    { name: "SNUBA DIVE", url: "https://www.robbies.com/snuba.htm" },
  ],
  col2: [
    { name: "ISLAMORADA FISHING", url: "https://www.robbies.com/islamorada-fishing.htm" },
    { name: "SUNSET CRUISES", url: "https://www.robbies.com/sunset-cruises.htm" },
    { name: "KAYAK AND PADDLE BOARD RENTALS/TOURS", url: "https://www.robbies.com/kayak.htm" },
    { name: "BOAT RENTALS", url: "https://www.robbies.com/boat-rentals.htm" },
    { name: "ISLAMORADA ECO TOURS", url: "https://www.robbies.com/eco-tours.htm" },
    { name: "GLASS BOTTOM BOAT TOURS", url: "https://www.robbies.com/glass-bottom.htm" },
  ],
  image: "/assets/home/imgi_18_feed-tarpon.webp"
};

const fishingMega = {
  section1: {
    title: "ISLAMORADA FISHING",
    colA: [
      { name: "ALL FISHING", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "PARTYBOAT FISHING", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "ISLAMORADA NIGHT FISHING", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "SPLIT CHARTER FISHING", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "OFFSHORE FISHING", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "MAHI-MAHI FISHING", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "SWORDFISH FISHING", url: "https://www.robbies.com/islamorada-fishing.htm" },
    ],
    colB: [
      { name: "REEF & WRECK FISHING", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "TARPON & SHARK FISHING", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "BACKCOUNTRY FISHING", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "FAMILY FISHING", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "FLY FISHING", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "FISHING CALENDAR", url: "https://www.robbies.com/islamorada-fishing.htm" },
    ]
  },
  section2: {
    title: "OUR CAPTAINS",
    colA: [
      { name: "ALL CAPTAINS", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "BLUE HEAVEN CHARTERS", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "CONTAGIOUS CHARTERS", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "DIRTYBOAT CHARTERS", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "FIN TASTIC CHARTERS", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "FOUR ACES CHARTERS", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "MISS PENNY CHARTERS", url: "https://www.robbies.com/islamorada-fishing.htm" },
    ],
    colB: [
      { name: "GO TIME CHARTERS", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "KATSIKAS CHARTERS", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "I'M BIT CHARTERS", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "CAPT. RICHARD HASTINGS", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "SATISFACTION CHARTERS", url: "https://www.robbies.com/islamorada-fishing.htm" },
      { name: "CONCHED OUT CHARTERS", url: "https://www.robbies.com/islamorada-fishing.htm" },
    ]
  },
  image: "/assets/home/imgi_51_TARPON-SHARK-FISHING.webp"
};

const shopMega = {
  title: "SHOP",
  items: [
    { name: "MEN", url: "https://shop.robbies.com/collections/men" },
    { name: "WOMEN", url: "https://shop.robbies.com/collections/women" },
    { name: "KIDS", url: "https://shop.robbies.com/collections/kids" },
    { name: "TODDLERS", url: "https://shop.robbies.com/collections/toddlers" },
    { name: "HATS", url: "https://shop.robbies.com/collections/hats" },
    { name: "TIM RAHN", url: "https://shop.robbies.com/collections/tim-rahn" },
  ],
  image: "/assets/home/imgi_52_OFFSHORE-FISHING.webp"
};

const contactMega = {
  section1: {
    title: "CONTACT US",
    items: [
      { name: "CONTACT US", url: "https://www.robbies.com/" },
      { name: "DIRECTIONS", url: "https://www.robbies.com/" },
      { name: "CAREERS", url: "https://www.robbies.com/" },
      { name: "INFLUENCERS COLLABORATION", url: "https://www.robbies.com/" },
      { name: "ABOUT US", url: "https://www.robbies.com/" },
      { name: "LOCATION SHOOTS", url: "https://www.robbies.com/" },
      { name: "WEDDINGS AND EVENTS", url: "https://www.robbies.com/" },
    ]
  },
  section2: {
    title: "MORE FROM ROBBIE'S",
    items: [
      { name: "ROBBIE'S OF KEY WEST", url: "https://www.robbies.com/" },
      { name: "HUNGRY TARPON", url: "https://www.robbies.com/" },
      { name: "CAPTAIN MICHAEL", url: "https://www.robbies.com/" },
    ]
  },
  image: "/assets/home/imgi_9_Robbies-of-Islamorada.webp"
};
---

<!-- Header Contenedor Fijo / Sticky -->
<header id="main-header" class="w-full sticky top-0 z-50 shadow-md font-heading transition-all duration-300 select-none">
  <!-- Top Blue Banner Rotativo -->
  <TopBanner />

  <!-- Main Royal Navy Navbar (Color exacto Robbie's #2B447A) -->
  <nav class="bg-[#2B447A] text-white py-2.5 px-3 sm:px-6 lg:px-8 border-b border-blue-900/30 relative">
    <div class="max-w-[1440px] mx-auto flex items-center justify-between gap-2 lg:gap-4">
      
      <!-- MOBILE ORDER (1º MENÚ IZQUIERDA, 2º LOGO, 3º ICONOS DERECHA) -->
      <!-- 1º: Mobile Menu Toggle Button (Extremo Izquierdo en Móvil) -->
      <div class="flex xl:hidden items-center">
        <button 
          id="mobile-menu-toggle"
          aria-label="Toggle Navigation Menu"
          class="p-1.5 rounded-lg text-white hover:bg-white/10 transition-colors focus:outline-none"
        >
          <Menu id="menu-icon-open" class="w-7 h-7" />
          <X id="menu-icon-close" class="w-7 h-7 hidden" />
        </button>
      </div>

      <!-- 2º: Brand Logo (Centro/Izquierda) -->
      <a href="/" class="flex-shrink-0 flex items-center group transition-transform duration-200 hover:opacity-95 mx-auto xl:mx-0">
        <img 
          src="/assets/common/robbies_logo_mobile.webp" 
          alt="Robbie's of Islamorada" 
          class="h-9 sm:h-12 md:h-14 lg:h-16 w-auto object-contain drop-shadow-sm"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation Menu -->
      <div class="hidden xl:flex items-center justify-center flex-1 mx-2 lg:mx-4">
        <ul class="flex items-center flex-wrap justify-center text-[11px] lg:text-[12px] xl:text-[12.5px] font-normal tracking-wider text-white">
          {navItems.map((item, index) => (
            <li class="flex items-center group relative nav-mega-trigger" data-mega={item.id}>
              <a 
                href={item.url} 
                class="hover:opacity-100 opacity-90 transition-all duration-200 py-4 px-2 lg:px-2.5 uppercase whitespace-nowrap relative border-b-2 border-transparent group-hover:border-white group-hover:font-bold"
              >
                {item.name}
              </a>
              {index < navItems.length - 1 && (
                <span class="text-white/40 font-light px-1 select-none text-[10px]">|</span>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- 3º: Right Action Items (Shop Bag, Search, Phone) -->
      <!-- Desktop Actions -->
      <div class="hidden md:flex items-center space-x-3 lg:space-x-5 text-white flex-shrink-0">
        <a 
          href="https://shop.robbies.com/" 
          target="_blank"
          aria-label="Shop Robbie's Merch"
          class="hover:opacity-80 transition-opacity duration-200 p-1.5 rounded-full hover:bg-white/10"
          title="Shop Merch"
        >
          <ShoppingBag class="w-5 h-5 stroke-[2]" />
        </a>

        <button 
          id="search-trigger-btn"
          aria-label="Search Robbie's site"
          class="hover:opacity-80 transition-opacity duration-200 p-1.5 rounded-full hover:bg-white/10 focus:outline-none"
          title="Search"
        >
          <Search class="w-5 h-5 stroke-[2]" />
        </button>

        <a 
          href="tel:3056648070" 
          class="flex items-center space-x-2 text-white hover:opacity-85 transition-opacity duration-200 font-bold text-xs lg:text-sm tracking-wide ml-1"
        >
          <Phone class="w-4 h-4 fill-white stroke-none flex-shrink-0" />
          <span class="whitespace-nowrap">(305) 664-8070</span>
        </a>
      </div>

      <!-- Mobile Actions (Iconos de Compra y Llamada a la Derecha) -->
      <div class="flex md:hidden items-center space-x-2">
        <a 
          href="https://shop.robbies.com/" 
          target="_blank"
          aria-label="Shop Robbie's Merch"
          class="p-1.5 text-white hover:bg-white/10 rounded-full"
        >
          <ShoppingBag class="w-5 h-5 stroke-[2]" />
        </a>
        <a 
          href="tel:3056648070" 
          aria-label="Call Robbie's"
          class="p-1.5 text-white bg-white/10 rounded-full border border-white/20"
        >
          <Phone class="w-4 h-4 fill-white stroke-none" />
        </a>
      </div>

    </div>
  </nav>

  <!-- ==================== DESKTOP MEGA MENUS ==================== -->

  <!-- 1. ACTIVITIES MEGA MENU -->
  <div 
    id="mega-menu-activities" 
    class="mega-menu-panel hidden opacity-0 transition-all duration-300 ease-out absolute top-full left-0 w-full bg-[#2B447A] text-white shadow-2xl z-40 border-t border-white/20"
  >
    <div class="w-full grid grid-cols-12 h-[480px]">
      
      <!-- Left Navy Column: Content Area -->
      <div class="col-span-7 xl:col-span-8 h-full bg-[#2B447A] px-12 xl:px-16 py-12 flex flex-col justify-start">
        <h3 class="font-heading font-black text-sm text-white uppercase tracking-wider mb-8 text-left">
          {activitiesMega.title}
        </h3>
        
        <div class="grid grid-cols-2 gap-x-12 max-w-2xl">
          <ul class="space-y-4">
            {activitiesMega.col1.map((item) => (
              <li>
                <span class="font-heading font-bold text-xs text-white hover:opacity-75 transition-opacity uppercase tracking-wide block text-left cursor-pointer">
                  {item.name}
                </span>
              </li>
            ))}
          </ul>
          <ul class="space-y-4">
            {activitiesMega.col2.map((item) => (
              <li>
                <span class="font-heading font-bold text-xs text-white hover:opacity-75 transition-opacity uppercase tracking-wide block text-left cursor-pointer">
                  {item.name}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Right Column: Full-Height HD Image (Identical dimensions across all 4 menus) -->
      <div class="col-span-5 xl:col-span-4 h-full relative overflow-hidden bg-slate-900">
        <img 
          src={activitiesMega.image} 
          alt="Tarpon Feeding at Robbie's" 
          class="w-full h-full object-cover block"
          loading="lazy"
        />
      </div>

    </div>
  </div>

  <!-- 2. FISHING MEGA MENU -->
  <div 
    id="mega-menu-fishing" 
    class="mega-menu-panel hidden opacity-0 transition-all duration-300 ease-out absolute top-full left-0 w-full bg-[#2B447A] text-white shadow-2xl z-40 border-t border-white/20"
  >
    <div class="w-full grid grid-cols-12 h-[480px]">
      
      <!-- Left Navy Column: Content Area -->
      <div class="col-span-7 xl:col-span-8 h-full bg-[#2B447A] px-8 xl:px-12 py-12 flex flex-col justify-start">
        <div class="w-full flex items-stretch h-full">
          
          <!-- Section 1: ISLAMORADA FISHING -->
          <div class="w-1/2 pr-8 xl:pr-10 border-r border-white/30 flex flex-col justify-start">
            <h3 class="font-heading font-black text-sm text-white uppercase tracking-wider mb-8 text-left">
              {fishingMega.section1.title}
            </h3>
            <div class="grid grid-cols-2 gap-x-4">
              <ul class="space-y-4">
                {fishingMega.section1.colA.map((item) => (
                  <li>
                    <span class="font-heading font-bold text-xs text-white hover:opacity-75 transition-opacity uppercase tracking-wide block text-left cursor-pointer">
                      {item.name}
                    </span>
                  </li>
                ))}
              </ul>
              <ul class="space-y-4">
                {fishingMega.section1.colB.map((item) => (
                  <li>
                    <span class="font-heading font-bold text-xs text-white hover:opacity-75 transition-opacity uppercase tracking-wide block text-left cursor-pointer">
                      {item.name}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Section 2: OUR CAPTAINS -->
          <div class="w-1/2 pl-8 xl:pl-10 flex flex-col justify-start">
            <h3 class="font-heading font-black text-sm text-white uppercase tracking-wider mb-8 text-left">
              {fishingMega.section2.title}
            </h3>
            <div class="grid grid-cols-2 gap-x-4">
              <ul class="space-y-4">
                {fishingMega.section2.colA.map((item) => (
                  <li>
                    <span class="font-heading font-bold text-xs text-white hover:opacity-75 transition-opacity uppercase tracking-wide block text-left cursor-pointer">
                      {item.name}
                    </span>
                  </li>
                ))}
              </ul>
              <ul class="space-y-4">
                {fishingMega.section2.colB.map((item) => (
                  <li>
                    <span class="font-heading font-bold text-xs text-white hover:opacity-75 transition-opacity uppercase tracking-wide block text-left cursor-pointer">
                      {item.name}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Column: Full-Height HD Image -->
      <div class="col-span-5 xl:col-span-4 h-full relative overflow-hidden bg-slate-900">
        <img 
          src={fishingMega.image} 
          alt="Offshore Fishing at Robbie's" 
          class="w-full h-full object-cover block"
          loading="lazy"
        />
      </div>

    </div>
  </div>

  <!-- 3. SHOP MEGA MENU -->
  <div 
    id="mega-menu-shop" 
    class="mega-menu-panel hidden opacity-0 transition-all duration-300 ease-out absolute top-full left-0 w-full bg-[#2B447A] text-white shadow-2xl z-40 border-t border-white/20"
  >
    <div class="w-full grid grid-cols-12 h-[480px]">
      
      <!-- Left Navy Column: Content Area -->
      <div class="col-span-7 xl:col-span-8 h-full bg-[#2B447A] px-12 xl:px-16 py-12 flex flex-col justify-center items-center">
        <div class="w-full max-w-xs">
          <h3 class="font-heading font-black text-sm text-white uppercase tracking-wider mb-8 text-center">
            {shopMega.title}
          </h3>
          
          <ul class="space-y-4 text-center">
            {shopMega.items.map((item) => (
              <li>
                <span class="font-heading font-bold text-xs text-white hover:opacity-75 transition-opacity uppercase tracking-wide block text-center cursor-pointer">
                  {item.name}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Right Column: Full-Height HD Image -->
      <div class="col-span-5 xl:col-span-4 h-full relative overflow-hidden bg-slate-900">
        <img 
          src={shopMega.image} 
          alt="Shop Merch at Robbie's" 
          class="w-full h-full object-cover block"
          loading="lazy"
        />
      </div>

    </div>
  </div>

  <!-- 4. CONTACT MEGA MENU -->
  <div 
    id="mega-menu-contact" 
    class="mega-menu-panel hidden opacity-0 transition-all duration-300 ease-out absolute top-full left-0 w-full bg-[#2B447A] text-white shadow-2xl z-40 border-t border-white/20"
  >
    <div class="w-full grid grid-cols-12 h-[480px]">
      
      <!-- Left Navy Column: Content Area -->
      <div class="col-span-7 xl:col-span-8 h-full bg-[#2B447A] px-8 xl:px-12 py-12 flex flex-col justify-start">
        <div class="w-full flex items-stretch h-full">
          
          <!-- Section 1: CONTACT US -->
          <div class="w-1/2 pr-8 xl:pr-10 border-r border-white/30 flex flex-col justify-start">
            <h3 class="font-heading font-black text-sm text-white uppercase tracking-wider mb-8 text-left">
              {contactMega.section1.title}
            </h3>
            <ul class="space-y-4">
              {contactMega.section1.items.map((item) => (
                <li>
                  <span class="font-heading font-bold text-xs text-white hover:opacity-75 transition-opacity uppercase tracking-wide block text-left cursor-pointer">
                    {item.name}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Section 2: MORE FROM ROBBIE'S -->
          <div class="w-1/2 pl-8 xl:pl-10 flex flex-col justify-start">
            <h3 class="font-heading font-black text-sm text-white uppercase tracking-wider mb-8 text-left">
              {contactMega.section2.title}
            </h3>
            <ul class="space-y-4">
              {contactMega.section2.items.map((item) => (
                <li>
                  <span class="font-heading font-bold text-xs text-white hover:opacity-75 transition-opacity uppercase tracking-wide block text-left cursor-pointer">
                    {item.name}
                  </span>
                </li>
              ))}
            </ul>
          </div>

        </div>
      </div>

      <!-- Right Column: Full-Height HD Image -->
      <div class="col-span-5 xl:col-span-4 h-full relative overflow-hidden bg-slate-900">
        <img 
          src={contactMega.image} 
          alt="Contact Robbie's" 
          class="w-full h-full object-cover block"
          loading="lazy"
        />
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Overlay -->
  <div 
    id="mobile-menu-drawer"
    class="fixed inset-y-0 left-0 w-[85vw] max-w-md bg-[#2B447A] backdrop-blur-xl z-50 transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col p-6 overflow-y-auto border-r border-white/15 shadow-2xl xl:hidden"
  >
    <div class="flex items-center justify-between pb-4 border-b border-white/15 mb-4">
      <span class="text-xs uppercase tracking-widest text-white/70 font-semibold font-heading">Robbie's Navigation</span>
      <button 
        id="close-drawer-btn" 
        class="p-1.5 text-white hover:bg-white/10 rounded-lg"
        aria-label="Close drawer"
      >
        <X class="w-6 h-6" />
      </button>
    </div>

    <!-- Mobile Navigation Accordion List -->
    <div class="flex flex-col space-y-2 my-auto">
      
      <!-- ACTIVITIES Accordion -->
      <div class="border-b border-white/10">
        <button 
          type="button" 
          class="mobile-accordion-btn w-full text-left py-3 text-white text-base font-bold uppercase tracking-wider flex items-center justify-between"
          data-target="mobile-acc-activities"
        >
          <span>ACTIVITIES</span>
          <ChevronDown class="w-5 h-5 transition-transform duration-200 acc-chevron" />
        </button>
        <div id="mobile-acc-activities" class="hidden pl-4 pb-3 space-y-2 text-xs font-semibold text-white/80">
          {activitiesMega.col1.concat(activitiesMega.col2).map((sub) => (
            <span class="block py-1.5 hover:text-white uppercase transition-colors border-b border-white/5 cursor-pointer">
              • {sub.name}
            </span>
          ))}
        </div>
      </div>

      <!-- FISHING Accordion -->
      <div class="border-b border-white/10">
        <button 
          type="button" 
          class="mobile-accordion-btn w-full text-left py-3 text-white text-base font-bold uppercase tracking-wider flex items-center justify-between"
          data-target="mobile-acc-fishing"
        >
          <span>FISHING</span>
          <ChevronDown class="w-5 h-5 transition-transform duration-200 acc-chevron" />
        </button>
        <div id="mobile-acc-fishing" class="hidden pl-4 pb-3 space-y-3 text-xs font-semibold text-white/80">
          <div>
            <span class="block text-white font-black text-xs uppercase mb-1 border-b border-white/20 pb-1">ISLAMORADA FISHING</span>
            {fishingMega.section1.colA.concat(fishingMega.section1.colB).map((sub) => (
              <span class="block py-1 hover:text-white uppercase transition-colors cursor-pointer">
                • {sub.name}
              </span>
            ))}
          </div>
          <div class="pt-2">
            <span class="block text-white font-black text-xs uppercase mb-1 border-b border-white/20 pb-1">OUR CAPTAINS</span>
            {fishingMega.section2.colA.concat(fishingMega.section2.colB).map((sub) => (
              <span class="block py-1 hover:text-white uppercase transition-colors cursor-pointer">
                • {sub.name}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- RESTAURANT Link -->
      <a 
