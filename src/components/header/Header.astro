---
import TopBanner from './TopBanner.astro';
import { ShoppingBag, Search, Phone, Menu, X } from '@lucide/astro';

const navItems = [
  { name: 'ACTIVITIES', url: 'https://www.robbies.com/' },
  { name: 'FISHING', url: 'https://www.robbies.com/islamorada-fishing.htm' },
  { name: 'RESTAURANT', url: 'https://www.robbies.com/' },
  { name: 'SHOP', url: 'https://shop.robbies.com/' },
  { name: 'OPEN-AIR SHOPPING', url: 'https://www.robbies.com/' },
  { name: 'WEBCAM', url: 'https://www.robbies.com/' },
  { name: 'CONTACT US', url: 'https://www.robbies.com/' },
  { name: "VISITOR'S CENTER", url: 'https://www.robbies.com/' },
];
---

<!-- Header Contenedor Fijo / Sticky -->
<header id="main-header" class="w-full sticky top-0 z-50 shadow-md font-heading transition-all duration-300">
  <!-- Top Blue Banner Rotativo -->
  <TopBanner />

  <!-- Main Royal Navy Navbar (Color exacto Robbie's #2B447A) -->
  <nav class="bg-[#2B447A] text-white py-2.5 px-3 sm:px-6 lg:px-8 border-b border-blue-900/30">
    <div class="max-w-[1180px] mx-auto flex items-center justify-between gap-2 lg:gap-4">
      
      <!-- MOBILE ORDER (1º MENÚ IZQUIERDA, 2º LOGO, 3º ICONOS DERECHA) -->
      <!-- 1º: Mobile Menu Toggle Button (Extremo Izquierdo en Móvil) -->
      <div class="flex xl:hidden items-center">
        <button 
          id="mobile-menu-toggle"
          aria-label="Toggle Navigation Menu"
          class="p-1.5 rounded-lg text-white hover:bg-white/10 transition-colors focus:outline-none"
        >
          <Menu id="menu-icon-open" class="w-7 h-7" />
          <X id="menu-icon-close" class="w-7 h-7 hidden" />
        </button>
      </div>

      <!-- 2º: Brand Logo (Centro/Izquierda) -->
      <a href="/" class="flex-shrink-0 flex items-center group transition-transform duration-200 hover:opacity-95 mx-auto xl:mx-0">
        <img 
          src="/assets/common/robbies_logo_mobile.webp" 
          alt="Robbie's of Islamorada" 
          class="h-9 sm:h-12 md:h-14 lg:h-16 w-auto object-contain drop-shadow-sm"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation Menu -->
      <div class="hidden xl:flex items-center justify-center flex-1 mx-2 lg:mx-4">
        <ul class="flex items-center flex-wrap justify-center text-[11px] lg:text-[12px] xl:text-[12.5px] font-normal tracking-wider text-white">
          {navItems.map((item, index) => (
            <li class="flex items-center">
              <a 
                href={item.url} 
                class="hover:opacity-80 transition-opacity duration-200 py-1 px-1.5 lg:px-2 uppercase whitespace-nowrap"
              >
                {item.name}
              </a>
              {index < navItems.length - 1 && (
                <span class="text-white/40 font-light px-1 select-none text-[10px]">|</span>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- 3º: Right Action Items (Shop Bag, Search, Phone) -->
      <!-- Desktop Actions -->
      <div class="hidden md:flex items-center space-x-3 lg:space-x-5 text-white flex-shrink-0">
        <a 
          href="https://shop.robbies.com/" 
          target="_blank"
          aria-label="Shop Robbie's Merch"
          class="hover:opacity-80 transition-opacity duration-200 p-1.5 rounded-full hover:bg-white/10"
          title="Shop Merch"
        >
          <ShoppingBag class="w-5 h-5 stroke-[2]" />
        </a>

        <button 
          id="search-trigger-btn"
          aria-label="Search Robbie's site"
          class="hover:opacity-80 transition-opacity duration-200 p-1.5 rounded-full hover:bg-white/10 focus:outline-none"
          title="Search"
        >
          <Search class="w-5 h-5 stroke-[2]" />
        </button>

        <a 
          href="tel:3056648070" 
          class="flex items-center space-x-2 text-white hover:opacity-85 transition-opacity duration-200 font-bold text-xs lg:text-sm tracking-wide ml-1"
        >
          <Phone class="w-4 h-4 fill-white stroke-none flex-shrink-0" />
          <span class="whitespace-nowrap">(305) 664-8070</span>
        </a>
      </div>

      <!-- Mobile Actions (Iconos de Compra y Llamada a la Derecha) -->
      <div class="flex md:hidden items-center space-x-2">
        <a 
          href="https://shop.robbies.com/" 
          target="_blank"
          aria-label="Shop Robbie's Merch"
          class="p-1.5 text-white hover:bg-white/10 rounded-full"
        >
          <ShoppingBag class="w-5 h-5 stroke-[2]" />
        </a>
        <a 
          href="tel:3056648070" 
          aria-label="Call Robbie's"
          class="p-1.5 text-white bg-white/10 rounded-full border border-white/20"
        >
          <Phone class="w-4 h-4 fill-white stroke-none" />
        </a>
      </div>

    </div>
  </nav>

  <!-- Mobile Drawer Overlay -->
  <div 
    id="mobile-menu-drawer"
    class="fixed inset-y-0 left-0 w-[82vw] max-w-sm bg-[#2B447A] backdrop-blur-xl z-50 transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col p-6 overflow-y-auto border-r border-white/15 shadow-2xl xl:hidden"
  >
    <div class="flex items-center justify-between pb-4 border-b border-white/15 mb-4">
      <span class="text-xs uppercase tracking-widest text-white/70 font-semibold">Robbie's Navigation</span>
      <button 
        id="close-drawer-btn" 
        class="p-1.5 text-white hover:bg-white/10 rounded-lg"
        aria-label="Close drawer"
      >
        <X class="w-6 h-6" />
      </button>
    </div>

    <div class="flex flex-col space-y-2 my-auto">
      {navItems.map((item) => (
        <a 
          href={item.url} 
          class="text-white hover:opacity-75 text-base font-normal tracking-wider py-2.5 border-b border-white/10 uppercase transition-opacity"
        >
          {item.name}
        </a>
      ))}

      <div class="pt-6 flex flex-col gap-3">
        <a 
          href="https://shop.robbies.com/" 
          target="_blank"
          class="w-full py-3 bg-[#2B55FF] hover:bg-[#1D4ED8] text-white font-normal rounded-xl text-center flex items-center justify-center space-x-2 shadow-md transition-colors text-sm"
        >
          <ShoppingBag class="w-4 h-4" />
          <span>Shop Robbie's Merch</span>
        </a>

        <a 
          href="tel:3056648070" 
          class="w-full py-3 bg-white/15 hover:bg-white/25 text-white font-normal rounded-xl text-center flex items-center justify-center space-x-2 border border-white/20 transition-colors text-sm"
        >
          <Phone class="w-4 h-4 fill-white stroke-none" />
          <span>Call (305) 664-8070</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Backdrop Dark Overlay for Mobile Drawer -->
  <div 
    id="mobile-drawer-backdrop" 
    class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-40 hidden transition-opacity"
  ></div>

  <!-- Search Modal Overlay -->
  <div 
    id="search-modal"
    class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden items-center justify-center p-4"
  >
    <div class="bg-[#2B447A] border border-white/20 rounded-2xl p-6 w-full max-w-lg shadow-2xl relative">
      <button 
        id="close-search-btn"
        class="absolute top-4 right-4 text-slate-300 hover:text-white p-1"
        aria-label="Close search"
      >
        <X class="w-6 h-6" />
      </button>

      <h3 class="text-white text-lg font-bold mb-4 font-heading">Search Robbie's of Islamorada</h3>
      <form action="https://www.google.com/search" method="get" target="_blank" class="flex gap-2">
        <input 
          type="hidden" 
          name="q" 
          value="site:robbies.com" 
        />
        <input 
          type="text" 
          name="q"
          placeholder="What are you looking for?"
          class="flex-1 bg-white/10 text-white placeholder-slate-300 px-4 py-2.5 rounded-xl border border-white/20 focus:outline-none focus:border-[#2B55FF] text-sm"
          required
        />
        <button 
          type="submit"
          class="bg-[#2B55FF] hover:bg-[#1D4ED8] text-white font-normal px-5 py-2.5 rounded-xl transition-colors flex items-center space-x-1 text-sm"
        >
          <Search class="w-4 h-4" />
          <span>Search</span>
        </button>
      </form>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('close-drawer-btn');
  const drawer = document.getElementById('mobile-menu-drawer');
  const backdrop = document.getElementById('mobile-drawer-backdrop');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function openDrawer() {
    drawer?.classList.remove('-translate-x-full');
    backdrop?.classList.remove('hidden');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer?.classList.add('-translate-x-full');
    backdrop?.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  toggleBtn?.addEventListener('click', () => {
    const isOpen = !drawer?.classList.contains('-translate-x-full');
    if (isOpen) {
      closeDrawer();
    } else {
      openDrawer();
    }
  });

  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  // Search Modal
  const searchTrigger = document.getElementById('search-trigger-btn');
  const searchModal = document.getElementById('search-modal');
  const closeSearch = document.getElementById('close-search-btn');

  searchTrigger?.addEventListener('click', () => {
    searchModal?.classList.remove('hidden');
    searchModal?.classList.add('flex');
  });

  closeSearch?.addEventListener('click', () => {
    searchModal?.classList.add('hidden');
    searchModal?.classList.remove('flex');
  });
</script>
