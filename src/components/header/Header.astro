---
import TopBanner from './TopBanner.astro';
import { ShoppingBag, Search, Phone, Menu, X } from '@lucide/astro';

const navItems = [
  { name: 'ACTIVITIES', url: 'https://www.robbies.com/' },
  { name: 'FISHING', url: 'https://www.robbies.com/islamorada-fishing.htm' },
  { name: 'RESTAURANT', url: 'https://www.robbies.com/' },
  { name: 'SHOP', url: 'https://shop.robbies.com/' },
  { name: 'OPEN-AIR SHOPPING', url: 'https://www.robbies.com/' },
  { name: 'WEBCAM', url: 'https://www.robbies.com/' },
  { name: 'CONTACT US', url: 'https://www.robbies.com/' },
  { name: "VISITOR'S CENTER", url: 'https://www.robbies.com/' },
];
---

<header class="w-full relative z-40 shadow-lg font-heading">
  <!-- Top Blue Sliding Banner -->
  <TopBanner />

  <!-- Main Navy Navbar -->
  <nav class="bg-[#1C366E] text-white py-3.5 px-4 sm:px-6 lg:px-8 border-b border-blue-900/40">
    <div class="max-w-[1400px] mx-auto flex items-center justify-between gap-4">
      
      <!-- Brand Logo -->
      <a href="/" class="flex-shrink-0 flex items-center group transition-transform duration-200 hover:scale-[1.02]">
        <img 
          src="/assets/common/robbies_logo_mobile.webp" 
          alt="Robbie's of Islamorada" 
          class="h-12 sm:h-14 md:h-16 w-auto object-contain drop-shadow"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation Menu (Pixel-Perfect spacing & pipe separators) -->
      <div class="hidden xl:flex items-center justify-center flex-1 mx-4">
        <ul class="flex items-center flex-wrap justify-center text-[12px] sm:text-[13px] font-bold tracking-wider text-white">
          {navItems.map((item, index) => (
            <li class="flex items-center">
              <a 
                href={item.url} 
                class="hover:text-amber-400 transition-colors duration-200 py-1 px-1.5 sm:px-2 uppercase font-extrabold whitespace-nowrap"
              >
                {item.name}
              </a>
              {index < navItems.length - 1 && (
                <span class="text-white/40 font-normal px-1 select-none">|</span>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- Right Action Items (Shop Bag, Search, Phone) -->
      <div class="hidden md:flex items-center space-x-4 lg:space-x-5 text-white">
        <!-- Shop Icon -->
        <a 
          href="https://shop.robbies.com/" 
          target="_blank"
          aria-label="Shop Robbie's Merch"
          class="hover:text-amber-400 transition-colors duration-200 p-1"
          title="Shop Merch"
        >
          <ShoppingBag class="w-5 h-5 stroke-[2]" />
        </a>

        <!-- Search Icon (triggers search overlay) -->
        <button 
          id="search-trigger-btn"
          aria-label="Search Robbie's site"
          class="hover:text-amber-400 transition-colors duration-200 p-1 focus:outline-none"
          title="Search"
        >
          <Search class="w-5 h-5 stroke-[2]" />
        </button>

        <!-- Phone Contact -->
        <a 
          href="tel:3056648070" 
          class="flex items-center space-x-2 hover:text-amber-400 transition-colors duration-200 font-bold text-xs sm:text-sm tracking-wide bg-white/10 hover:bg-white/20 py-1.5 px-3 rounded-full border border-white/15"
        >
          <Phone class="w-4 h-4 fill-white stroke-none" />
          <span>(305) 664-8070</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex xl:hidden items-center space-x-3">
        <a 
          href="tel:3056648070" 
          class="md:hidden flex items-center space-x-1.5 text-xs font-bold text-white bg-white/10 px-2.5 py-1.5 rounded-full border border-white/20"
        >
          <Phone class="w-3.5 h-3.5 fill-white stroke-none" />
          <span>(305) 664-8070</span>
        </a>

        <button 
          id="mobile-menu-toggle"
          aria-label="Toggle Navigation Menu"
          class="p-2 rounded-lg text-white hover:bg-white/10 transition-colors focus:outline-none"
        >
          <Menu id="menu-icon-open" class="w-7 h-7" />
          <X id="menu-icon-close" class="w-7 h-7 hidden" />
        </button>
      </div>

    </div>
  </nav>

  <!-- Mobile Drawer Overlay -->
  <div 
    id="mobile-menu-drawer"
    class="fixed inset-x-0 top-[110px] bottom-0 bg-[#1C366E]/98 backdrop-blur-lg z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col p-6 overflow-y-auto border-t border-white/10 xl:hidden"
  >
    <div class="flex flex-col space-y-4 my-auto">
      {navItems.map((item) => (
        <a 
          href={item.url} 
          class="text-white hover:text-amber-400 text-lg font-bold tracking-wider py-2 border-b border-white/10 uppercase transition-colors"
        >
          {item.name}
        </a>
      ))}

      <div class="pt-6 flex flex-col gap-4">
        <a 
          href="https://shop.robbies.com/" 
          target="_blank"
          class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl text-center flex items-center justify-center space-x-2 shadow-md transition-colors"
        >
          <ShoppingBag class="w-5 h-5" />
          <span>Shop Robbie's Merch</span>
        </a>

        <a 
          href="tel:3056648070" 
          class="w-full py-3 bg-white/15 hover:bg-white/25 text-white font-bold rounded-xl text-center flex items-center justify-center space-x-2 border border-white/20 transition-colors"
        >
          <Phone class="w-5 h-5 fill-white stroke-none" />
          <span>Call (305) 664-8070</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Search Modal Overlay -->
  <div 
    id="search-modal"
    class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden items-center justify-center p-4"
  >
    <div class="bg-[#1C366E] border border-white/20 rounded-2xl p-6 w-full max-w-lg shadow-2xl relative">
      <button 
        id="close-search-btn"
        class="absolute top-4 right-4 text-slate-300 hover:text-white p-1"
        aria-label="Close search"
      >
        <X class="w-6 h-6" />
      </button>

      <h3 class="text-white text-lg font-bold mb-4 font-heading">Search Robbie's</h3>
      <form action="https://www.google.com/search" method="get" target="_blank" class="flex gap-2">
        <input 
          type="hidden" 
          name="q" 
          value="site:robbies.com" 
        />
        <input 
          type="text" 
          name="q"
          placeholder="What are you looking for?"
          class="flex-1 bg-white/10 text-white placeholder-slate-300 px-4 py-2.5 rounded-xl border border-white/20 focus:outline-none focus:border-amber-400"
          required
        />
        <button 
          type="submit"
          class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-5 py-2.5 rounded-xl transition-colors flex items-center space-x-1"
        >
          <Search class="w-4 h-4" />
          <span>Search</span>
        </button>
      </form>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-menu-drawer');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggleBtn?.addEventListener('click', () => {
    const isOpen = !drawer?.classList.contains('translate-x-full');
    if (isOpen) {
      drawer?.classList.add('translate-x-full');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = 'auto';
    } else {
      drawer?.classList.remove('translate-x-full');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  });

  // Search Modal
  const searchTrigger = document.getElementById('search-trigger-btn');
  const searchModal = document.getElementById('search-modal');
  const closeSearch = document.getElementById('close-search-btn');

  searchTrigger?.addEventListener('click', () => {
    searchModal?.classList.remove('hidden');
    searchModal?.classList.add('flex');
  });

  closeSearch?.addEventListener('click', () => {
    searchModal?.classList.add('hidden');
    searchModal?.classList.remove('flex');
  });
</script>
