---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/common/Footer.astro';
---

<Layout 
  title="Florida Keys Snorkeling Tours | Robbie's of Islamorada"
  description="Experience world-class snorkeling tours in Islamorada at Robbie's Marina! Daily catamaran reef trips, Alligator Reef Lighthouse, sea turtles, and pristine coral."
  image="/assets/snorkeling/imgi_53_ACTIVITIES-AT-ROBBIES-OF-ISLAMORADA-2-1536x628.webp"
  schemaType="TouristAttraction"
>
  <Header />

  <main class="flex-1 bg-white font-sans selection:bg-robbies-ocean selection:text-white w-full">
    
    <!-- 1. HERO BANNER - UNTINTED PHOTO, LEFT ALIGNED TEXT -->
    <section class="relative text-white py-20 sm:py-28 lg:py-32 px-6 sm:px-12 lg:px-16 overflow-hidden w-full min-h-[380px] sm:min-h-[440px] flex items-center">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/snorkeling/imgi_53_ACTIVITIES-AT-ROBBIES-OF-ISLAMORADA-2-1536x628.webp" 
          alt="Florida Keys Snorkeling Tours at Robbie's Marina" 
          class="w-full h-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="relative z-10 max-w-[1400px] w-full mx-auto text-left space-y-3">
        <h1 class="font-heading font-black text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] leading-[1.1] max-w-2xl">
          FLORIDA KEYS SNORKELING TOURS
        </h1>

        <p class="font-heading font-bold text-xs sm:text-sm lg:text-base text-white uppercase tracking-wider drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] max-w-xl">
          DISCOVER THE LIVING CORAL BARRIER REEF AT ROBBIE'S MARINA
        </p>
      </div>
    </section>

    <!-- 2. SECTION 1: BEST SNORKELING TOURS IN ISLAMORADA - FULL WIDTH 50/50 -->
    <section class="w-full bg-[#f0f2f5]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
        <div class="p-6 sm:p-10 lg:p-12 flex flex-col justify-center items-start space-y-4 bg-[#f0f2f5] order-2 lg:order-1">
          <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide leading-tight">
            Best Snorkeling Tours In Islamorada, Florida
          </h2>

          <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body max-w-xl">
            Snorkel trips available on two different vessels. Blue departs twice a day, 10:00AM and 1:30PM. KeyZ Charters can be booked for parties of 6 people or less. Join our activities!
          </p>

          <div class="pt-2">
            <a 
              href="tel:3056649875" 
              class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-2.5 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
            >
              BOOK NOW
            </a>
          </div>
        </div>

        <div class="w-full h-full min-h-[260px] sm:min-h-[320px] order-1 lg:order-2">
          <img 
            src="/assets/snorkeling/imgi_38_9a53c9be82e893c77a8754f51b65c986.DJI_0480-Edit.webp" 
            alt="Snorkeling Reef Trip Islamorada" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- 3. SECTION 2: KEYZ CHARTERS -->
    <section class="w-full bg-[#f0f2f5]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
        <div class="w-full h-full min-h-[260px] sm:min-h-[320px]">
          <img 
            src="/assets/snorkeling/imgi_39_Keyz-Charters.webp" 
            alt="KeyZ Charters Snorkeling Vessel" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

        <div class="p-6 sm:p-10 lg:p-12 flex flex-col justify-center items-start space-y-4 bg-[#f0f2f5]">
          <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide leading-tight">
            KeyZ Charters Private Snorkeling
          </h2>

          <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body max-w-xl">
            KeyZ Charters can be booked for intimate private parties of 6 people or less. Explore shallow reefs, sandbars, and secluded island ecosystems with an experienced captain.
          </p>

          <div class="pt-2">
            <a 
              href="tel:3056649875" 
              class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-2.5 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
            >
              BOOK PRIVATE CHARTER
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
