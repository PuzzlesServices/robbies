---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/header/Header.astro';
import Footer from '../../components/common/Footer.astro';
import CartDrawer from '../../components/shop/CartDrawer.astro';
import { getProductByHandle, getProducts } from '../../lib/shopify';
import { ShoppingBag, ArrowRight, ShieldCheck, ChevronRight, Tag, Truck, RefreshCw, Lock, Star, ChevronDown } from '@lucide/astro';

export async function getStaticPaths() {
  try {
    const products = await getProducts(250);
    return products.map((product: any) => ({
      params: { handle: product.handle },
      props: { product }
    }));
  } catch (e) {
    console.error('Error generating static paths for shop products:', e);
    return [];
  }
}

const { handle } = Astro.params;
let { product } = Astro.props;

if (!product && handle) {
  try {
    product = await getProductByHandle(handle);
  } catch (e) {
    console.error(`Error loading product [${handle}]:`, e);
  }
}

if (!product) {
  return Astro.redirect('/shop');
}

// Fetch Related Products
let relatedProducts: any[] = [];
try {
  const allProds = await getProducts(50);
  relatedProducts = allProds
    .filter((p: any) => p.handle !== product.handle && p.hasRealImage && p.inStock)
    .slice(0, 4);
} catch (e) {
  relatedProducts = [];
}

const minPrice = parseFloat(product.priceRange?.minVariantPrice?.amount || '0').toFixed(2);
const currency = product.priceRange?.minVariantPrice?.currencyCode || 'USD';
const images = product.imagesList || [];
const mainImage = product.featuredImageUrl || '/assets/home/imgi_19_shop.webp';
const variants = product.variantsList || product.variants?.edges?.map((e: any) => e.node) || [];
const firstVariant = variants[0];

const colors = product.colors || [];
const sizes = product.sizes || [];

const initialColor = colors[0]?.name || '';
const initialSize = sizes[0] || '';
---

<Layout 
  title={`${product.title} | Official Robbie's Store`}
  description={product.description || `Buy ${product.title} official merchandise from Robbie's of Islamorada.`}
  image={mainImage}
>
  <Header />

  <!-- Hidden Product Data Script for Client-Side JS -->
  <script id="product-page-dataset" type="application/json" set:html={JSON.stringify({ product, variants, images })} />

  <main class="flex-1 bg-white min-h-screen border-t border-slate-100">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 md:px-8 py-8 sm:py-12">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-8 overflow-x-auto select-none">
        <a href="/" class="hover:text-slate-900 transition-colors shrink-0">Home</a>
        <ChevronRight class="w-3.5 h-3.5 text-slate-300 shrink-0" />
        <a href="/shop" class="hover:text-slate-900 transition-colors shrink-0">Shop Catalog</a>
        <ChevronRight class="w-3.5 h-3.5 text-slate-300 shrink-0" />
        <span class="text-slate-900 font-bold truncate max-w-[200px] sm:max-w-xs">{product.title}</span>
      </nav>

      <!-- Main Product Details Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start mb-16">
        
        <!-- Left Column: Gallery / Images (Uncropped object-contain p-4) -->
        <div class="lg:col-span-7 space-y-4">
          
          <!-- Main Display Image (Fully uncropped with object-contain) -->
          <div class="w-full aspect-square bg-slate-50 rounded-3xl overflow-hidden border border-slate-100 relative group flex items-center justify-center p-4">
            
            <!-- In-Stock Badge -->
            <span class="absolute top-4 left-4 z-10 inline-flex items-center gap-1.5 bg-emerald-50 border border-emerald-200 text-emerald-800 text-[11px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider shadow-2xs">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> In Stock & Ready to Ship
            </span>

            <img 
              id="main-product-image"
              src={mainImage} 
              alt={product.featuredImage?.altText || product.title} 
              class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105"
            />
          </div>

          <!-- Thumbnails Scrollbar -->
          {images.length > 1 && (
            <div class="flex items-center gap-3 overflow-x-auto pb-2 scrollbar-thin select-none">
              {images.map((img: any, i: number) => (
                <button 
                  type="button" 
                  class={`w-20 h-20 bg-slate-50 rounded-2xl overflow-hidden border-2 transition-all shrink-0 cursor-pointer p-1 flex items-center justify-center thumbnail-btn ${i === 0 ? 'border-[#2B447A] shadow-md scale-105' : 'border-slate-200 hover:border-slate-300 opacity-80 hover:opacity-100'}`}
                  data-img-src={img.url}
                  data-idx={i}
                >
                  <img src={img.url} alt={img.altText || product.title} class="w-full h-full object-contain" />
                </button>
              ))}
            </div>
          )}

          <!-- Trust Value Propositions Bar -->
          <div class="grid grid-cols-3 gap-3 pt-4 border-t border-slate-100 text-center select-none">
            <div class="p-3 bg-slate-50 rounded-2xl border border-slate-100 flex flex-col items-center">
              <Truck class="w-5 h-5 text-[#2B447A] mb-1" />
              <span class="text-[11px] font-extrabold text-slate-800 uppercase tracking-wider">Fast Shipping</span>
              <span class="text-[10px] text-slate-400">Direct from Florida Keys</span>
            </div>
            <div class="p-3 bg-slate-50 rounded-2xl border border-slate-100 flex flex-col items-center">
              <Lock class="w-5 h-5 text-emerald-600 mb-1" />
              <span class="text-[11px] font-extrabold text-slate-800 uppercase tracking-wider">100% Secure</span>
              <span class="text-[10px] text-slate-400">Shopify SSL Encrypted</span>
            </div>
            <div class="p-3 bg-slate-50 rounded-2xl border border-slate-100 flex flex-col items-center">
              <RefreshCw class="w-5 h-5 text-indigo-600 mb-1" />
              <span class="text-[11px] font-extrabold text-slate-800 uppercase tracking-wider">Easy Returns</span>
              <span class="text-[10px] text-slate-400">Hassle-Free Guarantee</span>
            </div>
          </div>

        </div>

        <!-- Right Column: Product Title, Pricing, Swatches, Sizes & Buy Actions -->
        <div class="lg:col-span-5 flex flex-col space-y-6">
          
          <div>
            <span class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-widest text-[#2B55FF] mb-2 bg-blue-50 px-3 py-1 rounded-full border border-blue-100">
              <Tag class="w-3.5 h-3.5" /> Official Robbie's Merchandise
            </span>

            <h1 class="font-heading font-black text-2xl sm:text-3xl md:text-4xl text-slate-900 uppercase tracking-tight leading-tight mb-3">
              {product.title}
            </h1>

            <!-- Ratings Mock -->
            <div class="flex items-center gap-2 mb-4">
              <div class="flex items-center text-amber-400">
                <Star class="w-4 h-4 fill-amber-400" />
                <Star class="w-4 h-4 fill-amber-400" />
                <Star class="w-4 h-4 fill-amber-400" />
                <Star class="w-4 h-4 fill-amber-400" />
                <Star class="w-4 h-4 fill-amber-400" />
              </div>
              <span class="text-xs font-bold text-slate-600">5.0 (Authentic Customer Favorite)</span>
            </div>

            <!-- Price Display -->
            <div class="flex items-baseline gap-3 pb-6 border-b border-slate-100">
              <span id="product-price-display" class="font-heading font-black text-3xl sm:text-4xl text-[#2B447A]">
                ${minPrice} <span class="text-sm font-extrabold text-slate-400">{currency}</span>
              </span>
            </div>
          </div>

          <!-- Color Swatches Selector -->
          {colors.length > 0 && (
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <label class="font-heading font-extrabold text-xs uppercase tracking-wider text-slate-700">
                  Select Color: <span id="color-label-display" class="text-[#2B447A]">{initialColor}</span>
                </label>
              </div>
              <div class="flex items-center flex-wrap gap-2">
                {colors.map((c: any, idx: number) => (
                  <button 
                    type="button" 
                    class={`p-1 rounded-full border-2 transition-all cursor-pointer detail-swatch-btn ${idx === 0 ? 'border-[#2B447A] ring-2 ring-[#2B447A]/30 scale-105' : 'border-transparent opacity-80 hover:opacity-100 hover:scale-105'}`}
                    data-color={c.name}
                    data-image={c.imageUrl || ''}
                    title={c.name}
                  >
                    <span class="w-7 h-7 rounded-full block border border-slate-300 shadow-2xs" style={`background-color: ${c.hex}`}></span>
                  </button>
                ))}
              </div>
            </div>
          )}

          <!-- Size Pills Selector -->
          {sizes.length > 0 && (
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <label class="font-heading font-extrabold text-xs uppercase tracking-wider text-slate-700">
                  Select Size: <span id="size-label-display" class="text-[#2B447A]">{initialSize}</span>
                </label>
              </div>
              <div class="flex items-center flex-wrap gap-2">
                {sizes.map((s: string, idx: number) => (
                  <button 
                    type="button" 
                    class={`px-4 py-2.5 rounded-xl border text-xs font-black uppercase transition-all cursor-pointer detail-size-btn ${idx === 0 ? 'bg-[#2B447A] text-white border-[#2B447A] shadow-md scale-105' : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100'}`}
                    data-size={s}
                  >
                    {s}
                  </button>
                ))}
              </div>
            </div>
          )}

          <!-- All Variants Fallback Select (if no distinct color/size options) -->
          {colors.length === 0 && sizes.length === 0 && variants.length > 1 && (
            <div class="space-y-2">
              <label class="block font-heading font-extrabold text-xs uppercase tracking-wider text-slate-700">
                Select Option:
              </label>
              <div class="grid grid-cols-2 gap-2">
                {variants.map((v: any, idx: number) => (
                  <button 
                    type="button" 
                    class={`detail-variant-btn p-3 rounded-xl border text-xs font-bold text-center transition-all cursor-pointer ${idx === 0 ? 'bg-[#2B447A] text-white border-[#2B447A] shadow-sm' : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100'}`}
                    data-variant-id={v.id}
                    data-price={v.price?.amount || v.price || minPrice}
                    data-title={v.title}
                    data-image={v.imageUrl || mainImage}
                  >
                    {v.title}
                  </button>
                ))}
              </div>
            </div>
          )}

          <!-- Quantity Controls & Add to Cart -->
          <div class="space-y-4 pt-2">
            
            <div class="flex items-center gap-4">
              <span class="font-heading font-extrabold text-xs uppercase tracking-wider text-slate-700">Quantity:</span>
              <div class="flex items-center border border-slate-300 rounded-xl bg-slate-50 overflow-hidden font-bold">
                <button type="button" id="qty-minus" class="px-3.5 py-2 text-slate-600 hover:bg-slate-200 transition-colors text-base cursor-pointer">-</button>
                <span id="qty-val" class="px-4 text-slate-900 text-sm font-black">1</span>
                <button type="button" id="qty-plus" class="px-3.5 py-2 text-slate-600 hover:bg-slate-200 transition-colors text-base cursor-pointer">+</button>
              </div>
            </div>

            <!-- Primary Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-3 pt-2">
              <button 
                id="add-to-cart-btn"
                type="button"
                class="flex-1 bg-[#2B447A] hover:bg-[#1F3664] text-white font-heading font-black py-4 px-6 rounded-full shadow-lg hover:shadow-xl transition-all active:scale-95 flex items-center justify-center gap-2 uppercase tracking-wider text-xs sm:text-sm cursor-pointer"
                data-selected-variant-id={firstVariant?.id || ''}
                data-product-id={product.id}
                data-title={product.title}
                data-variant-title={initialColor && initialSize ? `Color: ${initialColor} / Size: ${initialSize}` : (initialSize ? `Size: ${initialSize}` : initialColor)}
                data-price={firstVariant?.price || minPrice}
                data-image={mainImage}
                data-handle={product.handle}
              >
                <ShoppingBag class="w-5 h-5" />
                <span>Add to Cart</span>
              </button>

              <button 
                id="buy-now-btn"
                type="button"
                class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-heading font-black py-4 px-6 rounded-full shadow-lg hover:shadow-xl transition-all active:scale-95 flex items-center justify-center gap-2 uppercase tracking-wider text-xs sm:text-sm cursor-pointer"
              >
                <span>Buy Now</span>
                <ArrowRight class="w-4 h-4" />
              </button>
            </div>

          </div>

          <!-- Product Details Accordion Tabs -->
          <div class="border-t border-slate-100 pt-6 space-y-3 font-heading select-none">
            
            <!-- Tab 1: Product Description -->
            <div class="border border-slate-200 rounded-2xl overflow-hidden">
              <button 
                type="button"
                class="tab-toggle-btn w-full p-4 bg-slate-50 flex items-center justify-between font-black text-xs uppercase tracking-wider text-slate-800 hover:bg-slate-100 transition-colors cursor-pointer text-left"
                data-target="tab-desc"
              >
                <span>Product Overview & Details</span>
                <ChevronDown class="w-4 h-4 text-slate-500 tab-icon transition-transform" />
              </button>
              <div id="tab-desc" class="p-4 bg-white text-xs sm:text-sm text-slate-600 leading-relaxed font-sans border-t border-slate-100">
                {product.descriptionHtml ? (
                  <div class="prose prose-slate max-w-none text-xs sm:text-sm" set:html={product.descriptionHtml} />
                ) : (
                  <p>{product.description || 'Authentic Robbie’s of Islamorada official gear.'}</p>
                )}
              </div>
            </div>

            <!-- Tab 2: Shipping & Delivery -->
            <div class="border border-slate-200 rounded-2xl overflow-hidden">
              <button 
                type="button"
                class="tab-toggle-btn w-full p-4 bg-slate-50 flex items-center justify-between font-black text-xs uppercase tracking-wider text-slate-800 hover:bg-slate-100 transition-colors cursor-pointer text-left"
                data-target="tab-shipping"
              >
                <span>Shipping & Returns Policy</span>
                <ChevronDown class="w-4 h-4 text-slate-500 tab-icon transition-transform" />
              </button>
              <div id="tab-shipping" class="hidden p-4 bg-white text-xs sm:text-sm text-slate-600 leading-relaxed font-sans space-y-2 border-t border-slate-100">
                <p><strong>Standard US Shipping:</strong> Orders are processed and shipped directly from Islamorada, Florida within 1-2 business days via USPS or UPS.</p>
                <p><strong>30-Day Money Back Guarantee:</strong> Returns and exchanges are accepted within 30 days of receiving your item in original unworn condition.</p>
              </div>
            </div>

          </div>

        </div>

      </div>

      <!-- RELATED PRODUCTS SECTION ("You May Also Like") -->
      {relatedProducts.length > 0 && (
        <section class="border-t border-slate-200/80 pt-12 pb-6">
          <div class="flex items-center justify-between mb-8">
            <div>
              <span class="text-xs font-black uppercase text-[#2B55FF] tracking-widest block mb-1">Explore More</span>
              <h2 class="font-heading font-black text-2xl text-slate-900 uppercase">You May Also Like</h2>
            </div>
            <a href="/shop" class="text-xs font-bold text-[#2B447A] hover:underline uppercase tracking-wider">
              View All Products &rarr;
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
            {relatedProducts.map(rel => {
              const relPrice = parseFloat(rel.priceRange?.minVariantPrice?.amount || '0').toFixed(2);
              const relImg = rel.featuredImageUrl || '/assets/home/imgi_19_shop.webp';

              return (
                <a href={`/shop/${rel.handle}`} class="group flex flex-col bg-white rounded-2xl p-3 hover:shadow-md transition-shadow text-left">
                  <div class="w-full aspect-square bg-slate-50 rounded-xl overflow-hidden mb-3 border border-slate-100 flex items-center justify-center p-2">
                    <img src={relImg} alt={rel.title} class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />
                  </div>
                  <h3 class="font-heading font-bold text-xs text-[#2B447A] group-hover:text-blue-600 transition-colors line-clamp-2 mb-1">
                    {rel.title}
                  </h3>
                  <span class="font-heading font-black text-sm text-slate-900">${relPrice} USD</span>
                </a>
              );
            })}
          </div>
        </section>
      )}

    </div>
  </main>

  <!-- STICKY FLOATING BUY BAR (Appears on Scroll for High Conversion) -->
  <div 
    id="sticky-buy-bar"
    class="fixed bottom-0 inset-x-0 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-2xl p-3 sm:p-4 z-40 transform translate-y-full transition-transform duration-300 ease-in-out"
  >
    <div class="max-w-[1240px] mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center gap-3 min-w-0">
        <img src={mainImage} alt={product.title} class="w-12 h-12 object-contain bg-slate-50 border border-slate-200 rounded-xl shrink-0" />
        <div class="min-w-0">
          <h4 class="font-heading font-black text-xs sm:text-sm text-slate-900 uppercase truncate">{product.title}</h4>
          <p id="sticky-bar-variant-info" class="text-[11px] font-bold text-slate-500 font-heading">
            ${minPrice} USD · <span id="sticky-selected-summary">{initialSize || initialColor || 'In Stock'}</span>
          </p>
        </div>
      </div>

      <button 
        id="sticky-add-btn"
        type="button"
        class="bg-[#2B447A] hover:bg-[#1F3664] text-white font-heading font-black text-xs uppercase tracking-wider py-3 px-6 rounded-full shadow-md hover:shadow-lg transition-all active:scale-95 shrink-0 cursor-pointer flex items-center gap-2"
      >
        <ShoppingBag class="w-4 h-4" />
        <span>Add to Cart</span>
      </button>
    </div>
  </div>

  <Footer />
  <CartDrawer />
</Layout>

<script is:inline>
  (function() {
    function initProductDetailPage() {
      let pageData = { product: null, variants: [], images: [] };
      const scriptEl = document.getElementById('product-page-dataset');
      if (scriptEl) {
        try {
          pageData = JSON.parse(scriptEl.textContent || '{}');
        } catch(e) {}
      }

      const mainImg = document.getElementById('main-product-image');
      const thumbBtns = document.querySelectorAll('.thumbnail-btn');
      
      const swatchBtns = document.querySelectorAll('.detail-swatch-btn');
      const sizeBtns = cardOrDoc('.detail-size-btn');
      const variantBtns = cardOrDoc('.detail-variant-btn');

      const colorLabel = document.getElementById('color-label-display');
      const sizeLabel = document.getElementById('size-label-display');
      const priceDisplay = document.getElementById('product-price-display');

      const addToCartBtn = document.getElementById('add-to-cart-btn');
      const buyNowBtn = document.getElementById('buy-now-btn');
      const stickyAddBtn = document.getElementById('sticky-add-btn');
      const stickyBar = document.getElementById('sticky-buy-bar');
      const stickySummary = document.getElementById('sticky-selected-summary');

      const qtyMinus = document.getElementById('qty-minus');
      const qtyPlus = document.getElementById('qty-plus');
      const qtyVal = document.getElementById('qty-val');

      let currentQty = 1;

      let selectedColor = swatchBtns.length > 0 ? swatchBtns[0].getAttribute('data-color') : '';
      let selectedSize = sizeBtns.length > 0 ? sizeBtns[0].getAttribute('data-size') : '';

      function cardOrDoc(selector) {
        return document.querySelectorAll(selector);
      }

      // Thumbnail Clicks
      thumbBtns.forEach(btn => {
        btn.onclick = () => {
          const newSrc = btn.getAttribute('data-img-src');
          if (mainImg && newSrc) mainImg.src = newSrc;
          thumbBtns.forEach(b => {
            b.classList.remove('border-[#2B447A]', 'shadow-md', 'scale-105');
            b.classList.add('border-slate-200', 'opacity-80');
          });
          btn.classList.remove('border-slate-200', 'opacity-80');
          btn.classList.add('border-[#2B447A]', 'shadow-md', 'scale-105');
        };
      });

      // Quantity Controls
      if (qtyMinus) {
        qtyMinus.onclick = () => {
          if (currentQty > 1) {
            currentQty--;
            if (qtyVal) qtyVal.textContent = currentQty;
          }
        };
      }
      if (qtyPlus) {
        qtyPlus.onclick = () => {
          currentQty++;
          if (qtyVal) qtyVal.textContent = currentQty;
        };
      }

      function updateMatchedVariant() {
        const variants = pageData.variants || [];
        if (variants.length === 0) return;

        let matched = variants.find(v => {
          const matchC = !selectedColor || (v.optionsObj && v.optionsObj.color === selectedColor);
          const matchS = !selectedSize || (v.optionsObj && v.optionsObj.size === selectedSize);
          return matchC && matchS;
        });

        if (!matched && selectedColor) {
          matched = variants.find(v => v.optionsObj && v.optionsObj.color === selectedColor);
        }
        if (!matched) matched = variants[0];

        if (matched) {
          let vTitle = matched.title && matched.title !== 'Default Title' ? matched.title : '';
          if (selectedColor && selectedSize) {
            vTitle = `Color: ${selectedColor} / Size: ${selectedSize}`;
          } else if (selectedSize) {
            vTitle = `Size: ${selectedSize}`;
          } else if (selectedColor) {
            vTitle = `Color: ${selectedColor}`;
          }

          if (addToCartBtn) {
            addToCartBtn.setAttribute('data-selected-variant-id', matched.id);
            if (matched.price) addToCartBtn.setAttribute('data-price', matched.price);
            addToCartBtn.setAttribute('data-variant-title', vTitle);
            if (matched.imageUrl) addToCartBtn.setAttribute('data-image', matched.imageUrl);
          }

          if (priceDisplay && matched.price) {
            priceDisplay.innerHTML = `$${parseFloat(matched.price).toFixed(2)} <span class="text-sm font-bold text-slate-400">USD</span>`;
          }

          if (stickySummary) {
            stickySummary.textContent = vTitle || 'Selected Option';
          }

          if (mainImg && matched.imageUrl) {
            mainImg.src = matched.imageUrl;
          }
        }
      }

      // Swatch Clicks
      swatchBtns.forEach(btn => {
        btn.onclick = () => {
          swatchBtns.forEach(b => {
            b.classList.remove('border-[#2B447A]', 'ring-2', 'ring-[#2B447A]/30', 'scale-105');
            b.classList.add('border-transparent', 'opacity-80');
          });
          btn.classList.remove('border-transparent', 'opacity-80');
          btn.classList.add('border-[#2B447A]', 'ring-2', 'ring-[#2B447A]/30', 'scale-105');

          selectedColor = btn.getAttribute('data-color') || '';
          if (colorLabel) colorLabel.textContent = selectedColor;

          updateMatchedVariant();
        };
      });

      // Size Clicks
      sizeBtns.forEach(btn => {
        btn.onclick = () => {
          sizeBtns.forEach(b => {
            b.classList.remove('bg-[#2B447A]', 'text-white', 'border-[#2B447A]', 'shadow-md', 'scale-105');
            b.classList.add('bg-slate-50', 'text-slate-700', 'border-slate-200');
          });
          btn.classList.remove('bg-slate-50', 'text-slate-700', 'border-slate-200');
          btn.classList.add('bg-[#2B447A]', 'text-white', 'border-[#2B447A]', 'shadow-md', 'scale-105');

          selectedSize = btn.getAttribute('data-size') || '';
          if (sizeLabel) sizeLabel.textContent = selectedSize;

          updateMatchedVariant();
        };
      });

      // All Variant Buttons Fallback
      variantBtns.forEach(btn => {
        btn.onclick = () => {
          variantBtns.forEach(b => {
            b.classList.remove('bg-[#2B447A]', 'text-white', 'border-[#2B447A]', 'shadow-sm');
            b.classList.add('bg-slate-50', 'text-slate-700', 'border-slate-200');
          });
          btn.classList.remove('bg-slate-50', 'text-slate-700', 'border-slate-200');
          btn.classList.add('bg-[#2B447A]', 'text-white', 'border-[#2B447A]', 'shadow-sm');

          const varId = btn.getAttribute('data-variant-id');
          const varPrice = btn.getAttribute('data-price');
          const vTitle = btn.getAttribute('data-title') || '';
          const varImg = btn.getAttribute('data-image');

          if (addToCartBtn) {
            addToCartBtn.setAttribute('data-selected-variant-id', varId);
            if (varPrice) addToCartBtn.setAttribute('data-price', varPrice);
            addToCartBtn.setAttribute('data-variant-title', vTitle);
          }

          if (priceDisplay && varPrice) {
            priceDisplay.innerHTML = `$${parseFloat(varPrice).toFixed(2)} <span class="text-sm font-bold text-slate-400">USD</span>`;
          }

          if (mainImg && varImg) mainImg.src = varImg;
        };
      });

      // Add To Cart Handler
      function executeAddToCart() {
        if (!addToCartBtn) return;
        const variantId = addToCartBtn.getAttribute('data-selected-variant-id');
        const productId = addToCartBtn.getAttribute('data-product-id');
        const title = addToCartBtn.getAttribute('data-title');
        const variantTitle = addToCartBtn.getAttribute('data-variant-title') || '';
        const price = addToCartBtn.getAttribute('data-price');
        const image = addToCartBtn.getAttribute('data-image');
        const handle = addToCartBtn.getAttribute('data-handle');

        if (window.addShopifyItemToCart) {
          window.addShopifyItemToCart({
            variantId,
            productId,
            title,
            variantTitle,
            price,
            image,
            handle,
            quantity: currentQty
          });
        }
      }

      if (addToCartBtn) addToCartBtn.onclick = executeAddToCart;
      if (stickyAddBtn) stickyAddBtn.onclick = executeAddToCart;

      // Buy Now Handler -> Instant Shopify Checkout
      if (buyNowBtn) {
        buyNowBtn.onclick = async () => {
          const variantId = addToCartBtn?.getAttribute('data-selected-variant-id');
          if (!variantId || variantId === 'undefined') {
            alert('Please select a valid option/variant.');
            return;
          }

          buyNowBtn.disabled = true;
          buyNowBtn.innerHTML = '<span>Creating Checkout...</span>';

          try {
            const query = `
              mutation cartCreate($input: CartInput!) {
                cartCreate(input: $input) {
                  cart { checkoutUrl }
                  userErrors { field message }
                }
              }
            `;

            const res = await fetch('https://shop.robbies.com/api/2024-07/graphql.json', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-Shopify-Storefront-Access-Token': '0d87a6f954a1e1d67f633ecce7ddfd2b'
              },
              body: JSON.stringify({ query, variables: { input: { lines: [{ merchandiseId: variantId, quantity: currentQty }] } } })
            });

            const json = await res.json();
            const checkoutUrl = json.data?.cartCreate?.cart?.checkoutUrl;

            if (checkoutUrl) {
              window.location.href = checkoutUrl;
            } else {
              alert('Error creating Shopify Checkout.');
              buyNowBtn.disabled = false;
              buyNowBtn.innerHTML = '<span>Buy Now</span>';
            }
          } catch(err) {
            console.error('Buy now error:', err);
            buyNowBtn.disabled = false;
            buyNowBtn.innerHTML = '<span>Buy Now</span>';
          }
        };
      }

      // Accordion Tabs Toggle
      document.querySelectorAll('.tab-toggle-btn').forEach(btn => {
        btn.onclick = () => {
          const targetId = btn.getAttribute('data-target');
          const targetEl = document.getElementById(targetId);
          const icon = btn.querySelector('.tab-icon');
          if (targetEl) {
            const isHidden = targetEl.classList.contains('hidden');
            targetEl.classList.toggle('hidden');
            if (icon) icon.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
          }
        };
      });

      // Sticky Buy Bar Scroll Observer
      if (stickyBar && addToCartBtn) {
        window.addEventListener('scroll', () => {
          const btnRect = addToCartBtn.getBoundingClientRect();
          if (btnRect.bottom < 0) {
            stickyBar.classList.remove('translate-y-full');
          } else {
            stickyBar.classList.add('translate-y-full');
          }
        }, { passive: true });
      }

      // Initialize default active variant
      updateMatchedVariant();
    }

    document.addEventListener('DOMContentLoaded', initProductDetailPage);
    document.addEventListener('astro:page-load', initProductDetailPage);
  })();
</script>
