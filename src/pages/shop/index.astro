---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/header/Header.astro';
import Footer from '../../components/common/Footer.astro';
import CartDrawer from '../../components/shop/CartDrawer.astro';
import { getProducts, getCollections, getProductsByCollection } from '../../lib/shopify';
import { ShoppingBag, Tag, ChevronLeft, ChevronRight, Filter, ShieldCheck, ChevronDown } from '@lucide/astro';

const url = new URL(Astro.request.url);
const currentCategory = url.searchParams.get('category') || '';
const currentPage = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
const ITEMS_PER_PAGE = 9; // 9 items per page (3x3 grid)

let allProducts: any[] = [];
let collections: any[] = [];
let errorMsg = '';

try {
  collections = await getCollections(50);
  
  if (currentCategory) {
    allProducts = await getProductsByCollection(currentCategory, 250);
  } else {
    allProducts = await getProducts(250);
  }
} catch (e) {
  console.error('Error loading shop data:', e);
  errorMsg = 'Could not load store products from Shopify.';
}

// Ensure strictly in-stock products
allProducts = allProducts.filter(p => p && p.inStock);

// Category Hierarchy
const categoryStructure = [
  {
    title: 'MEN',
    handle: 'men',
    subcategories: [
      { title: "All Men's", handle: 'men' },
      { title: "Short-Sleeve Tees", handle: 'short-sleeve-tees-men' },
      { title: "Performance Shirts", handle: 'long-sleeve-performance-shirts-men' },
      { title: "Long-Sleeve Tees", handle: 'long-sleeve-tees-men' },
      { title: "Tank Tops & Sleeveless", handle: 'tank-tops-sleeveless-men' },
      { title: "Sweatshirts & Hoodies", handle: 'sweatshirts-hoodies' }
    ]
  },
  {
    title: 'WOMEN',
    handle: 'women',
    subcategories: [
      { title: "All Women's", handle: 'women' },
      { title: "Tank Tops", handle: 'tank-tops-women' },
      { title: "Short-Sleeve Tees", handle: 'short-sleeve-tees-women' },
      { title: "Performance Tees", handle: 'womens-long-sleeve-performance-tees' },
      { title: "Long-Sleeve Tees", handle: 'womens-long-sleeve-tees' },
      { title: "Sweatshirts & Hoodies", handle: 'sweatshirts-hoodies-women' }
    ]
  },
  {
    title: 'KIDS',
    handle: 'youth-kids',
    subcategories: [
      { title: "All Kids", handle: 'youth-kids' },
      { title: "Short-Sleeve Tees", handle: 'short-sleeve-tees-youth-kids' },
      { title: "Performance Shirts", handle: 'youth-kids-long-sleeve-performance-shirts' },
      { title: "Long-Sleeve Tees", handle: 'youth-kids-long-sleeve-tees' }
    ]
  },
  { title: 'TODDLERS', handle: 'toddlers' },
  { title: 'HATS', handle: 'hats-headwear' },
  { title: 'SOUVENIRS', handle: 'gifts-souvenirs' }
];

// Calculate Pagination (9 items per page)
const totalProducts = allProducts.length;
const totalPages = Math.ceil(totalProducts / ITEMS_PER_PAGE) || 1;
const validPage = Math.min(currentPage, totalPages);
const startIndex = (validPage - 1) * ITEMS_PER_PAGE;
const paginatedProducts = allProducts.slice(startIndex, startIndex + ITEMS_PER_PAGE);

// Truncated Pagination Generator Range (e.g. 1 2 3 ... 10)
function getPaginationRange(current: number, total: number) {
  const delta = 1;
  const range: number[] = [];
  const rangeWithDots: (number | string)[] = [];
  let l: number | undefined;

  for (let i = 1; i <= total; i++) {
    if (i === 1 || i === total || (i >= current - delta && i <= current + delta)) {
      range.push(i);
    }
  }

  for (const i of range) {
    if (l !== undefined) {
      if (i - l === 2) {
        rangeWithDots.push(l + 1);
      } else if (i - l !== 1) {
        rangeWithDots.push('...');
      }
    }
    rangeWithDots.push(i);
    l = i;
  }

  return rangeWithDots;
}

const paginationRange = getPaginationRange(validPage, totalPages);

// Active category title finder
let activeCategoryTitle = 'All Products';
categoryStructure.forEach(cat => {
  if (cat.handle === currentCategory) activeCategoryTitle = cat.title;
  cat.subcategories?.forEach(sub => {
    if (sub.handle === currentCategory) activeCategoryTitle = `${cat.title} - ${sub.title}`;
  });
});
---

<Layout 
  title={`${activeCategoryTitle} | Robbie's Shop`}
  description="Shop official Robbie's of Islamorada merchandise, t-shirts, hats, souvenirs, and performance gear."
  image="/assets/home/imgi_19_shop.webp"
>
  <Header />

  <main class="flex-1 bg-white min-h-screen border-t border-slate-100">
    
    <!-- Hero Banner (Clean Shop Header) -->
    <section class="w-full bg-[#2B447A] text-white py-10 px-6 relative overflow-hidden select-none">
      <div class="max-w-[1240px] mx-auto text-center relative z-10">
        <span class="inline-flex items-center gap-1.5 bg-white/10 text-white/90 text-xs font-bold px-3.5 py-1 rounded-full uppercase tracking-widest mb-3 border border-white/20">
          <Tag class="w-3.5 h-3.5" /> Official Robbie's Store
        </span>
        <h1 class="font-heading font-black text-3xl sm:text-4xl md:text-5xl uppercase tracking-tight mb-2">
          ROBBIE'S OFFICIAL MERCHANDISE
        </h1>
        <p class="font-heading font-normal text-xs sm:text-sm text-white/90 max-w-xl mx-auto">
          Explore our collection of authentic t-shirts, performance wear, hats, plush tarpons, and Key West souvenirs.
        </p>
      </div>
    </section>

    <!-- Main Storefront Section -->
    <section class="max-w-[1280px] mx-auto px-4 sm:px-6 md:px-8 py-10">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- LEFT SIDEBAR: CATEGORIES ACCORDION & DROPDOWN LIST -->
        <aside class="lg:col-span-3 bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs space-y-6">
          
          <!-- Category Header Bar -->
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="font-heading font-black text-sm uppercase text-slate-900 tracking-wider flex items-center gap-2">
              <Filter class="w-4 h-4 text-[#2B447A]" /> Categories Filter
            </h3>
            {currentCategory && (
              <a href="/shop" class="text-[11px] font-bold text-[#2B55FF] hover:underline">
                Clear Filter
              </a>
            )}
          </div>

          <!-- Dropdown Category Filter (Quick Select for Mobile & Desktop) -->
          <div class="block">
            <label for="category-select" class="block text-[11px] font-bold uppercase text-slate-400 tracking-wider mb-2">
              Select Category Dropdown:
            </label>
            <div class="relative">
              <select 
                id="category-select" 
                class="w-full bg-slate-50 border border-slate-300 text-slate-800 text-xs font-bold font-heading rounded-xl p-3 pr-8 uppercase appearance-none cursor-pointer focus:ring-2 focus:ring-[#2B447A] focus:outline-none transition-all"
              >
                <option value="" selected={!currentCategory}>-- All Products --</option>
                {categoryStructure.map(cat => (
                  <optgroup label={cat.title}>
                    <option value={cat.handle} selected={currentCategory === cat.handle}>
                      All {cat.title}
                    </option>
                    {cat.subcategories?.map(sub => (
                      <option value={sub.handle} selected={currentCategory === sub.handle}>
                        -- {sub.title}
                      </option>
                    ))}
                  </optgroup>
                ))}
              </select>
              <ChevronDown class="w-4 h-4 text-slate-500 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" />
            </div>
          </div>

          <!-- Vertical Category Accordion List -->
          <div class="space-y-1 divide-y divide-slate-100 text-xs font-heading select-none pt-2">
            <a 
              href="/shop" 
              class={`block py-2.5 px-2 font-bold uppercase tracking-wider transition-colors rounded-lg ${!currentCategory ? 'text-[#2B447A] font-extrabold bg-blue-50/70' : 'text-slate-700 hover:text-slate-900'}`}
            >
              ALL PRODUCTS
            </a>

            {categoryStructure.map((cat, catIndex) => {
              const hasSubs = cat.subcategories && cat.subcategories.length > 0;
              const isCatActive = currentCategory === cat.handle || cat.subcategories?.some(s => s.handle === currentCategory);

              return (
                <div class="pt-2 pb-1">
                  {hasSubs ? (
                    <div>
                      <button 
                        type="button" 
                        class="w-full flex items-center justify-between py-2 px-2 font-black text-slate-900 uppercase tracking-wider hover:text-[#2B447A] transition-colors cursor-pointer text-left cat-toggle-btn"
                        data-target={`cat-sub-${catIndex}`}
                      >
                        <span class={isCatActive ? 'text-[#2B447A]' : ''}>{cat.title}</span>
                        <span class="text-slate-400 text-sm font-mono font-bold cat-icon">
                          {isCatActive ? '-' : '+'}
                        </span>
                      </button>

                      <div id={`cat-sub-${catIndex}`} class={`pl-3 space-y-1 py-1.5 ${isCatActive ? '' : 'hidden'}`}>
                        {cat.subcategories.map(sub => {
                          const isSubActive = currentCategory === sub.handle;
                          return (
                            <a 
                              href={`/shop?category=${sub.handle}`}
                              class={`block text-[11px] uppercase tracking-wide transition-colors py-1.5 px-2 rounded-md ${isSubActive ? 'text-[#2B447A] font-black bg-blue-50' : 'text-slate-600 hover:text-slate-900 font-semibold'}`}
                            >
                              {sub.title}
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  ) : (
                    <a 
                      href={`/shop?category=${cat.handle}`}
                      class={`block py-2.5 px-2 font-black uppercase tracking-wider transition-colors hover:text-[#2B447A] ${currentCategory === cat.handle ? 'text-[#2B447A] bg-blue-50/70 rounded-lg' : 'text-slate-900'}`}
                    >
                      {cat.title}
                    </a>
                  )}
                </div>
              );
            })}
          </div>

          <!-- Trust Badge -->
          <div class="pt-3 border-t border-slate-100 text-center">
            <div class="inline-flex items-center gap-1.5 text-xs text-slate-500 font-medium">
              <ShieldCheck class="w-4 h-4 text-emerald-500" />
              <span>In-Stock Official Products</span>
            </div>
          </div>

        </aside>

        <!-- RIGHT COLUMN: PRODUCTS GRID (3x3 Grid = 9 items) + COMPACT PAGINATOR -->
        <div class="lg:col-span-9 space-y-6">
          
          <!-- Category Header Bar (Aligned perfectly with Sidebar Header) -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-3 border-b border-slate-100">
            <div>
              <h2 class="font-heading font-black text-xl md:text-2xl text-slate-900 uppercase">
                {activeCategoryTitle}
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">
                Showing {totalProducts === 0 ? 0 : startIndex + 1}-{Math.min(startIndex + ITEMS_PER_PAGE, totalProducts)} of {totalProducts} in-stock items
              </p>
            </div>
          </div>

          <!-- Products Grid (3 Columns, Clean Modern Shop Layout) -->
          {errorMsg ? (
            <div class="bg-red-50 border border-red-200 rounded-2xl p-8 text-center max-w-md mx-auto my-12">
              <p class="text-red-600 font-bold text-sm mb-2">{errorMsg}</p>
            </div>
          ) : paginatedProducts.length === 0 ? (
            <div class="text-center py-20 bg-slate-50 rounded-2xl border border-slate-200 max-w-lg mx-auto">
              <ShoppingBag class="w-12 h-12 text-slate-300 mx-auto mb-3" />
              <h3 class="font-heading font-black text-slate-800 text-lg">No in-stock products in this category</h3>
              <p class="text-slate-500 text-xs mt-1 mb-6">Select another category to view available items.</p>
              <a href="/shop" class="inline-block bg-[#2B447A] text-white font-heading font-bold text-xs uppercase px-6 py-3 rounded-full">
                View All Products
              </a>
            </div>
          ) : (
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
              {paginatedProducts.map((product) => {
                const minPrice = parseFloat(product.priceRange?.minVariantPrice?.amount || '0').toFixed(2);
                const imageUrl = product.featuredImageUrl || '/assets/home/imgi_19_shop.webp';
                const firstVariant = product.variantsList[0];
                const imagesList = product.imagesList || [];

                return (
                  <div 
                    class="product-card flex flex-col bg-white border border-slate-200/80 rounded-2xl p-4 group text-left select-none shadow-2xs hover:shadow-md transition-shadow"
                    data-product-id={product.id}
                    data-variants={JSON.stringify(product.variantsList)}
                  >
                    
                    <!-- Image Container with Hover Zoom & Image Carousel Dots -->
                    <div class="relative w-full aspect-square bg-slate-50 rounded-xl overflow-hidden mb-3 border border-slate-100 group">
                      <a href={`/shop/${product.handle}`} class="block w-full h-full">
                        <img 
                          src={imageUrl} 
                          alt={product.title}
                          class="card-main-image w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          loading="lazy"
                        />
                      </a>

                      <!-- Carousel Dots Indicator (If multiple images) -->
                      {imagesList.length > 1 && (
                        <div class="absolute bottom-2.5 left-0 right-0 flex justify-center gap-1.5 z-10 pointer-events-auto">
                          {imagesList.slice(0, 5).map((img: any, idx: number) => (
                            <button 
                              type="button" 
                              class={`carousel-dot w-2 h-2 rounded-full transition-all cursor-pointer ${idx === 0 ? 'bg-[#2B447A] w-4' : 'bg-slate-300 hover:bg-slate-500'}`}
                              data-img-src={img.url}
                              data-idx={idx}
                              title={`View Image ${idx + 1}`}
                            ></button>
                          ))}
                        </div>
                      )}
                    </div>

                    <!-- Product Title -->
                    <a href={`/shop/${product.handle}`} class="block mb-1">
                      <h3 class="font-heading font-bold text-sm text-[#2B447A] group-hover:text-blue-600 transition-colors line-clamp-2 leading-snug">
                        {product.title}
                      </h3>
                    </a>

                    <!-- Price ($XX.YY USD) -->
                    <div class="mb-3 font-heading font-black text-lg text-slate-900 card-price-display">
                      ${minPrice} <span class="text-xs font-bold text-slate-400">USD</span>
                    </div>

                    <!-- Color Swatches & Size Pills (Interactive Selection) -->
                    <div class="space-y-2 mb-4">
                      
                      <!-- Color Swatches -->
                      {product.colors && product.colors.length > 0 && (
                        <div class="flex items-center flex-wrap gap-1.5">
                          <span class="text-[10px] font-extrabold uppercase text-slate-400 mr-0.5">Color:</span>
                          {product.colors.map((color: any, idx: number) => (
                            <button 
                              type="button"
                              class={`swatch-btn w-5 h-5 rounded-full border border-slate-300 transition-all cursor-pointer ${idx === 0 ? 'ring-2 ring-[#2B447A] ring-offset-1 scale-105' : 'opacity-80 hover:opacity-100 hover:scale-105'}`}
                              style={`background-color: ${color.hex}`}
                              data-color={color.name}
                              data-image={color.imageUrl}
                              title={color.name}
                            ></button>
                          ))}
                        </div>
                      )}

                      <!-- Size Pills -->
                      {product.sizes && product.sizes.length > 0 && (
                        <div class="flex items-center flex-wrap gap-1">
                          <span class="text-[10px] font-extrabold uppercase text-slate-400 mr-0.5">Size:</span>
                          {product.sizes.map((size: string, idx: number) => (
                            <button 
                              type="button"
                              class={`size-btn px-2 py-0.5 rounded-md border text-[10px] font-black uppercase transition-all cursor-pointer ${idx === 0 ? 'bg-[#2B447A] text-white border-[#2B447A]' : 'bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100'}`}
                              data-size={size}
                            >
                              {size}
                            </button>
                          ))}
                        </div>
                      )}

                    </div>

                    <!-- ADD TO CART Pill Button -->
                    <div class="mt-auto pt-2">
                      {firstVariant && (
                        <button 
                          type="button" 
                          class="w-full bg-[#2B447A] hover:bg-[#1F3664] text-white font-heading font-extrabold text-xs uppercase tracking-wider py-3 px-4 rounded-full shadow-md hover:shadow-lg transition-all active:scale-95 cursor-pointer add-to-cart-quick-btn"
                          data-variant-id={firstVariant.id}
                          data-product-id={product.id}
                          data-title={product.title}
                          data-price={firstVariant.price || minPrice}
                          data-image={imageUrl}
                          data-handle={product.handle}
                        >
                          ADD TO CART
                        </button>
                      )}
                    </div>

                  </div>
                );
              })}
            </div>
          )}

          <!-- COMPACT PAGINATOR (9 Items per page - Never Overflows) -->
          {totalPages > 1 && (
            <div class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-slate-100">
              <p class="text-xs font-semibold text-slate-500 font-heading">
                Page <strong class="text-slate-900">{validPage}</strong> of <strong class="text-slate-900">{totalPages}</strong>
              </p>

              <div class="flex items-center gap-1.5 font-heading">
                
                <!-- Previous Button -->
                {validPage > 1 ? (
                  <a 
                    href={`/shop?${currentCategory ? `category=${currentCategory}&` : ''}page=${validPage - 1}`}
                    class="px-3.5 py-2 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 rounded-full font-black text-xs uppercase transition-colors inline-flex items-center gap-1 shadow-2xs"
                  >
                    <ChevronLeft class="w-3.5 h-3.5" /> Prev
                  </a>
                ) : (
                  <span class="px-3.5 py-2 bg-slate-50 text-slate-300 border border-slate-200/60 rounded-full font-black text-xs uppercase cursor-not-allowed inline-flex items-center gap-1">
                    <ChevronLeft class="w-3.5 h-3.5" /> Prev
                  </span>
                )}

                <!-- Truncated Page Numbers -->
                <div class="flex items-center gap-1">
                  {paginationRange.map((pageItem) => {
                    if (pageItem === '...') {
                      return <span class="px-2 text-slate-400 font-bold text-xs">...</span>;
                    }

                    const pageNum = pageItem as number;
                    const isCurrent = pageNum === validPage;
                    return (
                      <a 
                        href={`/shop?${currentCategory ? `category=${currentCategory}&` : ''}page=${pageNum}`}
                        class={`w-8 h-8 rounded-full flex items-center justify-center font-black text-xs transition-all ${
                          isCurrent 
                            ? 'bg-[#2B447A] text-white shadow-md' 
                            : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-100'
                        }`}
                      >
                        {pageNum}
                      </a>
                    );
                  })}
                </div>

                <!-- Next Button -->
                {validPage < totalPages ? (
                  <a 
                    href={`/shop?${currentCategory ? `category=${currentCategory}&` : ''}page=${validPage + 1}`}
                    class="px-3.5 py-2 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 rounded-full font-black text-xs uppercase transition-colors inline-flex items-center gap-1 shadow-2xs"
                  >
                    Next <ChevronRight class="w-3.5 h-3.5" />
                  </a>
                ) : (
                  <span class="px-3.5 py-2 bg-slate-50 text-slate-300 border border-slate-200/60 rounded-full font-black text-xs uppercase cursor-not-allowed inline-flex items-center gap-1">
                    Next <ChevronRight class="w-3.5 h-3.5" />
                  </span>
                )}

              </div>
            </div>
          )}

        </div>

      </div>

    </section>
  </main>

  <Footer />
  <CartDrawer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', initShopPage);
  document.addEventListener('astro:page-load', initShopPage);

  function initShopPage() {
    // 1. Dropdown Category Selector Handler
    const categorySelect = document.getElementById('category-select');
    if (categorySelect) {
      categorySelect.onchange = (e) => {
        const catVal = e.target.value;
        if (catVal) {
          window.location.href = `/shop?category=${catVal}`;
        } else {
          window.location.href = '/shop';
        }
      };
    }

    // 2. Accordion Toggles for Left Sidebar
    document.querySelectorAll('.cat-toggle-btn').forEach(btn => {
      btn.onclick = () => {
        const targetId = btn.getAttribute('data-target');
        const targetEl = document.getElementById(targetId);
        const icon = btn.querySelector('.cat-icon');

        if (targetEl) {
          const isHidden = targetEl.classList.contains('hidden');
          if (isHidden) {
            targetEl.classList.remove('hidden');
            if (icon) icon.textContent = '-';
          } else {
            targetEl.classList.add('hidden');
            if (icon) icon.textContent = '+';
          }
        }
      };
    });

    // 3. Product Card Swatches, Sizes & Carousel Dots Interactive Controller
    document.querySelectorAll('.product-card').forEach(card => {
      const variantsDataRaw = card.getAttribute('data-variants');
      let variants = [];
      try {
        variants = JSON.parse(variantsDataRaw || '[]');
      } catch (e) {
        variants = [];
      }

      const mainImg = card.querySelector('.card-main-image');
      const priceDisplay = card.querySelector('.card-price-display');
      const addToCartBtn = card.querySelector('.add-to-cart-quick-btn');
      
      const swatchBtns = card.querySelectorAll('.swatch-btn');
      const sizeBtns = card.querySelectorAll('.size-btn');
      const carouselDots = card.querySelectorAll('.carousel-dot');

      let selectedColor = swatchBtns.length > 0 ? swatchBtns[0].getAttribute('data-color') : '';
      let selectedSize = sizeBtns.length > 0 ? sizeBtns[0].getAttribute('data-size') : '';

      // Function to match variant based on selectedColor and selectedSize
      function updateCardVariant() {
        if (!variants || variants.length === 0) return;

        let matchedVar = variants.find(v => {
          const matchColor = !selectedColor || (v.optionsObj && v.optionsObj.color === selectedColor);
          const matchSize = !selectedSize || (v.optionsObj && v.optionsObj.size === selectedSize);
          return matchColor && matchSize;
        });

        // Fallback to color match or first variant
        if (!matchedVar && selectedColor) {
          matchedVar = variants.find(v => v.optionsObj && v.optionsObj.color === selectedColor);
        }
        if (!matchedVar) {
          matchedVar = variants[0];
        }

        if (matchedVar) {
          // Update Add To Cart Button Attributes
          if (addToCartBtn) {
            addToCartBtn.setAttribute('data-variant-id', matchedVar.id);
            if (matchedVar.price) addToCartBtn.setAttribute('data-price', matchedVar.price);
            if (matchedVar.imageUrl) addToCartBtn.setAttribute('data-image', matchedVar.imageUrl);
          }

          // Update Price Display
          if (priceDisplay && matchedVar.price) {
            priceDisplay.innerHTML = `$${parseFloat(matchedVar.price).toFixed(2)} <span class="text-xs font-bold text-slate-400">USD</span>`;
          }

          // Update Image if variant has explicit image
          if (mainImg && matchedVar.imageUrl) {
            mainImg.src = matchedVar.imageUrl;
          }
        }
      }

      // Swatch Clicks
      swatchBtns.forEach(btn => {
        btn.onclick = () => {
          swatchBtns.forEach(b => {
            b.classList.remove('ring-2', 'ring-[#2B447A]', 'ring-offset-1', 'scale-105');
            b.classList.add('opacity-80');
          });
          btn.classList.remove('opacity-80');
          btn.classList.add('ring-2', 'ring-[#2B447A]', 'ring-offset-1', 'scale-105');

          selectedColor = btn.getAttribute('data-color') || '';
          const swatchImg = btn.getAttribute('data-image');
          if (mainImg && swatchImg) mainImg.src = swatchImg;

          updateCardVariant();
        };
      });

      // Size Clicks
      sizeBtns.forEach(btn => {
        btn.onclick = () => {
          sizeBtns.forEach(b => {
            b.classList.remove('bg-[#2B447A]', 'text-white', 'border-[#2B447A]');
            b.classList.add('bg-slate-50', 'text-slate-600', 'border-slate-200');
          });
          btn.classList.remove('bg-slate-50', 'text-slate-600', 'border-slate-200');
          btn.classList.add('bg-[#2B447A]', 'text-white', 'border-[#2B447A]');

          selectedSize = btn.getAttribute('data-size') || '';
          updateCardVariant();
        };
      });

      // Carousel Dot Clicks
      carouselDots.forEach(dot => {
        dot.onclick = () => {
          const newSrc = dot.getAttribute('data-img-src');
          if (mainImg && newSrc) {
            mainImg.src = newSrc;
          }
          carouselDots.forEach(d => {
            d.classList.remove('bg-[#2B447A]', 'w-4');
            d.classList.add('bg-slate-300');
          });
          dot.classList.remove('bg-slate-300');
          dot.classList.add('bg-[#2B447A]', 'w-4');
        };
      });

      // Initialize default active variant on load
      updateCardVariant();
    });

    // 4. Quick Add to Cart Button Handlers
    document.querySelectorAll('.add-to-cart-quick-btn').forEach(btn => {
      btn.onclick = () => {
        const variantId = btn.getAttribute('data-variant-id');
        const productId = btn.getAttribute('data-product-id');
        const title = btn.getAttribute('data-title');
        const price = btn.getAttribute('data-price');
        const image = btn.getAttribute('data-image');
        const handle = btn.getAttribute('data-handle');

        if (window.addShopifyItemToCart) {
          window.addShopifyItemToCart({
            variantId,
            productId,
            title,
            price,
            image,
            handle,
            quantity: 1
          });
        }
      };
    });
  }
</script>
