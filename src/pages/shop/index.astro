---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/header/Header.astro';
import Footer from '../../components/common/Footer.astro';
import CartDrawer from '../../components/shop/CartDrawer.astro';
import { getProducts } from '../../lib/shopify';
import { ShoppingBag, Tag, ChevronLeft, ChevronRight, Filter, ShieldCheck, ChevronDown } from '@lucide/astro';

let allProducts: any[] = [];
let errorMsg = '';

try {
  // Fetch all in-stock products with real images
  allProducts = await getProducts(250);
  allProducts = allProducts.filter(p => p && p.inStock && p.hasRealImage);
} catch (e) {
  console.error('Error loading shop data:', e);
  errorMsg = 'Could not load store products from Shopify.';
}

// Category Hierarchy Definition
const categoryStructure = [
  {
    title: 'MEN',
    handle: 'men',
    subcategories: [
      { title: "All Men's", handle: 'men' },
      { title: "Short-Sleeve Tees", handle: 'short-sleeve-tees-men' },
      { title: "Performance Shirts", handle: 'long-sleeve-performance-shirts-men' },
      { title: "Long-Sleeve Tees", handle: 'long-sleeve-tees-men' },
      { title: "Tank Tops & Sleeveless", handle: 'tank-tops-sleeveless-men' },
      { title: "Sweatshirts & Hoodies", handle: 'sweatshirts-hoodies' }
    ]
  },
  {
    title: 'WOMEN',
    handle: 'women',
    subcategories: [
      { title: "All Women's", handle: 'women' },
      { title: "Tank Tops", handle: 'tank-tops-women' },
      { title: "Short-Sleeve Tees", handle: 'short-sleeve-tees-women' },
      { title: "Performance Tees", handle: 'womens-long-sleeve-performance-tees' },
      { title: "Long-Sleeve Tees", handle: 'womens-long-sleeve-tees' },
      { title: "Sweatshirts & Hoodies", handle: 'sweatshirts-hoodies-women' }
    ]
  },
  {
    title: 'KIDS',
    handle: 'youth-kids',
    subcategories: [
      { title: "All Kids", handle: 'youth-kids' },
      { title: "Short-Sleeve Tees", handle: 'short-sleeve-tees-youth-kids' },
      { title: "Performance Shirts", handle: 'youth-kids-long-sleeve-performance-shirts' },
      { title: "Long-Sleeve Tees", handle: 'youth-kids-long-sleeve-tees' }
    ]
  },
  { title: 'TODDLERS', handle: 'toddlers' },
  { title: 'HATS', handle: 'hats-headwear' },
  { title: 'SOUVENIRS', handle: 'gifts-souvenirs' }
];
---

<Layout 
  title="Official Shop | Robbie's of Islamorada"
  description="Shop official Robbie's of Islamorada merchandise, t-shirts, hats, souvenirs, and performance gear."
  image="/assets/home/imgi_19_shop.webp"
>
  <Header />

  <!-- Full Store Dataset for Client-Side Dynamic Hydration -->
  <script id="shop-dataset" type="application/json" set:html={JSON.stringify({ allProducts, categoryStructure })} />

  <main class="flex-1 bg-white min-h-screen border-t border-slate-100">
    
    <!-- Hero Banner -->
    <section class="w-full bg-[#2B447A] text-white py-10 px-6 relative overflow-hidden select-none">
      <div class="max-w-[1240px] mx-auto text-center relative z-10">
        <span class="inline-flex items-center gap-1.5 bg-white/10 text-white/90 text-xs font-bold px-3.5 py-1 rounded-full uppercase tracking-widest mb-3 border border-white/20">
          <Tag class="w-3.5 h-3.5" /> Official Robbie's Store
        </span>
        <h1 class="font-heading font-black text-3xl sm:text-4xl md:text-5xl uppercase tracking-tight mb-2">
          ROBBIE'S OFFICIAL MERCHANDISE
        </h1>
        <p class="font-heading font-normal text-xs sm:text-sm text-white/90 max-w-xl mx-auto">
          Explore our collection of authentic t-shirts, performance wear, hats, plush tarpons, and Key West souvenirs.
        </p>
      </div>
    </section>

    <!-- Main Storefront Section -->
    <section class="max-w-[1280px] mx-auto px-4 sm:px-6 md:px-8 py-10">
      
      <!-- Mobile Categories Toggle Button -->
      <div class="lg:hidden mb-6">
        <button 
          id="mobile-cat-toggle-btn"
          type="button" 
          class="w-full flex items-center justify-between bg-slate-100 hover:bg-slate-200 text-slate-900 font-heading font-black text-xs uppercase tracking-wider px-4 py-3.5 rounded-xl transition-colors cursor-pointer"
        >
          <span class="flex items-center gap-2">
            <Filter class="w-4 h-4 text-[#2B447A]" /> 
            <span id="mobile-cat-current-label">All Categories</span>
          </span>
          <ChevronDown id="mobile-cat-arrow" class="w-4 h-4 text-slate-500 transition-transform duration-300" />
        </button>

        <div id="mobile-cat-drawer" class="hidden mt-2 p-4 bg-white border border-slate-200 rounded-2xl space-y-3 shadow-md">
          <!-- Populated by JS -->
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- LEFT SIDEBAR: DESKTOP CATEGORIES ACCORDION LIST -->
        <aside class="hidden lg:block lg:col-span-3 bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs space-y-6">
          
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="font-heading font-black text-sm uppercase text-slate-900 tracking-wider flex items-center gap-2">
              <Filter class="w-4 h-4 text-[#2B447A]" /> Categories
            </h3>
            <button id="desktop-clear-filter-btn" type="button" class="hidden text-[11px] font-bold text-[#2B55FF] hover:underline cursor-pointer">
              Clear Filter
            </button>
          </div>

          <!-- Vertical Category Accordion List -->
          <div id="desktop-category-accordion" class="space-y-1 divide-y divide-slate-100 text-xs font-heading select-none pt-1">
            <!-- Rendered by JS for exact active state syncing -->
          </div>

          <!-- Trust Badge -->
          <div class="pt-3 border-t border-slate-100 text-center">
            <div class="inline-flex items-center gap-1.5 text-xs text-slate-500 font-medium">
              <ShieldCheck class="w-4 h-4 text-emerald-500" />
              <span>In-Stock Official Products</span>
            </div>
          </div>

        </aside>

        <!-- RIGHT COLUMN: PRODUCTS GRID (3 Columns = 9 items, Borderless Cards) + PAGINATOR -->
        <div class="lg:col-span-9 space-y-6">
          
          <!-- Category Title Header Bar -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-3 border-b border-slate-100">
            <div>
              <h2 id="active-category-header-title" class="font-heading font-black text-xl md:text-2xl text-slate-900 uppercase">
                All Products
              </h2>
              <p id="active-category-product-count" class="text-xs text-slate-500 mt-0.5">
                Loading products...
              </p>
            </div>
          </div>

          <!-- Products Grid Container -->
          {errorMsg ? (
            <div class="bg-red-50 border border-red-200 rounded-2xl p-8 text-center max-w-md mx-auto my-12">
              <p class="text-red-600 font-bold text-sm mb-2">{errorMsg}</p>
            </div>
          ) : (
            <div id="products-grid-container" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 min-h-[400px]">
              <!-- Rendered dynamically by Client JS -->
            </div>
          )}

          <!-- Empty State (Hidden by default) -->
          <div id="empty-state-container" class="hidden text-center py-20 bg-slate-50 rounded-2xl border border-slate-200 max-w-lg mx-auto">
            <ShoppingBag class="w-12 h-12 text-slate-300 mx-auto mb-3" />
            <h3 class="font-heading font-black text-slate-800 text-lg">No in-stock products in this category</h3>
            <p class="text-slate-500 text-xs mt-1 mb-6">Select another category to view available items.</p>
            <button id="empty-reset-btn" type="button" class="inline-block bg-[#2B447A] text-white font-heading font-bold text-xs uppercase px-6 py-3 rounded-full cursor-pointer">
              View All Products
            </button>
          </div>

          <!-- COMPACT PAGINATOR (9 Items per page) -->
          <div id="pagination-wrapper" class="hidden mt-12 pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
            <p id="pagination-info-text" class="text-xs font-semibold text-slate-500 font-heading">
              Page <strong class="text-slate-900">1</strong> of <strong class="text-slate-900">1</strong>
            </p>

            <div id="pagination-controls-container" class="flex items-center gap-1.5 font-heading">
              <!-- Rendered dynamically by Client JS -->
            </div>
          </div>

        </div>

      </div>

    </section>
  </main>

  <Footer />
  <CartDrawer />
</Layout>

<script is:inline>
  (function() {
    let dataset = { allProducts: [], categoryStructure: [] };
    const ITEMS_PER_PAGE = 9;

    let state = {
      category: '',
      page: 1
    };

    function parseUrlState() {
      const urlParams = new URLSearchParams(window.location.search);
      state.category = urlParams.get('category') || '';
      state.page = Math.max(1, parseInt(urlParams.get('page') || '1', 10));
    }

    function updateUrlState(newCategory, newPage, pushHistory = true) {
      state.category = newCategory !== undefined ? newCategory : state.category;
      state.page = newPage !== undefined ? newPage : state.page;

      const params = new URLSearchParams();
      if (state.category) params.set('category', state.category);
      if (state.page > 1) params.set('page', state.page.toString());

      const newRelativePathQuery = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
      if (pushHistory) {
        window.history.pushState(null, '', newRelativePathQuery);
      }

      renderCatalog();
    }

    function getFilteredProducts() {
      if (!state.category) return dataset.allProducts;
      
      const catHandle = state.category.toLowerCase();
      
      return dataset.allProducts.filter(p => {
        if (p.collectionHandles && p.collectionHandles.includes(catHandle)) return true;
        if (p.tags && p.tags.some(t => t.toLowerCase().replace(/\s+/g, '-') === catHandle || t.toLowerCase() === catHandle)) return true;
        if (p.handle && p.handle.includes(catHandle)) return true;
        if (p.productType && p.productType.toLowerCase().replace(/\s+/g, '-').includes(catHandle)) return true;
        return false;
      });
    }

    function getActiveTitle() {
      if (!state.category) return 'All Products';
      let title = state.category.toUpperCase().replace(/-/g, ' ');

      dataset.categoryStructure.forEach(cat => {
        if (cat.handle === state.category) title = cat.title;
        cat.subcategories?.forEach(sub => {
          if (sub.handle === state.category) title = `${cat.title} - ${sub.title}`;
        });
      });

      return title;
    }

    function getPaginationRange(current, total) {
      const delta = 1;
      const range = [];
      const rangeWithDots = [];
      let l;

      for (let i = 1; i <= total; i++) {
        if (i === 1 || i === total || (i >= current - delta && i <= current + delta)) {
          range.push(i);
        }
      }

      for (const i of range) {
        if (l !== undefined) {
          if (i - l === 2) {
            rangeWithDots.push(l + 1);
          } else if (i - l !== 1) {
            rangeWithDots.push('...');
          }
        }
        rangeWithDots.push(i);
        l = i;
      }

      return rangeWithDots;
    }

    function renderCategorySidebar() {
      const desktopAcc = document.getElementById('desktop-category-accordion');
      const desktopClearBtn = document.getElementById('desktop-clear-filter-btn');
      const mobileDrawer = document.getElementById('mobile-cat-drawer');
      const mobileCurrentLabel = document.getElementById('mobile-cat-current-label');

      if (desktopClearBtn) {
        if (state.category) {
          desktopClearBtn.classList.remove('hidden');
          desktopClearBtn.onclick = () => updateUrlState('', 1);
        } else {
          desktopClearBtn.classList.add('hidden');
        }
      }

      if (mobileCurrentLabel) {
        mobileCurrentLabel.textContent = getActiveTitle();
      }

      if (desktopAcc) {
        let html = `
          <a 
            href="/shop" 
            data-cat=""
            class="cat-link block py-2.5 px-2 font-bold uppercase tracking-wider transition-colors rounded-lg ${!state.category ? 'text-[#2B447A] font-extrabold bg-blue-50/70' : 'text-slate-700 hover:text-slate-900'}"
          >
            ALL PRODUCTS
          </a>
        `;

        dataset.categoryStructure.forEach((cat, catIndex) => {
          const hasSubs = cat.subcategories && cat.subcategories.length > 0;
          const isCatActive = state.category === cat.handle || cat.subcategories?.some(s => s.handle === state.category);

          html += `
            <div class="pt-2 pb-1">
              ${hasSubs ? `
                <div>
                  <button 
                    type="button" 
                    class="w-full flex items-center justify-between py-2 px-2 font-black text-slate-900 uppercase tracking-wider hover:text-[#2B447A] transition-colors cursor-pointer text-left cat-toggle-btn"
                    data-target="desktop-cat-sub-${catIndex}"
                  >
                    <span class="${isCatActive ? 'text-[#2B447A]' : ''}">${cat.title}</span>
                    <span class="text-slate-400 text-sm font-mono font-bold cat-icon">${isCatActive ? '-' : '+'}</span>
                  </button>

                  <div id="desktop-cat-sub-${catIndex}" class="pl-3 space-y-1 py-1.5 ${isCatActive ? '' : 'hidden'}">
                    ${cat.subcategories.map(sub => {
                      const isSubActive = state.category === sub.handle;
                      return `
                        <a 
                          href="/shop?category=${sub.handle}"
                          data-cat="${sub.handle}"
                          class="cat-link block text-[11px] uppercase tracking-wide transition-colors py-1.5 px-2 rounded-md ${isSubActive ? 'text-[#2B447A] font-black bg-blue-50' : 'text-slate-600 hover:text-slate-900 font-semibold'}"
                        >
                          ${sub.title}
                        </a>
                      `;
                    }).join('')}
                  </div>
                </div>
              ` : `
                <a 
                  href="/shop?category=${cat.handle}"
                  data-cat="${cat.handle}"
                  class="cat-link block py-2.5 px-2 font-black uppercase tracking-wider transition-colors hover:text-[#2B447A] ${state.category === cat.handle ? 'text-[#2B447A] bg-blue-50/70 rounded-lg' : 'text-slate-900'}"
                >
                  ${cat.title}
                </a>
              `}
            </div>
          `;
        });

        desktopAcc.innerHTML = html;

        desktopAcc.querySelectorAll('.cat-link').forEach(link => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            const catVal = link.getAttribute('data-cat') || '';
            updateUrlState(catVal, 1);
          });
        });

        desktopAcc.querySelectorAll('.cat-toggle-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('data-target');
            const targetEl = document.getElementById(targetId);
            const icon = btn.querySelector('.cat-icon');
            if (targetEl) {
              const isHidden = targetEl.classList.contains('hidden');
              targetEl.classList.toggle('hidden');
              if (icon) icon.textContent = isHidden ? '-' : '+';
            }
          });
        });
      }

      if (mobileDrawer) {
        let mobileHtml = `
          <a 
            href="/shop" 
            data-cat=""
            class="cat-link block py-2 px-3 text-xs font-black uppercase tracking-wider rounded-lg ${!state.category ? 'bg-[#2B447A] text-white' : 'bg-slate-50 text-slate-800'}"
          >
            ALL PRODUCTS
          </a>
        `;

        dataset.categoryStructure.forEach(cat => {
          mobileHtml += `
            <div class="space-y-1">
              <div class="text-[11px] font-black text-slate-400 uppercase tracking-widest pt-2 px-1">${cat.title}</div>
              ${cat.subcategories ? cat.subcategories.map(sub => `
                <a 
                  href="/shop?category=${sub.handle}"
                  data-cat="${sub.handle}"
                  class="cat-link block py-2 px-3 text-xs font-bold uppercase tracking-wider rounded-lg ${state.category === sub.handle ? 'bg-[#2B447A] text-white' : 'bg-slate-50 text-slate-700 hover:bg-slate-100'}"
                >
                  ${sub.title}
                </a>
              `).join('') : `
                <a 
                  href="/shop?category=${cat.handle}"
                  data-cat="${cat.handle}"
                  class="cat-link block py-2 px-3 text-xs font-bold uppercase tracking-wider rounded-lg ${state.category === cat.handle ? 'bg-[#2B447A] text-white' : 'bg-slate-50 text-slate-700 hover:bg-slate-100'}"
                >
                  ${cat.title}
                </a>
              `}
            </div>
          `;
        });

        mobileDrawer.innerHTML = mobileHtml;

        mobileDrawer.querySelectorAll('.cat-link').forEach(link => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            const catVal = link.getAttribute('data-cat') || '';
            mobileDrawer.classList.add('hidden');
            const arrow = document.getElementById('mobile-cat-arrow');
            if (arrow) arrow.style.transform = 'rotate(0deg)';
            updateUrlState(catVal, 1);
          });
        });
      }
    }

    function renderCatalog() {
      const filteredProducts = getFilteredProducts();
      const totalProducts = filteredProducts.length;
      const totalPages = Math.ceil(totalProducts / ITEMS_PER_PAGE) || 1;

      if (state.page > totalPages) state.page = totalPages;

      const startIndex = (state.page - 1) * ITEMS_PER_PAGE;
      const paginatedProducts = filteredProducts.slice(startIndex, startIndex + ITEMS_PER_PAGE);

      // 1. Update Title Header
      const headerTitle = document.getElementById('active-category-header-title');
      const headerCount = document.getElementById('active-category-product-count');
      if (headerTitle) headerTitle.textContent = getActiveTitle();
      if (headerCount) {
        headerCount.textContent = `Showing ${totalProducts === 0 ? 0 : startIndex + 1}-${Math.min(startIndex + ITEMS_PER_PAGE, totalProducts)} of ${totalProducts} in-stock items`;
      }

      // 2. Render Sidebar
      renderCategorySidebar();

      // 3. Render Product Cards Grid
      const gridContainer = document.getElementById('products-grid-container');
      const emptyState = document.getElementById('empty-state-container');

      if (totalProducts === 0) {
        if (gridContainer) gridContainer.classList.add('hidden');
        if (emptyState) emptyState.classList.remove('hidden');
      } else {
        if (emptyState) emptyState.classList.add('hidden');
        if (gridContainer) {
          gridContainer.classList.remove('hidden');

          gridContainer.innerHTML = paginatedProducts.map(product => {
            const minPrice = parseFloat(product.priceRange?.minVariantPrice?.amount || '0').toFixed(2);
            const firstVariant = product.variantsList?.[0];
            const imagesList = product.imagesList && product.imagesList.length > 0 
              ? product.imagesList 
              : [{ url: product.featuredImageUrl, altText: product.title }];

            const initialColor = product.colors?.[0]?.name || '';
            const initialSize = product.sizes?.[0] || '';

            return `
              <div 
                class="product-card flex flex-col bg-white p-3 group text-left select-none rounded-2xl hover:shadow-md transition-shadow"
                data-product-id="${product.id}"
                data-variants='${JSON.stringify(product.variantsList || []).replace(/'/g, "&apos;")}'
                data-images='${JSON.stringify(imagesList).replace(/'/g, "&apos;")}'
              >
                <!-- Image Container with Instant 0ms Fade Stack & Mobile Touch Swipe -->
                <div class="relative w-full aspect-square bg-slate-50 rounded-2xl overflow-hidden mb-3 group/img touch-pan-y">
                  <a href="/shop/${product.handle}" class="block w-full h-full relative">
                    ${imagesList.map((img, idx) => `
                      <img 
                        src="${img.url}" 
                        alt="${product.title}"
                        class="carousel-img absolute inset-0 w-full h-full object-cover transition-opacity duration-150 ease-out ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}"
                        data-idx="${idx}"
                        loading="${idx === 0 ? 'lazy' : 'eager'}"
                      />
                    `).join('')}
                  </a>

                  <!-- Professional Left / Right Arrows -->
                  ${imagesList.length > 1 ? `
                    <button 
                      type="button" 
                      class="carousel-arrow carousel-prev absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white/95 shadow-md text-slate-800 flex items-center justify-center opacity-0 group-hover/img:opacity-100 transition-opacity hover:bg-white hover:scale-110 active:scale-95 cursor-pointer z-20 font-bold text-sm select-none"
                      title="Previous Image"
                    >
                      &#10094;
                    </button>
                    <button 
                      type="button" 
                      class="carousel-arrow carousel-next absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white/95 shadow-md text-slate-800 flex items-center justify-center opacity-0 group-hover/img:opacity-100 transition-opacity hover:bg-white hover:scale-110 active:scale-95 cursor-pointer z-20 font-bold text-sm select-none"
                      title="Next Image"
                    >
                      &#10095;
                    </button>
                  ` : ''}

                  <!-- Dots Indicator -->
                  ${imagesList.length > 1 ? `
                    <div class="carousel-dots-container absolute bottom-2.5 left-0 right-0 flex justify-center gap-1.5 z-20 pointer-events-auto">
                      ${imagesList.slice(0, 5).map((img, idx) => `
                        <button 
                          type="button" 
                          class="carousel-dot w-2 h-2 rounded-full transition-all cursor-pointer ${idx === 0 ? 'bg-[#2B447A] w-4' : 'bg-slate-300 hover:bg-slate-500'}"
                          data-img-src="${img.url}"
                          data-idx="${idx}"
                        ></button>
                      `).join('')}
                    </div>
                  ` : ''}
                </div>

                <!-- Product Title -->
                <a href="/shop/${product.handle}" class="block mb-1">
                  <h3 class="font-heading font-bold text-sm text-[#2B447A] group-hover:text-blue-600 transition-colors line-clamp-2 leading-snug">
                    ${product.title}
                  </h3>
                </a>

                <!-- Price -->
                <div class="mb-3 font-heading font-black text-lg text-slate-900 card-price-display">
                  $${minPrice} <span class="text-xs font-bold text-slate-400">USD</span>
                </div>

                <!-- Attributes Section (Compact & Circular) -->
                <div class="space-y-2.5 mb-4 text-left">
                  
                  <!-- Color Attribute -->
                  ${product.colors && product.colors.length > 0 ? `
                    <div class="space-y-1">
                      <div class="text-[10px] font-extrabold uppercase text-slate-400 tracking-wider">
                        COLOR: <span class="color-selected-label text-slate-700 font-bold">${initialColor}</span>
                      </div>
                      <div class="flex items-center flex-wrap gap-1.5">
                        ${product.colors.map((color, idx) => `
                          <button 
                            type="button"
                            class="swatch-btn w-4.5 h-4.5 rounded-full border border-slate-300 transition-all cursor-pointer ${idx === 0 ? 'ring-2 ring-[#2B447A] ring-offset-1 scale-110' : 'opacity-70 hover:opacity-100 hover:scale-110'}"
                            style="background-color: ${color.hex}"
                            data-color="${color.name}"
                            data-image="${color.imageUrl || ''}"
                            title="${color.name}"
                          ></button>
                        `).join('')}
                      </div>
                    </div>
                  ` : ''}

                  <!-- Size Attribute -->
                  ${product.sizes && product.sizes.length > 0 ? `
                    <div class="space-y-1">
                      <div class="text-[10px] font-extrabold uppercase text-slate-400 tracking-wider">
                        SIZE: <span class="size-selected-label text-slate-700 font-bold">${initialSize}</span>
                      </div>
                      <div class="flex items-center flex-wrap gap-1">
                        ${product.sizes.map((size, idx) => `
                          <button 
                            type="button"
                            class="size-btn px-2 py-0.5 rounded-md border text-[10px] font-black uppercase transition-all cursor-pointer ${idx === 0 ? 'bg-[#2B447A] text-white border-[#2B447A]' : 'bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100'}"
                            data-size="${size}"
                          >
                            ${size}
                          </button>
                        `).join('')}
                      </div>
                    </div>
                  ` : ''}

                </div>

                <!-- ADD TO CART Button -->
                <div class="mt-auto pt-1">
                  <button 
                    type="button" 
                    class="add-to-cart-quick-btn w-full bg-[#2B447A] hover:bg-[#1F3664] text-white font-heading font-extrabold text-xs uppercase tracking-wider py-3 px-4 rounded-full shadow-md hover:shadow-lg transition-all active:scale-95 cursor-pointer"
                    data-variant-id="${firstVariant?.id || ''}"
                    data-product-id="${product.id}"
                    data-title="${product.title}"
                    data-price="${firstVariant?.price || minPrice}"
                    data-image="${product.featuredImageUrl}"
                    data-handle="${product.handle}"
                  >
                    ADD TO CART
                  </button>
                </div>

              </div>
            `;
          }).join('');

          bindProductCardEvents();
        }
      }

      // 4. Render Paginator
      renderPagination(totalPages);
    }

    function bindProductCardEvents() {
      document.querySelectorAll('.product-card').forEach(card => {
        let variants = [];
        let images = [];
        try {
          variants = JSON.parse(card.getAttribute('data-variants') || '[]');
          images = JSON.parse(card.getAttribute('data-images') || '[]');
        } catch(e) {}

        const carouselImgs = card.querySelectorAll('.carousel-img');
        const priceDisplay = card.querySelector('.card-price-display');
        const addToCartBtn = card.querySelector('.add-to-cart-quick-btn');

        const colorLabel = card.querySelector('.color-selected-label');
        const sizeLabel = card.querySelector('.size-selected-label');

        const swatchBtns = card.querySelectorAll('.swatch-btn');
        const sizeBtns = card.querySelectorAll('.size-btn');
        
        const prevArrow = card.querySelector('.carousel-prev');
        const nextArrow = card.querySelector('.carousel-next');
        const dots = card.querySelectorAll('.carousel-dot');

        let selectedColor = swatchBtns.length > 0 ? swatchBtns[0].getAttribute('data-color') : '';
        let selectedSize = sizeBtns.length > 0 ? sizeBtns[0].getAttribute('data-size') : '';
        let currentImgIdx = 0;

        // Instant 0ms Image Index Switcher (Opacity Fade)
        function setImageIndex(idx) {
          if (!images || images.length === 0) return;
          if (idx < 0) idx = images.length - 1;
          if (idx >= images.length) idx = 0;
          currentImgIdx = idx;

          carouselImgs.forEach((img, i) => {
            if (i === currentImgIdx) {
              img.classList.remove('opacity-0', 'z-0');
              img.classList.add('opacity-100', 'z-10');
            } else {
              img.classList.remove('opacity-100', 'z-10');
              img.classList.add('opacity-0', 'z-0');
            }
          });

          dots.forEach((dot, dIdx) => {
            if (dIdx === currentImgIdx) {
              dot.classList.remove('bg-slate-300');
              dot.classList.add('bg-[#2B447A]', 'w-4');
            } else {
              dot.classList.remove('bg-[#2B447A]', 'w-4');
              dot.classList.add('bg-slate-300');
            }
          });
        }

        // Swatches Click
        swatchBtns.forEach(btn => {
          btn.onclick = () => {
            swatchBtns.forEach(b => {
              b.classList.remove('ring-2', 'ring-[#2B447A]', 'ring-offset-1', 'scale-110');
              b.classList.add('opacity-70');
            });
            btn.classList.remove('opacity-70');
            btn.classList.add('ring-2', 'ring-[#2B447A]', 'ring-offset-1', 'scale-110');

            selectedColor = btn.getAttribute('data-color') || '';
            if (colorLabel) colorLabel.textContent = selectedColor;

            const swatchImg = btn.getAttribute('data-image');
            if (swatchImg && images.length > 0) {
              const matchedImgIdx = images.findIndex(img => img.url === swatchImg);
              if (matchedImgIdx >= 0) setImageIndex(matchedImgIdx);
            }

            updateCardVariant();
          };
        });

        // Size Click
        sizeBtns.forEach(btn => {
          btn.onclick = () => {
            sizeBtns.forEach(b => {
              b.classList.remove('bg-[#2B447A]', 'text-white', 'border-[#2B447A]');
              b.classList.add('bg-slate-50', 'text-slate-600', 'border-slate-200');
            });
            btn.classList.remove('bg-slate-50', 'text-slate-600', 'border-slate-200');
            btn.classList.add('bg-[#2B447A]', 'text-white', 'border-[#2B447A]');

            selectedSize = btn.getAttribute('data-size') || '';
            if (sizeLabel) sizeLabel.textContent = selectedSize;

            updateCardVariant();
          };
        });

        function updateCardVariant() {
          if (!variants || variants.length === 0) return;

          let matchedVar = variants.find(v => {
            const matchColor = !selectedColor || (v.optionsObj && v.optionsObj.color === selectedColor);
            const matchSize = !selectedSize || (v.optionsObj && v.optionsObj.size === selectedSize);
            return matchColor && matchSize;
          });

          if (!matchedVar && selectedColor) {
            matchedVar = variants.find(v => v.optionsObj && v.optionsObj.color === selectedColor);
          }
          if (!matchedVar) matchedVar = variants[0];

          if (matchedVar) {
            if (addToCartBtn) {
              addToCartBtn.setAttribute('data-variant-id', matchedVar.id);
              if (matchedVar.price) addToCartBtn.setAttribute('data-price', matchedVar.price);
              if (matchedVar.imageUrl) addToCartBtn.setAttribute('data-image', matchedVar.imageUrl);

              let vTitle = matchedVar.title && matchedVar.title !== 'Default Title' ? matchedVar.title : '';
              if (selectedColor && selectedSize) {
                vTitle = `Color: ${selectedColor} / Size: ${selectedSize}`;
              } else if (selectedSize) {
                vTitle = `Size: ${selectedSize}`;
              } else if (selectedColor) {
                vTitle = `Color: ${selectedColor}`;
              }
              addToCartBtn.setAttribute('data-variant-title', vTitle);
            }
            if (priceDisplay && matchedVar.price) {
              priceDisplay.innerHTML = `$${parseFloat(matchedVar.price).toFixed(2)} <span class="text-xs font-bold text-slate-400">USD</span>`;
            }
          }
        }

        // Carousel Arrows (Instant transition)
        if (prevArrow) {
          prevArrow.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();
            setImageIndex(currentImgIdx - 1);
          };
        }
        if (nextArrow) {
          nextArrow.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();
            setImageIndex(currentImgIdx + 1);
          };
        }

        // Carousel Dots
        dots.forEach(dot => {
          dot.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();
            const idx = parseInt(dot.getAttribute('data-idx') || '0', 10);
            setImageIndex(idx);
          };
        });

        // Mobile Touch Swipe Support
        const imgContainer = card.querySelector('.group\\/img');
        if (imgContainer) {
          let touchStartX = 0;
          let touchEndX = 0;

          imgContainer.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
          }, { passive: true });

          imgContainer.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            const diff = touchStartX - touchEndX;
            if (Math.abs(diff) > 25) {
              if (diff > 0) {
                setImageIndex(currentImgIdx + 1);
              } else {
                setImageIndex(currentImgIdx - 1);
              }
            }
          }, { passive: true });
        }

        // Quick Add to Cart
        if (addToCartBtn) {
          addToCartBtn.onclick = () => {
            const variantId = addToCartBtn.getAttribute('data-variant-id');
            const productId = addToCartBtn.getAttribute('data-product-id');
            const title = addToCartBtn.getAttribute('data-title');
            const variantTitle = addToCartBtn.getAttribute('data-variant-title') || '';
            const price = addToCartBtn.getAttribute('data-price');
            const image = addToCartBtn.getAttribute('data-image');
            const handle = addToCartBtn.getAttribute('data-handle');

            if (window.addShopifyItemToCart) {
              window.addShopifyItemToCart({
                variantId,
                productId,
                title,
                variantTitle,
                price,
                image,
                handle,
                quantity: 1
              });
            }
          };
        }

      });
    }

    function renderPagination(totalPages) {
      const wrapper = document.getElementById('pagination-wrapper');
      const infoText = document.getElementById('pagination-info-text');
      const container = document.getElementById('pagination-controls-container');

      if (!wrapper || !container || totalPages <= 1) {
        if (wrapper) wrapper.classList.add('hidden');
        return;
      }

      wrapper.classList.remove('hidden');

      if (infoText) {
        infoText.innerHTML = `Page <strong class="text-slate-900">${state.page}</strong> of <strong class="text-slate-900">${totalPages}</strong>`;
      }

      const range = getPaginationRange(state.page, totalPages);

      let html = '';

      if (state.page > 1) {
        html += `
          <button 
            type="button" 
            data-page="${state.page - 1}"
            class="page-btn px-3.5 py-2 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 rounded-full font-black text-xs uppercase transition-colors inline-flex items-center gap-1 shadow-2xs cursor-pointer"
          >
            &#10094; Prev
          </button>
        `;
      } else {
        html += `
          <span class="px-3.5 py-2 bg-slate-50 text-slate-300 border border-slate-200/60 rounded-full font-black text-xs uppercase cursor-not-allowed inline-flex items-center gap-1">
            &#10094; Prev
          </span>
        `;
      }

      range.forEach(item => {
        if (item === '...') {
          html += `<span class="px-2 text-slate-400 font-bold text-xs">...</span>`;
        } else {
          const isCurrent = item === state.page;
          html += `
            <button 
              type="button" 
              data-page="${item}"
              class="page-btn w-8 h-8 rounded-full flex items-center justify-center font-black text-xs transition-all cursor-pointer ${
                isCurrent 
                  ? 'bg-[#2B447A] text-white shadow-md' 
                  : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-100'
              }"
            >
              ${item}
            </button>
          `;
        }
      });

      if (state.page < totalPages) {
        html += `
          <button 
            type="button" 
            data-page="${state.page + 1}"
            class="page-btn px-3.5 py-2 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 rounded-full font-black text-xs uppercase transition-colors inline-flex items-center gap-1 shadow-2xs cursor-pointer"
          >
            Next &#10095;
          </button>
        `;
      } else {
        html += `
          <span class="px-3.5 py-2 bg-slate-50 text-slate-300 border border-slate-200/60 rounded-full font-black text-xs uppercase cursor-not-allowed inline-flex items-center gap-1">
            Next &#10095;
          </span>
        `;
      }

      container.innerHTML = html;

      container.querySelectorAll('.page-btn').forEach(btn => {
        btn.onclick = () => {
          const targetPage = parseInt(btn.getAttribute('data-page') || '1', 10);
          updateUrlState(undefined, targetPage);
          window.scrollTo({ top: 350, behavior: 'smooth' });
        };
      });
    }

    function initPage() {
      const scriptEl = document.getElementById('shop-dataset');
      if (scriptEl) {
        try {
          dataset = JSON.parse(scriptEl.textContent || '{}');
        } catch (e) {
          console.error('Failed to parse shop dataset:', e);
        }
      }

      parseUrlState();
      renderCatalog();

      const mobileToggleBtn = document.getElementById('mobile-cat-toggle-btn');
      const mobileDrawer = document.getElementById('mobile-cat-drawer');
      const mobileArrow = document.getElementById('mobile-cat-arrow');

      if (mobileToggleBtn && mobileDrawer) {
        mobileToggleBtn.onclick = () => {
          const isHidden = mobileDrawer.classList.contains('hidden');
          if (isHidden) {
            mobileDrawer.classList.remove('hidden');
            if (mobileArrow) mobileArrow.style.transform = 'rotate(180deg)';
          } else {
            mobileDrawer.classList.add('hidden');
            if (mobileArrow) mobileArrow.style.transform = 'rotate(0deg)';
          }
        };
      }

      const emptyResetBtn = document.getElementById('empty-reset-btn');
      if (emptyResetBtn) {
        emptyResetBtn.onclick = () => updateUrlState('', 1);
      }

      window.onpopstate = () => {
        parseUrlState();
        renderCatalog();
      };
    }

    document.addEventListener('DOMContentLoaded', initPage);
    document.addEventListener('astro:page-load', initPage);
  })();
</script>
