---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/common/Footer.astro';
import { ChevronRight, Clock, Moon, Utensils, Anchor, Waves, Eye, Calendar } from '@lucide/astro';

const operationHours = [
  { name: "Robbie's of Islamorada", hours: "Mon-Sun: 7:00am – 5:30pm" },
  { name: "Hungry Tarpon Restaurant", hours: "Mon-Sun: 6:30am – 9:00pm" },
  { name: "Tarpon Booth", hours: "Mon-Sun: 7:00am – 5:00pm" },
  { name: "Captain Michael Fishing", hours: "Mon-Sun: 7:00am – 5:00pm" }
];

const eveningCards = [
  {
    title: "SUNSET CRUISES",
    image: "/assets/home/imgi_197_BEST-SUNSET-CRUISES-IN-THE-FLORIDA-KEYS.webp",
    url: "/#sunset-cruises"
  },
  {
    title: "TARPON FEEDING",
    image: "/assets/home/imgi_18_feed-tarpon.webp",
    url: "/tarpon"
  },
  {
    title: "CAPTAIN MICHAEL PARTYBOAT",
    image: "/assets/home/imgi_195_CAPTAIN-MICHAEL-PARTYBOAT-FISHING.webp",
    url: "/#party-boat"
  }
];
---

<Layout 
  title="Evening Activities in Islamorada | Robbie's of Islamorada"
  description="Discover the best nightlife and evening activities in Islamorada at Robbie's Marina! Sunset cruises, night glass bottom boat tours, waterfront dinner, and night fishing."
  image="/assets/home/imgi_197_BEST-SUNSET-CRUISES-IN-THE-FLORIDA-KEYS.webp"
  schemaType="TouristAttraction"
>
  <Header />

  <main class="flex-1 bg-slate-50 font-sans selection:bg-robbies-ocean selection:text-white">
    
    <!-- 1. HERO BANNER -->
    <section class="relative bg-[#0F172A] text-white py-24 sm:py-32 lg:py-40 px-4 overflow-hidden border-b border-blue-900/40">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/home/imgi_197_BEST-SUNSET-CRUISES-IN-THE-FLORIDA-KEYS.webp" 
          alt="Evening Activities in Islamorada Florida Keys" 
          class="w-full h-full object-cover object-center opacity-40 mix-blend-overlay scale-105 transform"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0F172A] via-[#0F172A]/60 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1280px] mx-auto text-center space-y-4">
        <div class="inline-flex items-center gap-2 bg-indigo-500/20 backdrop-blur-md border border-indigo-300/30 rounded-full px-4 py-1.5 text-xs sm:text-sm font-heading font-extrabold uppercase tracking-widest text-indigo-200 shadow-sm">
          <Moon class="w-4 h-4 text-indigo-300" /> NIGHTLIFE & SUNSET EXPERIENCES
        </div>

        <h1 class="font-heading font-black text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white drop-shadow-lg leading-tight max-w-4xl mx-auto">
          EVENING ACTIVITIES IN ISLAMORADA
        </h1>

        <!-- Breadcrumbs -->
        <div class="pt-4 flex items-center justify-center gap-2 text-xs text-white/80 font-medium tracking-wider uppercase">
          <a href="/" class="hover:text-blue-200 transition-colors">Home</a>
          <ChevronRight class="w-3.5 h-3.5 text-blue-300" />
          <a href="/activities" class="hover:text-blue-200 transition-colors">Activities</a>
          <ChevronRight class="w-3.5 h-3.5 text-blue-300" />
          <span class="text-white font-bold">Evening Activities</span>
        </div>
      </div>
    </section>

    <!-- 2. INTRO SECTION: BEST THINGS TO DO AT NIGHT TIME -->
    <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1000px] mx-auto text-center space-y-5">
      <h2 class="font-heading font-black text-xl sm:text-2xl lg:text-3xl text-[#182A4D] uppercase tracking-wide leading-snug">
        BEST THINGS TO DO IN ISLAMORADA AT NIGHT TIME
      </h2>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-body max-w-3xl mx-auto">
        Looking for ways to extend your day into night? After an exciting day of adventures in Islamorada, it's time to unwind and embrace the vibrant nightlife with some amazing evening activities. Discover where to enjoy a delightful dinner or drinks, and make sure to visit Hungry Tarpon Restaurant for a memorable evening meal by the water's edge, soaking in the captivating atmosphere of the Keys after dark.
      </p>
      <div>
        <a 
          href="/" 
          class="inline-flex items-center gap-2 bg-[#2B447A] hover:bg-[#182A4D] text-white font-heading font-black uppercase rounded-full px-8 py-3.5 text-xs sm:text-sm tracking-wider shadow-md hover:shadow-xl transition-all"
        >
          HUNGRY TARPON RESTAURANT <ChevronRight class="w-4 h-4" />
        </a>
      </div>
    </section>

    <!-- 3. OPERATION HOURS AT ROBBIE'S -->
    <section class="py-6 sm:py-10 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center bg-white rounded-3xl p-6 sm:p-10 shadow-xl border border-slate-100">
        <!-- Night Boat Image -->
        <div class="relative group rounded-2xl overflow-hidden shadow-lg aspect-[16/10]">
          <img 
            src="/assets/home/imgi_195_CAPTAIN-MICHAEL-PARTYBOAT-FISHING.webp" 
            alt="Robbie's Marina Night Tour" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            loading="lazy"
          />
        </div>

        <!-- Hours List & Quadrants -->
        <div class="space-y-6">
          <h3 class="font-heading font-black text-2xl sm:text-3xl text-[#182A4D] uppercase tracking-wide">
            OPERATION HOURS AT ROBBIE'S
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {operationHours.map((item) => (
              <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-1.5 shadow-sm hover:border-blue-300 transition-colors">
                <div class="flex items-center gap-2 text-[#2B447A] font-heading font-bold text-xs uppercase">
                  <Clock class="w-4 h-4 text-blue-600 flex-shrink-0" />
                  <span>{item.name}</span>
                </div>
                <p class="text-slate-700 font-semibold text-xs pl-6">{item.hours}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. DINNER TIME! (HUNGRY TARPON RESTAURANT) -->
    <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center bg-white rounded-3xl p-6 sm:p-10 shadow-xl border border-slate-100">
        <div class="space-y-5">
          <div class="space-y-1">
            <span class="text-[#2B447A] font-heading font-extrabold text-xs tracking-widest uppercase block">
              HUNGRY TARPON RESTAURANT
            </span>
            <h3 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#182A4D] uppercase tracking-wide leading-tight">
              DINNER TIME!
            </h3>
          </div>

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-body">
            After a thrilling day exploring Islamorada's coastline, treat yourself to a delightful dinner at Hungry Tarpon Restaurant, located in the heart of Islamorada. Our restaurant offers a welcoming atmosphere and a menu filled with fresh seafood and local flavors. Whether you're craving signature cocktails, fresh local catch, or decadent Key Lime pie, Hungry Tarpon is the perfect way to cap off your night in paradise.
          </p>

          <div>
            <a 
              href="/" 
              class="inline-flex items-center gap-2 bg-[#2B447A] hover:bg-[#182A4D] text-white font-heading font-black uppercase rounded-full px-8 py-3.5 text-xs sm:text-sm tracking-wider shadow-md hover:shadow-xl transition-all"
            >
              RESERVE A TABLE <ChevronRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <div class="relative group rounded-2xl overflow-hidden shadow-lg aspect-[4/3]">
          <img 
            src="/assets/home/imgi_17_Hungry-tarpon1.webp" 
            alt="Dinner at Hungry Tarpon Restaurant Islamorada" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- 5. GLASSBOTTOM BOAT TOURS: ISLAMORADA NIGHT TOUR -->
    <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center bg-white rounded-3xl p-6 sm:p-10 shadow-xl border border-slate-100">
        <!-- Glowing Underwater Glass Bottom Image -->
        <div class="relative group rounded-2xl overflow-hidden shadow-lg aspect-[4/3]">
          <img 
            src="/assets/home/imgi_132_glass-700x707.webp" 
            alt="Glass Bottom Boat Night Tour in Islamorada" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            loading="lazy"
          />
          <div class="absolute top-4 left-4 bg-indigo-600 text-white text-xs font-heading font-black uppercase px-3.5 py-1.5 rounded-full shadow-md">
            Illuminated Night Reef
          </div>
        </div>

        <!-- Description & Booking -->
        <div class="space-y-5">
          <div class="space-y-1">
            <h3 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#182A4D] uppercase tracking-wide leading-tight">
              GLASSBOTTOM BOAT TOURS
            </h3>
            <span class="text-indigo-600 font-heading font-extrabold text-sm tracking-widest uppercase block">
              Islamorada Night Tour
            </span>
          </div>

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-body">
            Embark on an extraordinary adventure with Islamorada's exclusive Glassbottom Boat Tour at Night. Experience the enchanting underwater world after dark, illuminated by high-powered underwater lights that showcase the vibrant nightlife of marine creatures. After your tour, join us at Hungry Tarpon Restaurant for a delightful dinner, where you can share tales of your underwater discoveries over delicious cuisine and relaxed surroundings.
          </p>

          <div>
            <a 
              href="/#glass-bottom" 
              class="inline-flex items-center gap-2 bg-[#2B447A] hover:bg-[#182A4D] text-white font-heading font-black uppercase rounded-full px-8 py-3.5 text-xs sm:text-sm tracking-wider shadow-md hover:shadow-xl transition-all"
            >
              BOOK NOW <ChevronRight class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. ISLAMORADA EVENING ACTIVITIES (3 CARDS OVERLAY) -->
    <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto space-y-8">
      <h2 class="text-center font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#182A4D] uppercase tracking-wide">
        ISLAMORADA EVENING ACTIVITIES
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {eveningCards.map((card) => (
          <a 
            href={card.url}
            class="group relative rounded-3xl overflow-hidden shadow-xl aspect-[3/4] block transform hover:-translate-y-1.5 transition-all duration-300"
          >
            <img 
              src={card.image} 
              alt={card.title} 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/30 to-transparent flex items-center justify-center p-6 text-center">
              <h3 class="font-heading font-black text-xl sm:text-2xl text-white uppercase tracking-widest drop-shadow-md group-hover:text-blue-300 transition-colors">
                {card.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 7. TWILIGHT CTA BANNER -->
    <section class="relative bg-[#0284C7] text-white py-16 sm:py-20 px-4 text-center overflow-hidden">
      <div class="relative z-10 max-w-3xl mx-auto space-y-6">
        <p class="text-white/95 text-sm sm:text-base md:text-lg leading-relaxed font-body drop-shadow-sm font-medium">
          Experience the magic of twilight in Islamorada with these evening activities. Whether you're casting your line at Robbie's Marina, exploring local trails, or diving into the turquoise waters, there's something for everyone to enjoy at the end of the day.
        </p>

        <div>
          <a 
            href="/" 
            class="inline-flex items-center gap-2 bg-[#182A4D] hover:bg-white hover:text-[#182A4D] text-white font-heading font-black uppercase rounded-full px-10 py-4 text-xs sm:text-sm tracking-wider shadow-xl transition-all transform hover:-translate-y-0.5"
          >
            RESERVE A TABLE <ChevronRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
