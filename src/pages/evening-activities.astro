---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/common/Footer.astro';
import { Calendar } from '@lucide/astro';

const operationHours = [
  { name: "Robbie's Of Islamorada", hours: "Mon-Sun: 7:00am - 9:00pm" },
  { name: "Hungry Tarpon Restaurant", hours: "Mon-Sun: 6:30am - 9:00pm" },
  { name: "Tarpon Booth", hours: "Mon-Sun: 7:00am - 9:00pm" },
  { name: "Captain Michael Fishing", hours: "Mon-Sun: 7:00am - 8:00pm" }
];

const eveningCards = [
  {
    title: "SUNSET CRUISES",
    image: "/assets/evening-activities/imgi_72_8d1cd71124e974bd0b8b6d931ae3dad2.Sunset-Cruises.webp",
    url: "/#sunset-cruises"
  },
  {
    title: "TARPON FEEDING",
    image: "/assets/evening-activities/imgi_71_1dee52fc8dbeacddb31b08fe7811c70a.Tarpon-Feeding-1.webp",
    url: "/tarpon"
  },
  {
    title: "CAPTAIN MICHAEL PARTYBOAT",
    image: "/assets/evening-activities/imgi_70_3718e0069e9477f681c77a94a5f8e0b1.Captain-Michael-Partyboat.webp",
    url: "/#party-boat"
  }
];
---

<Layout 
  title="Evening Activities in Islamorada | Robbie's of Islamorada"
  description="Discover the best nightlife and evening activities in Islamorada at Robbie's Marina! Sunset cruises, night glass bottom boat tours, waterfront dinner, and night fishing."
  image="/assets/evening-activities/imgi_39_80f0654c3f51052d624e73ac249cc232.Calling-All-Night-Owls-scaled.webp"
  schemaType="TouristAttraction"
>
  <Header />

  <main class="flex-1 bg-white font-sans selection:bg-robbies-ocean selection:text-white w-full">
    
    <!-- 1. HERO BANNER - UNTINTED PHOTO, CENTERED TEXT -->
    <section class="relative text-white py-20 sm:py-28 lg:py-36 px-4 overflow-hidden w-full min-h-[380px] sm:min-h-[460px] flex items-center justify-center">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/evening-activities/imgi_39_80f0654c3f51052d624e73ac249cc232.Calling-All-Night-Owls-scaled.webp" 
          alt="Evening Activities in Islamorada Florida Keys" 
          class="w-full h-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="relative z-10 max-w-[1280px] w-full mx-auto text-center space-y-3">
        <h1 class="font-heading font-black text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white drop-shadow-[0_2px_6px_rgba(0,0,0,0.7)] leading-[1.1] max-w-4xl mx-auto">
          EVENING ACTIVITIES IN ISLAMORADA
        </h1>
      </div>
    </section>

    <!-- 2. INTRO SECTION -->
    <section class="w-full bg-[#f4f5f7] py-10 sm:py-14 px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-[1100px] mx-auto space-y-4">
        <h2 class="font-heading font-black text-xl sm:text-2xl lg:text-3xl text-[#37467a] uppercase tracking-wide leading-snug">
          BEST THINGS TO DO IN ISLAMORADA AT NIGHT TIME
        </h2>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body max-w-3xl mx-auto">
          Looking for what to do in Islamorada at night? After a thrilling day of adventures in Islamorada, it's time to unwind and embrace the vibrant nightlife with some amazing evening activities. Discover where to enjoy a delightful dinner or drinks, and make sure to visit Hungry Tarpon Restaurant for a memorable evening meal by the water's edge, soaking in the captivating atmosphere of the Keys after dark.
        </p>
        <div class="pt-2">
          <a 
            href="/" 
            class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-3 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
          >
            HUNGRY TARPON RESTAURANT
          </a>
        </div>
      </div>
    </section>

    <!-- 3. OPERATION HOURS AT ROBBIE'S - FULL WIDTH 50/50 -->
    <section class="w-full bg-white">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
        <div class="w-full h-full min-h-[280px] sm:min-h-[340px] lg:min-h-[380px]">
          <img 
            src="/assets/evening-activities/imgi_40_night-hours.webp" 
            alt="Robbie's Marina Night Tour" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

        <div class="p-8 sm:p-12 lg:p-16 flex flex-col justify-center items-start space-y-6 bg-white">
          <h3 class="font-heading font-black text-2xl sm:text-3xl text-[#37467a] uppercase tracking-wide">
            OPERATION HOURS AT ROBBIE'S
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 w-full">
            {operationHours.map((item) => (
              <div class="space-y-1">
                <div class="flex items-center gap-2 text-[#37467a] font-heading font-bold text-xs sm:text-sm uppercase">
                  <Calendar class="w-4 h-4 text-[#37467a] flex-shrink-0" />
                  <span>{item.name}</span>
                </div>
                <p class="text-slate-500 text-xs pl-6 font-medium">{item.hours}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. DINNER TIME! (HUNGRY TARPON RESTAURANT) - FULL WIDTH 50/50 -->
    <section class="w-full bg-white">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
        <div class="p-8 sm:p-12 lg:p-16 flex flex-col justify-center items-start space-y-4 bg-white order-2 lg:order-1">
          <div class="space-y-1">
            <h3 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide leading-tight">
              DINNER TIME!
            </h3>
            <span class="text-[#37467a] font-heading font-extrabold text-xs sm:text-sm tracking-widest block">
              Hungry Tarpon Restaurant
            </span>
          </div>

          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body max-w-xl">
            After a thrilling evening exploring Islamorada's nightlife, treat yourself to a delightful dinner at Hungry Tarpon Restaurant. Nestled in the heart of this vibrant Keys community, our restaurant offers a welcoming ambiance and a menu filled with fresh seafood and local flavors. Whether you're craving a juicy steak or our signature Key Lime Pie, dining at Hungry Tarpon is the perfect way to cap off your night in paradise. Join us and unwind with great food and good company, just moments away from the action.
          </p>

          <div class="pt-2">
            <a 
              href="/" 
              class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-3 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
            >
              RESERVE A TABLE
            </a>
          </div>
        </div>

        <div class="w-full h-full min-h-[280px] sm:min-h-[340px] lg:min-h-[380px] order-1 lg:order-2">
          <img 
            src="/assets/evening-activities/imgi_45_Dinner-Time.webp" 
            alt="Dinner at Hungry Tarpon Restaurant Islamorada" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- 5. GLASSBOTTOM BOAT TOURS - FULL WIDTH 50/50 -->
    <section class="w-full bg-white">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
        <div class="w-full h-full min-h-[280px] sm:min-h-[340px] lg:min-h-[380px]">
          <img 
            src="/assets/evening-activities/imgi_50_Glassbottom-Boat-Tours.webp" 
            alt="Glass Bottom Boat Night Tour in Islamorada" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

        <div class="p-8 sm:p-12 lg:p-16 flex flex-col justify-center items-start space-y-4 bg-white">
          <div class="space-y-1">
            <h3 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide leading-tight">
              GLASSBOTTOM BOAT TOURS
            </h3>
            <span class="text-[#37467a] font-heading font-extrabold text-xs sm:text-sm tracking-widest block">
              Islamorada Night Tour
            </span>
          </div>

          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body max-w-xl">
            Embark on an extraordinary adventure with Islamorada's exclusive Glassbottom Eco Tour at Night. Explore the captivating underwater world after dark, illuminated by underwater lights that showcase the vibrant nightlife of marine creatures. After your tour, join us at Hungry Tarpon Restaurant for a delightful dinner, where you can share tales of your underwater discoveries over delicious cuisine and relaxed surroundings.
          </p>

          <div class="pt-2">
            <a 
              href="/#glass-bottom" 
              class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-3 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
            >
              BOOK NOW
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. ISLAMORADA EVENING ACTIVITIES -->
    <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1340px] mx-auto space-y-8">
      <h2 class="text-center font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide">
        ISLAMORADA EVENING ACTIVITIES
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {eveningCards.map((card) => (
          <a 
            href={card.url}
            class="group relative rounded-2xl overflow-hidden shadow-lg aspect-[3/4] block transform hover:-translate-y-1.5 transition-all duration-300"
          >
            <img 
              src={card.image} 
              alt={card.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent flex items-center justify-center p-6 text-center">
              <h3 class="font-heading font-black text-2xl sm:text-3xl text-white uppercase tracking-wider drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">
                {card.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 7. TWILIGHT CALLOUT BANNER (TURQUOISE BACKGROUND WITH PALM TREES) -->
    <section class="relative w-full py-16 sm:py-20 px-6 text-center overflow-hidden flex items-center justify-center">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/evening-activities/imgi_73_17caced72b55809c117b33b07a05fa49.Reserve-a-table-scaled.webp" 
          alt="Reserve a table at Robbie's Marina" 
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
      </div>
      <div class="relative z-10 max-w-4xl mx-auto space-y-6">
        <p class="text-white text-sm sm:text-base lg:text-lg leading-relaxed font-body font-semibold drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)]">
          Experience the magic of twilight in Islamorada with these evening activities. Whether you're casting your line at Robbie's Marina, exploring local trails, or diving into the turquoise waters, there's something for everyone to enjoy at the end of the day.
        </p>

        <div>
          <a 
            href="/" 
            class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-9 py-3.5 text-xs sm:text-sm tracking-wider shadow-xl transition-colors duration-200"
          >
            RESERVE A TABLE
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
