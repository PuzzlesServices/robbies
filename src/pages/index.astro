---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header/Header.astro';
import HeroBanner from '../components/home/HeroBanner.astro';
import FeaturedInBar from '../components/home/FeaturedInBar.astro';
import WelcomeSection from '../components/home/WelcomeSection.astro';
---

<Layout title="Robbie’s of Islamorada | Voted #1 Place To Visit in Florida Keys">
	<!-- Header Navbar Replica (Fixed Sticky) -->
	<Header />

	<!-- Main Page Content -->
	<main class="flex-1 bg-white">
		<!-- Hero Banner with Video & 50th Badge Replica -->
		<HeroBanner />

		<!-- Featured In Press Bar (National Geographic, Hilton, Vogue, NYT, CNN) -->
		<FeaturedInBar />

		<!-- Welcome Intro Section (Welcome to Robbie's Marina & Live Webcam CTA) -->
		<WelcomeSection />
	</main>
</Layout>
