---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header/Header.astro';
import HeroBanner from '../components/home/HeroBanner.astro';
import FeaturedInBar from '../components/home/FeaturedInBar.astro';
import WelcomeSection from '../components/home/WelcomeSection.astro';
import AnniversaryBanner from '../components/home/AnniversaryBanner.astro';
import FeaturedCardsGrid from '../components/home/FeaturedCardsGrid.astro';
import HomeCarousel from '../components/home/HomeCarousel.astro';
import AboutSection from '../components/home/AboutSection.astro';
import HoursAndWeatherSection from '../components/home/HoursAndWeatherSection.astro';
import PartyBoatAndSnorkelingSection from '../components/home/PartyBoatAndSnorkelingSection.astro';
import BestFishingCarouselSection from '../components/home/BestFishingCarouselSection.astro';
import SunsetAndYachtSection from '../components/home/SunsetAndYachtSection.astro';
import BestThingsToDoSection from '../components/home/BestThingsToDoSection.astro';
import TestimonialsSection from '../components/home/TestimonialsSection.astro';
import DirectionsMapSection from '../components/home/DirectionsMapSection.astro';
import Footer from '../components/common/Footer.astro';
---

<Layout title="Robbie’s of Islamorada | Voted #1 Place To Visit in Florida Keys">
	<!-- Header Navbar Replica (Fixed Sticky) -->
	<Header />

	<!-- Main Page Content -->
	<main class="flex-1 bg-white">
		<!-- Hero Banner with Video & 50th Badge Replica -->
		<HeroBanner />

		<!-- Featured In Press Bar (National Geographic, Hilton, Vogue, NYT, CNN) -->
		<FeaturedInBar />

		<!-- Welcome Intro Section (Welcome to Robbie's Marina & Live Webcam CTA) -->
		<WelcomeSection />

		<!-- 50th Anniversary Showcase Banner (Celebrating 50 Years of Adventure) -->
		<AnniversaryBanner />

		<!-- Featured 4 Activity Cards Grid with Read More / Read Less Toggle -->
		<FeaturedCardsGrid />

		<!-- Interactive Full-Width Showcase Carousel (6 Slides: Party Boat, Beach Dining, Hungry Tarpon, Feed Tarpon, Snorkeling, Four Aces) -->
		<HomeCarousel />

		<!-- Split Video & Intro Text Section (Robbie's of Islamorada - Pegado al carrusel) -->
		<AboutSection />

		<!-- Hours of Operation 4-Quadrant Grid & Islamorada 7-Day Weather Forecast Widget -->
		<HoursAndWeatherSection />

		<!-- Captain Michael Partyboat Fishing & Florida Keys Snorkeling Tours (Zig-Zag Promo Sections) -->
		<PartyBoatAndSnorkelingSection />

		<!-- Best Fishing In Islamorada (6 Cards Interactive Carousel with 5 Stars Header) -->
		<BestFishingCarouselSection />

		<!-- Best Sunset Cruises & Four Aces Luxury Yacht Charter (Zig-Zag Showcase Sections) -->
		<SunsetAndYachtSection />

		<!-- The Best Things To Do in Islamorada (8 Cards Grid with Inline Read More / Read Less Toggles) -->
		<BestThingsToDoSection />

		<!-- Your Opinion Matters (Google Reviews Showcase Carousel & LEAVE REVIEW Button) -->
		<TestimonialsSection />

		<!-- Directions & Interactive Google Map (Mile Marker 77.5 Bayside Location) -->
		<DirectionsMapSection />
	</main>

	<!-- Footer Replica (Explore accordions closed by default, location cards & LocalKeysGuide badge) -->
	<Footer />
</Layout>
