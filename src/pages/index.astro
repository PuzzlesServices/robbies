---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header/Header.astro';
import { Anchor, Waves, Utensils, ShoppingBag, Camera, Compass } from 'lucide-astro';
---

<Layout title="Robbie’s of Islamorada | Voted #1 Place To Visit in Florida Keys">
	<!-- Header Navbar Replica -->
	<Header />

	<!-- Main Page Content Slot (Temporary Preview until next section step) -->
	<main class="flex-1 bg-[#F8FAFC]">
		<!-- Hero Preview Section -->
		<section class="relative bg-slate-900 text-white py-24 px-6 overflow-hidden">
			<!-- Background overlay simulation -->
			<div class="absolute inset-0 bg-gradient-to-r from-[#1C366E]/90 to-slate-900/80 z-10"></div>
			<div class="absolute inset-0 bg-[radial-gradient(#2D55FF_1px,transparent_1px)] [background-size:32px_32px] opacity-20"></div>

			<div class="relative z-20 max-w-6xl mx-auto text-center">
				<span class="inline-block bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold px-4 py-1.5 rounded-full text-xs uppercase tracking-widest mb-6">
					Welcome to Robbie's Marina
				</span>

				<h1 class="text-4xl md:text-6xl font-black font-heading tracking-tight mb-6 leading-tight">
					Home of the World-Famous <br/>
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-200">
						Tarpon Feeding!
					</span>
				</h1>

				<p class="text-slate-300 text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed font-body">
					Discover the exciting things to do in Islamorada during your visit to the Florida Keys. Boat rentals, charter fishing, dining at Hungry Tarpon, and open-air shopping!
				</p>

				<div class="flex flex-wrap justify-center gap-4">
					<a 
						href="https://www.robbies.com/islamorada-fishing.htm" 
						target="_blank" 
						class="px-8 py-3.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold rounded-xl shadow-lg transition-transform active:scale-95"
					>
						Book A Fishing Trip
					</a>
					<a 
						href="https://www.robbies.com/boat-rentals.htm" 
						target="_blank" 
						class="px-8 py-3.5 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/20 transition-colors"
					>
						Explore Rentals
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
