---
import Layout from '../layouts/Layout.astro';
import { Rocket, ShieldCheck, Sparkles, Code2, Cpu, ArrowRight, Github } from 'lucide-astro';
---

<Layout title="Robbies | Puzzles Services">
	<div class="relative overflow-hidden min-h-screen flex flex-col justify-between">
		<!-- Background Decorative Elements -->
		<div class="absolute -top-40 -left-40 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>
		<div class="absolute top-1/3 -right-40 w-96 h-96 bg-violet-600/20 rounded-full blur-3xl pointer-events-none"></div>
		<div class="absolute -bottom-40 left-1/3 w-96 h-96 bg-cyan-600/20 rounded-full blur-3xl pointer-events-none"></div>
		
		<!-- Grid Pattern Overlay -->
		<div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

		<!-- Header / Navigation -->
		<header class="relative z-10 border-b border-slate-800/60 bg-slate-950/60 backdrop-blur-md">
			<div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
				<div class="flex items-center space-x-3">
					<div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-indigo-500 via-violet-500 to-cyan-400 p-[1px] flex items-center justify-center shadow-lg shadow-indigo-500/20">
						<div class="h-full w-full bg-slate-950 rounded-[11px] flex items-center justify-center">
							<Cpu class="w-5 h-5 text-indigo-400" />
						</div>
					</div>
					<span class="text-xl font-bold font-outfit tracking-tight text-white">
						Robbies <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 font-normal">v1.0</span>
					</span>
				</div>
				
				<div class="flex items-center space-x-4">
					<a 
						href="https://github.com/PuzzlesServices/robbies" 
						target="_blank" 
						rel="noopener noreferrer"
						class="flex items-center space-x-2 text-sm text-slate-400 hover:text-white transition-colors duration-200"
					>
						<Github class="w-4 h-4" />
						<span>GitHub Repo</span>
					</a>
				</div>
			</div>
		</header>

		<!-- Hero Section -->
		<main class="relative z-10 max-w-5xl mx-auto px-6 py-20 my-auto text-center">
			<!-- Badge -->
			<div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs font-medium mb-8 backdrop-blur-sm">
				<Sparkles class="w-3.5 h-3.5 text-indigo-400" />
				<span>Proyecto Inicializado & Conectado a Vercel</span>
			</div>

			<!-- Main Title -->
			<h1 class="text-5xl md:text-7xl font-extrabold font-outfit text-white tracking-tight leading-[1.1] mb-6">
				Construyendo soluciones inteligentes con <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-violet-400 to-cyan-400">Astro & Tailwind</span>
			</h1>

			<!-- Subtitle -->
			<p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
				Entorno de desarrollo preparado con alta velocidad de compilación, gestión segura mediante <code class="text-indigo-300 bg-indigo-950/60 px-2 py-0.5 rounded border border-indigo-800/40">pnpm</code> y directrices claras de arquitectura.
			</p>

			<!-- Action Buttons -->
			<div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
				<a 
					href="/GUIDELINES.md" 
					class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-medium shadow-lg shadow-indigo-600/25 hover:shadow-indigo-600/40 transition-all duration-200 flex items-center justify-center space-x-2"
				>
					<span>Ver Directrices (GUIDELINES.md)</span>
					<ArrowRight class="w-4 h-4" />
				</a>
				<a 
					href="https://github.com/PuzzlesServices/robbies" 
					target="_blank" 
					rel="noopener noreferrer"
					class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-slate-900/80 hover:bg-slate-800 border border-slate-800 text-slate-300 hover:text-white font-medium transition-all duration-200 flex items-center justify-center space-x-2"
				>
					<Code2 class="w-4 h-4 text-slate-400" />
					<span>Explorar Repositorio</span>
				</a>
			</div>

			<!-- Status Grid -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
				<div class="p-6 rounded-2xl bg-slate-900/40 border border-slate-800/80 backdrop-blur-sm hover:border-slate-700/80 transition-colors">
					<div class="w-10 h-10 rounded-lg bg-indigo-500/10 flex items-center justify-center text-indigo-400 mb-4 border border-indigo-500/20">
						<Rocket class="w-5 h-5" />
					</div>
					<h3 class="text-base font-semibold text-white mb-1">Astro 5 & Tailwind v4</h3>
					<p class="text-sm text-slate-400">Rendimiento ultra rápido sin JavaScript innecesario en el cliente y motor de estilos avanzado.</p>
				</div>

				<div class="p-6 rounded-2xl bg-slate-900/40 border border-slate-800/80 backdrop-blur-sm hover:border-slate-700/80 transition-colors">
					<div class="w-10 h-10 rounded-lg bg-violet-500/10 flex items-center justify-center text-violet-400 mb-4 border border-violet-500/20">
						<ShieldCheck class="w-5 h-5" />
					</div>
					<h3 class="text-base font-semibold text-white mb-1">Gestión con pnpm</h3>
					<p class="text-sm text-slate-400">Instalación rápida, eficiente en espacio de disco y estricta en la resolución de árbol de dependencias.</p>
				</div>

				<div class="p-6 rounded-2xl bg-slate-900/40 border border-slate-800/80 backdrop-blur-sm hover:border-slate-700/80 transition-colors">
					<div class="w-10 h-10 rounded-lg bg-cyan-500/10 flex items-center justify-center text-cyan-400 mb-4 border border-cyan-500/20">
						<Sparkles class="w-5 h-5" />
					</div>
					<h3 class="text-base font-semibold text-white mb-1">Despliegue Automático</h3>
					<p class="text-sm text-slate-400">Integración continua lista para Vercel en cada push a la rama <code class="text-cyan-300">main</code>.</p>
				</div>
			</div>
		</main>

		<!-- Footer -->
		<footer class="relative z-10 border-t border-slate-950/80 bg-slate-950/80 py-6 text-center text-xs text-slate-500">
			<div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
				<p>© 2026 Puzzles Services. Todos los derechos reservados.</p>
				<p class="flex items-center space-x-1">
					<span>Robbies Dev Environment</span>
				</p>
			</div>
		</footer>
	</div>
</Layout>
