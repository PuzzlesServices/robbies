---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/common/Footer.astro';
import { Ticket, ShoppingBag, Trophy, Camera, Clock } from '@lucide/astro';
---

<Layout 
  title="Tarpon Feeding in Islamorada | Robbie's of Islamorada"
  description="Feed 100+ giant wild tarpon right from your hand at Robbie's Marina in Islamorada! Voted the #1 place to visit in the Florida Keys. Dock access $2.50, fish buckets $5.00."
  image="/assets/tarpon/imgi_45_BEST-TARPON-FEEDING-IN-ISLAMORADA-FLORIDA.png"
  schemaType="TouristAttraction"
>
  <Header />

  <main class="flex-1 bg-white font-sans selection:bg-robbies-ocean selection:text-white w-full">
    
    <!-- 1. HERO BANNER - UNTINTED PHOTO, CENTERED TEXT -->
    <section class="relative text-white py-20 sm:py-28 lg:py-36 px-4 overflow-hidden w-full min-h-[380px] sm:min-h-[460px] flex items-center justify-center">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/tarpon/imgi_45_BEST-TARPON-FEEDING-IN-ISLAMORADA-FLORIDA.png" 
          alt="Best Tarpon Feeding In The Florida Keys" 
          class="w-full h-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="relative z-10 max-w-[1280px] w-full mx-auto text-center space-y-3">
        <h1 class="font-heading font-black text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white drop-shadow-[0_2px_6px_rgba(0,0,0,0.7)] leading-[1.1] max-w-4xl mx-auto">
          Best Tarpon Feeding In The Florida Keys
        </h1>
      </div>
    </section>

    <!-- 2. FEED THE TARPON DARK NAVY BANNER WITH PRICE CARDS -->
    <section class="w-full bg-[#06395b] text-white">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
        <div class="w-full h-full min-h-[300px] sm:min-h-[380px] lg:min-h-[440px]">
          <img 
            src="/assets/tarpon/imgi_89_feed-the-tarpon1.png" 
            alt="Hand Feeding Tarpon at Robbie's Marina" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

        <div class="p-8 sm:p-12 lg:p-16 flex flex-col justify-center items-start space-y-6 bg-[#06395b]">
          <div class="inline-flex items-center gap-2 bg-[#00a8cc] text-white px-4 py-1.5 rounded-full text-xs sm:text-sm font-heading font-bold uppercase tracking-wider shadow">
            <Clock class="w-4 h-4 text-white" />
            <span>Tarpon Dock open daily 7am – 9pm</span>
          </div>

          <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-white tracking-wide leading-tight">
            Feed The Tarpon At Robbie's Marina For Affordable Fun In Islamorada!
          </h2>

          <p class="text-white/90 text-xs sm:text-sm leading-relaxed font-body max-w-xl">
            Whether you want to hand-feed massive tarpon, seek some thrills with our water sports, or stock up on handcrafted souvenirs at our fun, local shops, we've got something for everyone at Robbie's.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full pt-2">
            <div class="bg-[#00a8cc]/20 border border-[#00a8cc]/60 rounded-xl p-4 flex items-center gap-4">
              <div class="w-10 h-10 rounded-lg bg-[#00a8cc] flex items-center justify-center text-white flex-shrink-0">
                <Ticket class="w-5 h-5 text-white" />
              </div>
              <div>
                <span class="block text-white/80 font-heading font-bold text-[10px] uppercase tracking-wider">ADMISSION PER PERSON</span>
                <span class="text-white font-heading font-black text-xl">$2.50</span>
              </div>
            </div>

            <div class="bg-[#00a8cc]/20 border border-[#00a8cc]/60 rounded-xl p-4 flex items-center gap-4">
              <div class="w-10 h-10 rounded-lg bg-[#00a8cc] flex items-center justify-center text-white flex-shrink-0">
                <ShoppingBag class="w-5 h-5 text-white" />
              </div>
              <div>
                <span class="block text-white/80 font-heading font-bold text-[10px] uppercase tracking-wider">EACH BUCKET OF FISH</span>
                <span class="text-white font-heading font-black text-xl">$5</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VOTED THE #1 PLACE IN THE FLORIDA KEYS - BACKGROUND PHOTO WITH TWIN FLOATING WHITE CARDS -->
    <section class="relative w-full py-16 sm:py-24 px-4 sm:px-6 lg:px-12 overflow-hidden flex items-center justify-center min-h-[460px] sm:min-h-[520px]">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/activities/imgi_6_TARPON-FEEDING-1.webp" 
          alt="Feeding Tarpon at Robbie's Dock" 
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
      </div>

      <div class="relative z-10 max-w-[1180px] w-full mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 items-stretch">
        
        <!-- Card 1: Trophy Card -->
        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-2xl flex flex-col items-center text-center justify-center space-y-4">
          <div class="w-16 h-16 text-[#00a8cc] flex items-center justify-center">
            <svg class="w-full h-full" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <!-- Trophy Cup -->
              <path d="M20 12h24v16c0 6.6-5.4 12-12 12s-12-5.4-12-12V12z" fill="none" stroke="#00a8cc" stroke-width="3"/>
              <path d="M24 40v6a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4v-6" stroke="#00a8cc" stroke-width="3"/>
              <path d="M20 54h24" stroke="#00a8cc" stroke-width="4"/>
              <!-- Handles -->
              <path d="M20 16h-4a5 5 0 0 0-5 5v2a5 5 0 0 0 5 5h4" stroke="#00a8cc" stroke-width="2.5"/>
              <path d="M44 16h4a5 5 0 0 1 5 5v2a5 5 0 0 1-5 5h-4" stroke="#00a8cc" stroke-width="2.5"/>
              <!-- Laurel Wreath -->
              <path d="M10 38c-3-6-3-14 0-20" stroke="#00a8cc" stroke-width="2.5" stroke-dasharray="2 3"/>
              <path d="M54 38c3-6 3-14 0-20" stroke="#00a8cc" stroke-width="2.5" stroke-dasharray="2 3"/>
            </svg>
          </div>
          <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] leading-tight max-w-xs">
            Voted the #1 Place in the Florida Keys
          </h2>
          <p class="font-heading font-bold text-xs sm:text-sm text-[#37467a] tracking-wide">
            that every tourist should visit
          </p>
        </div>

        <!-- Card 2: Description Card -->
        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-2xl flex flex-col justify-center text-left space-y-4">
          <h3 class="font-heading font-black text-xl sm:text-2xl text-[#37467a]">
            Robbie's of Islamorada
          </h3>
          <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body">
            Gorge fresh, delicious seafood and sip one of our signature cocktails, local draft beer, or our famous loaded Trailer Trash Bloody Mary on the waterfront deck and enjoy the show of the tarpon feeding frenzy!
          </p>
          <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body">
            As a must-visit destination in the Florida Keys, our site shares what to do and where to eat at Robbie's Marina of Islamorada to help you plan your stop and create memorable moments with your family and friends. Remember, it's not a trip to the Keys without a visit to Robbie's!
          </p>
        </div>

      </div>
    </section>

    <!-- 4. LIVECAM SPOTLIGHT SECTIONS (2 WEBCAMS) -->
    <section class="w-full bg-[#f4f5f7] py-14 sm:py-18 px-6 sm:px-12 lg:px-16">
      <div class="max-w-[1340px] mx-auto space-y-12 sm:space-y-16">
        
        <!-- Webcam 1: Dock Livecam -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <div class="relative rounded-2xl overflow-hidden shadow-xl aspect-video bg-slate-900 group">
            <img 
              src="/assets/tarpon/imgi_46_tarpons-swimming.png" 
              alt="Livecam from Islamorada Webcam of Robbie's" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-slate-950/30 flex items-center justify-center">
              <div class="w-16 h-16 rounded-full bg-[#37467a]/90 text-white flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform">
                <svg class="w-8 h-8 fill-current ml-1" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <div class="flex items-center gap-2 text-[#37467a]">
              <Camera class="w-6 h-6 text-[#37467a]" />
            </div>
            <h3 class="font-heading font-black text-2xl sm:text-3xl text-[#37467a] uppercase tracking-wide leading-tight">
              LIVECAM FROM ISLAMORADA: WEBCAM OF ROBBIE'S
            </h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body">
              Sitting in your office bored or just checking out what's going on before stopping by? Click the play button and get a real view of what's going on at Robbie's right now with our Livecam from Islamorada!
            </p>
            <div class="pt-2">
              <a 
                href="/#webcam" 
                class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-3 text-xs sm:text-sm tracking-wider shadow transition-colors"
              >
                Watch on Youtube
              </a>
            </div>
          </div>
        </div>

        <!-- Webcam 2: Underwater Livecam -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <div class="space-y-4 order-2 lg:order-1">
            <div class="flex items-center gap-2 text-[#37467a]">
              <Camera class="w-6 h-6 text-[#37467a]" />
            </div>
            <h3 class="font-heading font-black text-2xl sm:text-3xl text-[#37467a] uppercase tracking-wide leading-tight">
              LIVE WEBCAM ROBBIE'S OF ISLAMORADA UNDERWATER
            </h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body">
              Not only do we bring you all the action on our docks, we are also now bringing you what's going on under the docks. See for yourself! Now on livecam from Islamorada!
            </p>
          </div>

          <div class="relative rounded-2xl overflow-hidden shadow-xl aspect-video bg-slate-900 group order-1 lg:order-2">
            <img 
              src="/assets/tarpon/imgi_46_tarpons-swimming.png" 
              alt="Live Webcam Robbie's of Islamorada Underwater" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-slate-950/30 flex items-center justify-center">
              <div class="w-16 h-16 rounded-full bg-[#37467a]/90 text-white flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform">
                <svg class="w-8 h-8 fill-current ml-1" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 5. "AMAZING," "BREATHTAKING," AND "IMPRESSIVE" SECTION (EDGE-TO-EDGE FULL-WIDTH 3-COLUMN LAYOUT) -->
    <section class="w-full max-w-none py-12 sm:py-16 lg:py-20 px-2 sm:px-4 lg:px-6 overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 sm:gap-4 lg:gap-6 items-stretch w-full">
        
        <!-- Left Vertical Image (Edge Touch) -->
        <div class="lg:col-span-3 min-h-[500px] sm:min-h-[600px] lg:min-h-[680px]">
          <div class="rounded-3xl sm:rounded-[2rem] overflow-hidden shadow-xl w-full h-full min-h-[500px] sm:min-h-[600px] lg:min-h-[680px]">
            <img 
              src="/assets/tarpon/imgi_53_Enmascarar-grupo-99-108x300.png" 
              alt="Tarpon feeding with pelicans" 
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Center Text Content -->
        <div class="lg:col-span-5 flex flex-col justify-center space-y-5 px-4 sm:px-8 lg:px-10 py-6">
          <span class="text-[#00a8cc] font-heading font-black text-xs sm:text-sm tracking-widest uppercase block">
            FEED THE TARPON
          </span>
          <h2 class="font-heading font-black text-3xl sm:text-4xl lg:text-5xl xl:text-6xl text-[#37467a] leading-tight">
            “Amazing,” “Breathtaking,” and “Impressive”
          </h2>
          <p class="text-slate-700 text-xs sm:text-sm lg:text-base leading-relaxed font-body">
            are words we often hear from first-time visitors. They're referring to the school of more than 100 tarpons that come here daily and linger for hours at Robbie's.
          </p>
          <p class="text-slate-700 text-xs sm:text-sm lg:text-base leading-relaxed font-body">
            Occasionally, a tarpon actually rises up from the water in a powerful flash of silver and green to meet the fish as it leaves your hand. It's a sight to behold!
          </p>
          <p class="text-slate-700 text-xs sm:text-sm lg:text-base leading-relaxed font-body">
            Maybe the "Silver Kings" just come here to see the humans, but toss a bait fish among them, and the water churns as these monsters vie for the snack, causing quite the unforgettable spectacle.
          </p>
        </div>

        <!-- Right 2 Vertical Images Side-by-Side (Edge Touch) -->
        <div class="lg:col-span-4 grid grid-cols-2 gap-3 sm:gap-4 min-h-[500px] sm:min-h-[600px] lg:min-h-[680px]">
          <div class="rounded-3xl sm:rounded-[2rem] overflow-hidden shadow-xl w-full h-full min-h-[500px] sm:min-h-[600px] lg:min-h-[680px]">
            <img 
              src="/assets/tarpon/imgi_54_Enmascarar-grupo-90.png" 
              alt="Kneeling to feed tarpon" 
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="rounded-3xl sm:rounded-[2rem] overflow-hidden shadow-xl w-full h-full min-h-[500px] sm:min-h-[600px] lg:min-h-[680px]">
            <img 
              src="/assets/tarpon/imgi_56_Enmascarar-grupo-100.png" 
              alt="People feeding tarpon at Robbie's Marina dock" 
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
        </div>

      </div>
    </section>

    <!-- 6. FULL WIDTH DOCK BANNER PHOTO WITH CENTERED TEXT -->
    <section class="relative w-full py-20 sm:py-28 px-6 overflow-hidden flex items-center justify-center min-h-[260px] sm:min-h-[320px]">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/activities/imgi_6_TARPON-FEEDING-1.webp" 
          alt="Feeding the Tarpon on Our Dock at Robbie's of Islamorada" 
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-slate-950/20"></div>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <h2 class="font-heading font-black text-2xl sm:text-4xl lg:text-5xl uppercase tracking-wide text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)] leading-tight">
          FEEDING THE TARPON ON OUR DOCK AT ROBBIE'S OF ISLAMORADA
        </h2>
      </div>
    </section>

    <!-- 7. FEEDING THE TARPON AT ROBBIE'S VIDEO WITH FULL-WIDTH DARK BLUE TARPON BACKDROP -->
    <section class="w-full py-10 sm:py-14 bg-white">
      <h2 class="font-heading font-black text-2xl sm:text-4xl text-[#37467a] uppercase tracking-wide text-center mb-8">
        Feeding the Tarpon at Robbie's
      </h2>

      <div class="relative w-full py-12 sm:py-16 px-4 bg-[#073b61] overflow-hidden flex items-center justify-center">
        <div class="absolute inset-0 z-0">
          <img 
            src="/assets/tarpon/imgi_46_tarpons-swimming.png" 
            alt="Tarpon Swimming Underwater Background" 
            class="w-full h-full object-cover object-center opacity-90"
            loading="lazy"
          />
        </div>

        <div class="relative z-10 max-w-4xl w-full mx-auto">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl aspect-video bg-slate-900 border-2 border-white/20 group">
            <img 
              src="/assets/tarpon/imgi_89_feed-the-tarpon1.png" 
              alt="Feeding the Tarpon at Robbie's Marina in Islamorada Video" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-slate-950/30 flex items-center justify-center">
              <div class="w-20 h-20 rounded-full bg-[#37467a]/90 text-white flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform">
                <svg class="w-10 h-10 fill-current ml-1" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. THE STORY OF SCARFACE - FULL WIDTH 50/50 -->
    <section class="w-full bg-white">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
        <div class="p-8 sm:p-12 lg:p-16 flex flex-col justify-center items-start space-y-4 bg-white order-2 lg:order-1">
          <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide leading-tight">
            The Story Of Scarface
          </h2>

          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body">
            Robbie and his wife Mona started feeding Scarface in 1976. Scarface appeared floundering in the shallow waters near the dock; Robbie saw the struggling tarpon and, thinking it had swum too shallow and gotten stuck on the bank, went out into the water to free it.
          </p>

          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body">
            He lifted the fish and saw that the right side of its jaw was torn open. Hoping to revive the tarpon, Robbie placed it in the oxygen-rich shrimp tank and called Doc Roach.
          </p>

          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body">
            The doctor showed up with his wife's mattress needles and some twine, and Scarface became the first known tarpon with stitches. After several days of force-feeding, Scarface showed good recovery and weight gain; six months later he was released into the waters off the dock.
          </p>

          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body">
            Afterwards, Scarface continued to frequent the docks; sometimes bringing a friend. Soon more and more of the fish began to appear. Today, the tradition continues, with visitors from all across the world coming to marvel at the spectacle and offer these magnificent creatures a snack.
          </p>

          <div class="pt-3">
            <a 
              href="/#history" 
              class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-3 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
            >
              History Page
            </a>
          </div>
        </div>

        <div class="w-full h-full min-h-[300px] sm:min-h-[380px] lg:min-h-[440px] order-1 lg:order-2">
          <img 
            src="/assets/tarpon/imgi_61_THE-STORY-OF-SCARFACE-802x1024.png" 
            alt="The Story of Scarface Tarpon Sign" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- 9. WHERE TO EAT WHILE YOU FEED THE TARPON? - FULL WIDTH 50/50 -->
    <section class="w-full bg-white">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
        <div class="w-full h-full min-h-[300px] sm:min-h-[380px] lg:min-h-[440px]">
          <img 
            src="/assets/tarpon/imgi_65_Where-to-eat-while-you-feed-the-Tarpon.png" 
            alt="Where To Eat While You Feed The Tarpon - Seafood Platter" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

        <div class="p-8 sm:p-12 lg:p-16 flex flex-col justify-center items-start space-y-4 bg-white">
          <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] leading-tight">
            Where To Eat While You Feed The Tarpon?
          </h2>

          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body">
            Our nearby ocean view restaurant has expanded to provide extensive waterfront dining. Hungry Tarpon Restaurant and Bar offers a large seafood menu with a wide variety of options that will make the entire family happy. Relax on our deck enjoying one of our signature cocktails; we recommend the famous loaded Trailer Trash Bloody Mary!
          </p>

          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body">
            Experience a local dining experience on the water at any time of the day. We are open at 6:30 AM for the early birds & sunrise chasers, & close down around 9 PM. Don't miss out on seeing the stars from the Hungry Tarpon deck if dining at night! Hungry Tarpon Waterfront Restaurant offers the best experience for where to eat in Islamorada, Florida Keys.
          </p>

          <div class="pt-3">
            <a 
              href="/" 
              class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-3 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
            >
              HUNGRY TARPON RESTAURANT
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
