---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/common/Footer.astro';
---

<Layout 
  title="Jet Ski in Islamorada | Robbie's of Islamorada"
  description="Experience high-speed wave action with Islamorada Jet Ski rentals and guided safari tours at Robbie's Marina! 14-22 mile tours, mangrove trails, and sandbars."
  image="/assets/jet-ski-adventures/imgi_45_jet-ski_banner.png"
  schemaType="TouristAttraction"
>
  <Header />

  <main class="flex-1 bg-white font-sans selection:bg-robbies-ocean selection:text-white w-full">
    
    <!-- 1. HERO BANNER - UNTINTED PHOTO, LEFT ALIGNED TEXT -->
    <section class="relative text-white py-20 sm:py-28 lg:py-32 px-6 sm:px-12 lg:px-16 overflow-hidden w-full min-h-[380px] sm:min-h-[440px] flex items-center">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/jet-ski-adventures/imgi_45_jet-ski_banner.png" 
          alt="Jet Ski Adventures in Islamorada Florida Keys" 
          class="w-full h-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="relative z-10 max-w-[1400px] w-full mx-auto text-left space-y-3">
        <h1 class="font-heading font-black text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] leading-[1.1] max-w-2xl">
          JET SKI IN ISLAMORADA
        </h1>

        <p class="font-heading font-bold text-xs sm:text-sm lg:text-base text-white uppercase tracking-wider drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] max-w-xl">
          HIGH-SPEED TOURS & RENTALS AT ROBBIE'S MARINA
        </p>
      </div>
    </section>

    <!-- 2. SPOTLIGHT 1: BEST PLACE TO JET-SKI - FULL WIDTH 50/50 -->
    <section class="w-full bg-[#f0f2f5]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
        <div class="w-full h-full min-h-[260px] sm:min-h-[320px]">
          <img 
            src="/assets/jet-ski-adventures/imgi_3_BEST-PLACE-TO-JET-SKI.webp" 
            alt="Best Place to Jet Ski in Florida Keys" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

        <div class="p-6 sm:p-10 lg:p-12 flex flex-col justify-center items-start space-y-4 bg-[#f0f2f5]">
          <div class="space-y-1">
            <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide leading-tight">
              BEST PLACE TO JET-SKI IN THE FLORIDA KEYS
            </h2>
            <span class="text-[#37467a] font-heading font-extrabold text-xs sm:text-sm tracking-widest uppercase block">
              AVAILABLE 7 DAYS A WEEK! | 14-22 MILE TOURS!
            </span>
          </div>

          <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body max-w-xl">
            Ride past the beautiful Key shores & mangrove tunnels in Islamorada. Within North America, the Florida Keys offer some of the most open water adventures, including jet skiing, ocean tours, and boat rentals. Robbie's Marina offers the best places to jet ski in the Florida Keys. If you're booking a Florida Keys vacation, you definitely should consider jet skiing as an activity.
          </p>

          <div class="pt-2">
            <a 
              href="tel:3056649875" 
              class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-2.5 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
            >
              BOOK NOW
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. SPOTLIGHT 2: ISLAMORADA JET SKI TOURS & RENTAL - FULL WIDTH 50/50 -->
    <section class="w-full bg-[#f0f2f5]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
        <div class="p-6 sm:p-10 lg:p-12 flex flex-col justify-center items-start space-y-4 bg-[#f0f2f5] order-2 lg:order-1">
          <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide leading-tight">
            ISLAMORADA JET SKI TOURS & RENTAL
          </h2>

          <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body max-w-xl">
            Explore 14-22 miles of turquoise waters surrounding Islamorada on top-of-the-line Yamaha WaveRunners. Our guided tours lead you through secret mangrove channels, open-ocean runs, and shallow sandbars where dolphins and manatees play in their natural habitats.
          </p>

          <div class="pt-2">
            <a 
              href="tel:3056649875" 
              class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-2.5 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
            >
              BOOK YOUR SAFARI
            </a>
          </div>
        </div>

        <div class="w-full h-full min-h-[260px] sm:min-h-[320px] order-1 lg:order-2">
          <img 
            src="/assets/jet-ski-adventures/imgi_48_ISLAMORADA-JET-SKI-TOURS-RENTAL.webp" 
            alt="Yamaha WaveRunner Rental at Robbie's Marina" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
