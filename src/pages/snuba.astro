---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/common/Footer.astro';
import { ChevronRight, Star, ShieldCheck, Compass, Calendar, Clock, DollarSign, Waves } from '@lucide/astro';

const calendarDays = [
  { day: "Sun", date: 13, available: false },
  { day: "Mon", date: 14, available: false },
  { day: "Tue", date: 15, available: false },
  { day: "Wed", date: 16, available: false },
  { day: "Thu", date: 17, available: false },
  { day: "Fri", date: 18, available: true },
  { day: "Sat", date: 19, available: true },
  { day: "Sun", date: 20, available: true },
  { day: "Mon", date: 21, available: true },
  { day: "Tue", date: 22, available: true },
  { day: "Wed", date: 23, available: true },
  { day: "Thu", date: 24, available: true },
  { day: "Fri", date: 25, available: true },
  { day: "Sat", date: 26, available: true },
  { day: "Sun", date: 27, available: true },
  { day: "Mon", date: 28, available: true },
  { day: "Tue", date: 29, available: true },
  { day: "Wed", date: 30, available: true }
];
---

<Layout 
  title="SNUBA Diving in Islamorada | Robbie's of Islamorada"
  description="Experience SNUBA diving at Robbie's Marina in Islamorada! Breathe effortlessly up to 20 feet underwater without scuba certification. Safe, guided coral reef tours."
  image="/assets/home/imgi_21_snuba.webp"
  schemaType="TouristAttraction"
>
  <Header />

  <main class="flex-1 bg-slate-50 font-sans selection:bg-robbies-ocean selection:text-white">
    
    <!-- 1. HERO BANNER -->
    <section class="relative bg-[#182A4D] text-white py-24 sm:py-32 lg:py-44 px-4 overflow-hidden border-b border-blue-900/40">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/home/imgi_21_snuba.webp" 
          alt="SNUBA Diving in Islamorada Florida Keys" 
          class="w-full h-full object-cover object-center opacity-55 mix-blend-overlay scale-105 transform"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#182A4D] via-[#182A4D]/40 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1280px] mx-auto text-center space-y-4">
        <div class="inline-flex items-center gap-2 bg-blue-500/20 backdrop-blur-md border border-blue-300/30 rounded-full px-4 py-1.5 text-xs sm:text-sm font-heading font-extrabold uppercase tracking-widest text-blue-200 shadow-sm">
          <Waves class="w-4 h-4 text-cyan-300" /> NO SCUBA CERTIFICATION REQUIRED (AGES 8+)
        </div>

        <h1 class="font-heading font-black text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white drop-shadow-lg leading-tight max-w-4xl mx-auto">
          SNUBA DIVING IN ISLAMORADA
        </h1>

        <!-- Breadcrumbs -->
        <div class="pt-4 flex items-center justify-center gap-2 text-xs text-white/80 font-medium tracking-wider uppercase">
          <a href="/" class="hover:text-blue-200 transition-colors">Home</a>
          <ChevronRight class="w-3.5 h-3.5 text-blue-300" />
          <a href="/activities" class="hover:text-blue-200 transition-colors">Activities</a>
          <ChevronRight class="w-3.5 h-3.5 text-blue-300" />
          <span class="text-white font-bold">SNUBA Diving</span>
        </div>
      </div>
    </section>

    <!-- 2. SECTION 1: EXPERIENCE THE BEST SNUBA DIVE -->
    <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-center bg-white rounded-3xl p-6 sm:p-10 shadow-xl border border-slate-100">
        <!-- Content Left -->
        <div class="space-y-5">
          <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#182A4D] uppercase tracking-wide leading-tight">
            Experience The Best Snuba Dive In Islamorada
          </h2>

          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body">
            Discover the wonders of the underwater world with our guided Snuba dives. Unlike traditional scuba diving, Snuba requires no certification, making it accessible to all adventurers! After a comprehensive safety briefing and equipment overview, you'll plunge into the crystal-clear waters, descending up to 20 feet below the surface.
          </p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body">
            Encounter majestic sea turtles, playful puffers, graceful rays, and an array of tropical fish as you navigate through our vibrant underwater reefs. All ages 8 and up welcome; all you need is the ability to swim and a sense of curiosity!
          </p>

          <div class="space-y-2 pt-2">
            <h3 class="font-heading font-black text-lg text-[#182A4D] uppercase">
              The Perfect Destination For Underwater Exploration
            </h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body">
              Located at Robbie's of Islamorada, Snuba the Reef is the ultimate destination to immerse yourself in the beauty of the Florida Keys. Make us your "must-visit" stop and embark on an adventure that will leave you awe-inspired by the wonders of the sea!
            </p>
          </div>
        </div>

        <!-- Diver Photo Right -->
        <div class="relative group rounded-2xl overflow-hidden shadow-lg aspect-[4/5]">
          <img 
            src="/assets/home/imgi_140_snuba-700x707.webp" 
            alt="SNUBA Diver Descending in Islamorada Coral Reef" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- 3. SECTION 2: SAFETY FIRST AT SUNDANCE WATERSPORTS -->
    <section class="py-6 sm:py-10 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-center bg-white rounded-3xl p-6 sm:p-10 shadow-xl border border-slate-100">
        <!-- Coral Reef Fish Image Left -->
        <div class="relative group rounded-2xl overflow-hidden shadow-lg aspect-[16/10]">
          <img 
            src="/assets/home/imgi_21_snuba.webp" 
            alt="Safety First at Sundance Watersports Snuba" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            loading="lazy"
          />
        </div>

        <!-- Safety Details Right -->
        <div class="space-y-4">
          <h2 class="font-heading font-black text-2xl sm:text-3xl text-[#182A4D] uppercase tracking-wide leading-tight">
            Safety First At Sundance Watersports' Snuba Diving
          </h2>

          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body">
            Safety is our top priority at Sundance Watersports. To Snuba the reef safely, proficiency in swimming and a general high fitness level is required. Our experienced certified dive guides are dedicated to ensuring a secure and engaging experience for all participants. If you have any medical concerns, please don't hesitate to contact us before making a reservation.
          </p>

          <div>
            <a 
              href="tel:3056649875" 
              class="inline-flex items-center gap-2 bg-[#2B447A] hover:bg-[#182A4D] text-white font-heading font-black uppercase rounded-full px-8 py-3.5 text-xs sm:text-sm tracking-wider shadow-md hover:shadow-xl transition-all"
            >
              BOOK NOW <ChevronRight class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. SECTION 3: EXPLORE THE STUNNING CORAL REEFS -->
    <section class="py-8 sm:py-12 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto bg-slate-100 rounded-3xl p-8 sm:p-12 border border-slate-200">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div>
          <span class="text-[#2B447A] font-heading font-extrabold text-xs tracking-widest uppercase block mb-1">
            ISLAMORADA SNUBA DIVING ADVENTURES
          </span>
          <h2 class="font-heading font-black text-2xl sm:text-3xl text-[#182A4D] uppercase tracking-tight">
            Explore The Stunning Coral Reefs Of Islamorada
          </h2>
        </div>

        <div>
          <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body">
            SNUBA Diving is your easiest and safest way to enjoy the Florida Keys gorgeous reefs which are filled with colorful fish and breathtaking coral formations. Swim underwater like a scuba diver with complete peace of mind!
          </p>
        </div>
      </div>
    </section>

    <!-- 5. REAL-TIME BOOKING CALENDAR WIDGET -->
    <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[800px] mx-auto space-y-6 text-center">
      <div class="inline-flex items-center gap-2 bg-emerald-50 text-emerald-700 font-heading font-bold text-xs uppercase tracking-widest px-4 py-1.5 rounded-full border border-emerald-200">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Real-time Availability
      </div>

      <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-200 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <h3 class="font-heading font-black text-lg sm:text-xl text-[#182A4D] uppercase">
            September 2026
          </h3>
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Daily Snuba Tours</span>
        </div>

        <div class="grid grid-cols-7 gap-2 text-center text-xs">
          {["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].map((day) => (
            <span class="font-heading font-bold text-slate-400 py-1 uppercase">{day}</span>
          ))}

          {calendarDays.map((d) => (
            <button 
              type="button"
              class={`py-3 rounded-xl font-heading font-bold text-xs sm:text-sm transition-all ${
                d.available 
                  ? 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm hover:scale-105 cursor-pointer' 
                  : 'bg-slate-100 text-slate-400 cursor-not-allowed'
              }`}
            >
              {d.date}
            </button>
          ))}
        </div>

        <p class="text-[11px] text-slate-500 font-medium">Click on any available date to reserve your tour instantly.</p>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
