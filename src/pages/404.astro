---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/common/Footer.astro';
import { migrationConfig } from '../migration/config';
---

<Layout title="Page Pending Migration - Robbie's" noindex={true}>
  <Header />

  <main class="flex-1 bg-slate-50 flex items-center justify-center min-h-[70vh]">
    <div class="max-w-md w-full text-center px-6 py-12 bg-white rounded-2xl shadow-sm border border-slate-200">
      <div class="w-16 h-16 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-[#2B55FF]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h1 class="text-2xl font-black font-heading text-slate-900 mb-3">Page Scheduled for Migration</h1>
      <p class="text-slate-600 mb-8 text-sm leading-relaxed">
        This page is scheduled to be migrated to Astro soon. In the meantime, you can view it on the current live website.
      </p>
      <a id="fallback-link" href={migrationConfig.oldSiteDomain} class="inline-flex bg-[#2B55FF] hover:bg-[#1D4ED8] text-white font-bold py-3 px-6 rounded-xl transition-colors">
        View this page on the current site &rarr;
      </a>
      <p class="mt-6 text-xs text-slate-400">Website Migration System</p>
    </div>
  </main>

  <script define:vars={{ oldSiteDomain: migrationConfig.oldSiteDomain }}>
    // Get the current path user tried to access and append to old domain
    document.addEventListener('DOMContentLoaded', () => {
      const fallbackLink = document.getElementById('fallback-link');
      if(fallbackLink) {
        fallbackLink.href = oldSiteDomain + window.location.pathname + window.location.search;
      }
    });
  </script>

  <Footer />
</Layout>
