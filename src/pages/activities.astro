---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/common/Footer.astro';

const watersportsCards = [
  {
    title: "JET SKI ADVENTURES",
    image: "/assets/activities/imgi_90_JET-SKI-ADVENTURES-1024x1010.webp",
    description: 'Fantastic Ride! 14-22 MILE TOURS! Explore the beautiful bays basins & mangrove tunnels in Islamorada! Get out and ride! Our 1 & 2 hour tours are fantastic. Discover 14 to 20 miles of beautiful turquoise waters all around Islamorada and experience dolphins and manatees playing in their natural habitats. Enjoy "The Best Part of Your Vacation" right here with the Kayak Shack! New Yamahas with reverse and step up ladders. "We love to ride"',
    buttonText: "Learn More",
    url: "/jet-ski-adventures",
  },
  {
    title: "KAYAK & PADDLE BOARD RENTALS",
    image: "/assets/activities/imgi_97_KAYAK-PADDLE-BOARD-RENTALS-1024x1010.webp",
    description: '"The Kayak Shack" offers the BEST kayaking in the Florida Keys. Explore two state parks – Indian Key & Lignumvitae Key. Observe mangrove eco-systems, island exploration & snorkeling in the turquoise waters of Islamorada.',
    buttonText: "Learn More",
    url: "/activities",
  }
];

const fishingCards = [
  {
    title: "FOUR ACES YACHT CHARTER",
    image: "/assets/activities/imgi_125_FOUR-ACES-LUXURY-YACHT-CHARTER-700x699.webp",
    description: "Four Aces, a 55-foot Hatteras, is waiting to take you on any adventure you can imagine.",
    buttonText: "Learn More",
    url: "/activities",
  },
  {
    title: "SUNSET CRUISES",
    image: "/assets/activities/imgi_134_BEST-SUNSET-CRUISES-IN-THE-FLORIDA-KEYS-700x700.webp",
    description: "Robbie's of Islamorada offers Sunset Cruises on either the 100+ passenger catamaran Blue, or with.",
    buttonText: "Learn More",
    url: "/evening-activities",
  }
];
---

<Layout 
  title="Activities at Robbie's of Islamorada | Best Things To Do"
  description="Robbie's Marina of Islamorada, home of the world-famous tarpon feeding! Discover tarpon feeding, tasting history, jet skis, kayaks, snuba, snorkeling, and boat rentals."
  image="/assets/activities/imgi_81_6531dadedcf730f335c17f4b1bf4b4db.ACTIVITIES-AT-ROBBIES-OF-ISLAMORADA-2.png"
  schemaType="TouristAttraction"
>
  <Header />

  <main class="flex-1 bg-white font-sans selection:bg-robbies-ocean selection:text-white w-full">
    
    <!-- 1. HERO BANNER - FULL WIDTH PHOTO LEFT ALIGNED TEXT -->
    <section class="relative text-white py-20 sm:py-28 lg:py-36 px-6 sm:px-12 lg:px-16 overflow-hidden w-full min-h-[380px] sm:min-h-[460px] lg:min-h-[520px] flex items-center">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/activities/imgi_81_6531dadedcf730f335c17f4b1bf4b4db.ACTIVITIES-AT-ROBBIES-OF-ISLAMORADA-2.png" 
          alt="Activities at Robbie's of Islamorada" 
          class="w-full h-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="relative z-10 max-w-[1400px] w-full mx-auto text-left space-y-3">
        <h1 class="font-heading font-black text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] leading-[1.1] max-w-2xl">
          ACTIVITIES AT ROBBIE'S OF ISLAMORADA
        </h1>

        <p class="font-heading font-bold text-xs sm:text-sm lg:text-base text-white uppercase tracking-wider drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] max-w-xl">
          BEST THINGS TO DO IN ISLAMORADA, FLORIDA KEYS
        </p>
      </div>
    </section>

    <!-- 2. SECTION 1: TARPON FEEDING - FULL WIDTH EDGE-TO-EDGE -->
    <section class="w-full bg-[#f0f2f5]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
        <div class="w-full h-full min-h-[260px] sm:min-h-[320px] lg:min-h-[360px]">
          <img 
            src="/assets/activities/imgi_6_TARPON-FEEDING-1.webp" 
            alt="Tarpon Feeding at Robbie's Marina" 
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>

        <div class="p-6 sm:p-10 lg:p-12 flex flex-col justify-center items-start space-y-4 bg-[#f0f2f5]">
          <div class="space-y-1">
            <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide leading-tight">
              TARPON FEEDING
            </h2>
            <span class="text-[#37467a] font-heading font-extrabold text-xs sm:text-sm tracking-widest uppercase block">
              THE BEST IN THE FLORIDA KEYS
            </span>
          </div>

          <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body max-w-xl">
            Robbie's Marina of Islamorada, home of the world-famous tarpon feeding! Here, you can discover the exciting things to do in the Florida Keys during your stop at Robbie's.
          </p>

          <div class="pt-2">
            <a 
              href="/tarpon" 
              class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-2.5 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
            >
              Learn More
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. SECTION 2: TASTING FLORIDA KEYS HISTORY - FULL WIDTH EDGE-TO-EDGE -->
    <section class="w-full bg-[#f0f2f5]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
        <div class="p-6 sm:p-10 lg:p-12 flex flex-col justify-center items-start space-y-4 bg-[#f0f2f5] order-2 lg:order-1">
          <div class="space-y-1">
            <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide leading-tight">
              TASTING FLORIDA KEYS HISTORY
            </h2>
            <span class="text-[#37467a] font-heading font-extrabold text-xs sm:text-sm tracking-widest uppercase block">
              WITH BRAD BERTELLI
            </span>
          </div>

          <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body max-w-xl">
            Every Monday & Thursday, dive into the rich history and flavors of the Florida Keys with local historian Brad Bertelli. Sip a rumrunner, savor traditional conch chowder and fritters, and finish with a sweet slice of Key lime pie. This one-hour exclusive experience at Robbie's combines fascinating stories and iconic island dishes for a true taste of Conch culture and the Conch Republic.
          </p>

          <div class="text-xs sm:text-sm space-y-1 text-slate-700 font-medium pt-1">
            <p><strong class="text-[#37467a]">Two available time slots:</strong></p>
            <p>Mondays & Thursdays</p>
            <p>11:30 AM – 12:30 PM</p>
            <p>2:30 PM – 3:30 PM</p>
            <p class="text-[#37467a] font-medium pt-1">Book your seat now for a delicious and historical lunch experience!</p>
          </div>

          <div class="pt-2">
            <a 
              href="/" 
              class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-2.5 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
            >
              Book Now
            </a>
          </div>
        </div>

        <div class="w-full h-full min-h-[260px] sm:min-h-[320px] lg:min-h-[360px] order-1 lg:order-2">
          <img 
            src="/assets/activities/imgi_84_Tasting-Florida-Keys-History.webp" 
            alt="Tasting Florida Keys History with Brad Bertelli" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- 4. BANNER 1: WATERSPORTS - FULL WIDTH -->
    <div class="w-full bg-[#37467a] text-white py-3.5 px-4 text-center">
      <h2 class="font-heading font-black text-base sm:text-xl lg:text-2xl uppercase tracking-widest text-white">
        WATERSPORTS ACTIVITIES IN ISLAMORADA
      </h2>
    </div>

    <!-- 5. WATERSPORTS CARDS GRID - CONTAINER -->
    <section class="py-8 sm:py-12 px-4 sm:px-6 lg:px-8 max-w-[1340px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {watersportsCards.map((card) => (
          <div class="bg-[#f0f2f5] border border-slate-200/80 overflow-hidden shadow-sm rounded-lg flex flex-col justify-between">
            <div>
              <div class="w-full aspect-[16/10] overflow-hidden">
                <img 
                  src={card.image} 
                  alt={card.title} 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>

              <div class="p-6 space-y-3">
                <h3 class="font-heading font-black text-lg sm:text-xl text-[#37467a] uppercase tracking-wide">
                  {card.title}
                </h3>
                <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body">
                  {card.description}
                </p>
              </div>
            </div>

            <div class="p-6 pt-0">
              <a 
                href={card.url}
                class="w-full inline-block text-center bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full py-2.5 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
              >
                {card.buttonText}
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. BANNER 2: UNDERWATER - FULL WIDTH -->
    <div class="w-full bg-[#37467a] text-white py-3.5 px-4 text-center">
      <h2 class="font-heading font-black text-base sm:text-xl lg:text-2xl uppercase tracking-widest text-white">
        BEST UNDERWATER ACTIVITIES IN ISLAMORADA
      </h2>
    </div>

    <!-- 7. UNDERWATER ZIG-ZAG SECTION - FULL WIDTH EDGE-TO-EDGE -->
    <section class="w-full">
      
      <!-- Row A: SNUBA -->
      <div class="w-full bg-[#f0f2f5]">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
          <div class="w-full h-full min-h-[260px] sm:min-h-[320px] lg:min-h-[360px]">
            <img 
              src="/assets/activities/imgi_104_SNUBA-DIVING-IN-ISLAMORADA-1.webp" 
              alt="SNUBA Diving in Islamorada" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <div class="p-6 sm:p-10 lg:p-12 flex flex-col justify-center items-start space-y-4 bg-[#f0f2f5]">
            <h3 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide">
              SNUBA DIVING IN ISLAMORADA
            </h3>
            <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body max-w-xl">
              The perfect spot to experience life beneath the sea with a guided SNUBA dive. At Robbie's of Islamorada, we are the "MUST" stop & visit place to experience the Florida Keys. Join the snuba diving adventure and get to know Islamorada best as possible.
            </p>
            <div class="pt-2">
              <a 
                href="/snuba" 
                class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-2.5 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
              >
                BOOK NOW
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Row B: SNORKELING IN THE KEYS -->
      <div class="w-full bg-[#f0f2f5]">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
          <div class="p-6 sm:p-10 lg:p-12 flex flex-col justify-center items-start space-y-4 bg-[#f0f2f5] order-2 lg:order-1">
            <h3 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide">
              SNORKELING IN THE KEYS
            </h3>
            <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body max-w-xl">
              Snorkel trips available on two different vessels. Blue departs twice a day, 10:00AM and 1:30PM. KeyZ Charters can be booked for parties of 6 people or less. Join our activities!
            </p>
            <div class="pt-2">
              <a 
                href="/snorkeling" 
                class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-2.5 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
              >
                BOOK NOW
              </a>
            </div>
          </div>

          <div class="w-full h-full min-h-[260px] sm:min-h-[320px] lg:min-h-[360px] order-1 lg:order-2">
            <img 
              src="/assets/activities/imgi_114_SNORKELING-AT-THE-KEYS-1.webp" 
              alt="Snorkeling in the Keys" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>

    </section>

    <!-- 8. BANNER 3: FISHING TRIPS - FULL WIDTH -->
    <div class="w-full bg-[#37467a] text-white py-3.5 px-4 text-center">
      <h2 class="font-heading font-black text-base sm:text-xl lg:text-2xl uppercase tracking-widest text-white">
        UNFORGETTABLE FISHING TRIPS IN ISLAMORADA
      </h2>
    </div>

    <!-- 9. FISHING CARDS GRID - CONTAINER -->
    <section class="py-8 sm:py-12 px-4 sm:px-6 lg:px-8 max-w-[1340px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {fishingCards.map((card) => (
          <div class="bg-[#f0f2f5] border border-slate-200/80 overflow-hidden shadow-sm rounded-lg flex flex-col justify-between">
            <div>
              <div class="w-full aspect-[16/10] overflow-hidden">
                <img 
                  src={card.image} 
                  alt={card.title} 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>

              <div class="p-6 space-y-3">
                <h3 class="font-heading font-black text-lg sm:text-xl text-[#37467a] uppercase tracking-wide">
                  {card.title}
                </h3>
                <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body">
                  {card.description}
                </p>
              </div>
            </div>

            <div class="p-6 pt-0">
              <a 
                href={card.url}
                class="w-full inline-block text-center bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full py-2.5 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
              >
                {card.buttonText}
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 10. ECO TOURS & BOAT RENTALS ZIG-ZAG SECTION - FULL WIDTH EDGE-TO-EDGE -->
    <section class="w-full">
      
      <!-- Row A: ECO TOURS -->
      <div class="w-full bg-[#f0f2f5]">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
          <div class="w-full h-full min-h-[260px] sm:min-h-[320px] lg:min-h-[360px]">
            <img 
              src="/assets/activities/imgi_139_ECO-TOURS-1-1024x692.webp" 
              alt="Robbie's Marina Eco Tours" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <div class="p-6 sm:p-10 lg:p-12 flex flex-col justify-center items-start space-y-4 bg-[#f0f2f5]">
            <h3 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide">
              ECO TOURS
            </h3>
            <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body max-w-xl">
              Robbie's Marina Eco-Tours are a perfect way to experience the raw beauty and wonder of Florida Bay. Our two-hour trips take you on an excursion through passages among the seagrass beds rimming the many protected shallow bays. We take you among the hundreds of small, uninhabited mangrove and hardwood hammock islands, which host an amazing variety of wildlife and create the island network of Florida Bay. To join our activities, book your trip now!
            </p>
            <div class="pt-2">
              <a 
                href="/#eco-tours" 
                class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-2.5 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
              >
                BOOK NOW
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Row B: ISLAMORADA BOAT RENTALS -->
      <div class="w-full bg-[#f0f2f5]">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
          <div class="p-6 sm:p-10 lg:p-12 flex flex-col justify-center items-start space-y-4 bg-[#f0f2f5] order-2 lg:order-1">
            <h3 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide">
              ISLAMORADA BOAT RENTALS
            </h3>
            <p class="text-slate-700 text-xs sm:text-sm leading-relaxed font-body max-w-xl">
              Want to go out fishing or maybe just drive in circles? Robbie's Boat Rentals in Islamorada is a perfect place to start your Florida Keys trip. Our location provides for quick access to a wide variety of popular Florida Keys attractions; some of the best fishing spots in both the Atlantic Ocean and Florida Bay are equally accessible from our docks, and nearby, narrow, winding mangrove-lined channels offer tranquil settings for bird watching.
            </p>
            <div class="pt-2">
              <a 
                href="/#boat-rentals" 
                class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-2.5 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
              >
                BOOK NOW
              </a>
            </div>
          </div>

          <div class="w-full h-full min-h-[260px] sm:min-h-[320px] lg:min-h-[360px] order-1 lg:order-2">
            <img 
              src="/assets/activities/imgi_144_BOAT-RENTALS-1.webp" 
              alt="Islamorada Boat Rentals" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>

    </section>

  </main>

  <Footer />
</Layout>
