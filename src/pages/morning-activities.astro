---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/common/Footer.astro';
import { Calendar } from '@lucide/astro';

const operationHours = [
  { name: "Robbie's Of Islamorada", hours: "Mon-Sun: 7:00am - 9:00pm" },
  { name: "Hungry Tarpon Restaurant", hours: "Mon-Sun: 6:30am - 9:00pm" },
  { name: "Tarpon Booth", hours: "Mon-Sun: 7:00am - 9:00pm" },
  { name: "Captain Michael Fishing", hours: "Mon-Sun: 7:00am - 8:00pm" }
];

const morningCards = [
  {
    title: "SNORKELING",
    image: "/assets/morning-activities/imgi_66_1837d0731af7c3407e9ebbd9119e3674.Snorkeling.webp",
    url: "/snorkeling"
  },
  {
    title: "JET SKI",
    image: "/assets/morning-activities/imgi_67_a8dbf7437b0c4eab0a6454998b0f2c9a.Jet-Ski.webp",
    url: "/jet-ski-adventures"
  },
  {
    title: "TARPON FEEDING",
    image: "/assets/morning-activities/imgi_68_daeccf3bf7d353f3c88ac7871491ee9e.Tarpon-Feeding.webp",
    url: "/tarpon"
  }
];
---

<Layout 
  title="Morning Activities in Islamorada | Robbie's of Islamorada"
  description="Avoid the crowd and discover the best morning activities in Islamorada at Robbie's Marina! Early morning tarpon feeding, hearty breakfast, jet ski rentals, and snorkeling."
  image="/assets/morning-activities/imgi_38_10092561dd1af065646679e461e1210e.Good-morning-Early-Birds-scaled.webp"
  schemaType="TouristAttraction"
>
  <Header />

  <main class="flex-1 bg-white font-sans selection:bg-robbies-ocean selection:text-white w-full">
    
    <!-- 1. HERO BANNER - UNTINTED FULL WIDTH PHOTO -->
    <section class="relative text-white py-20 sm:py-28 lg:py-36 px-4 overflow-hidden w-full min-h-[380px] sm:min-h-[460px] flex items-center justify-center">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/morning-activities/imgi_38_10092561dd1af065646679e461e1210e.Good-morning-Early-Birds-scaled.webp" 
          alt="Morning Activities in Islamorada" 
          class="w-full h-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="relative z-10 max-w-[1280px] w-full mx-auto text-center space-y-3">
        <h1 class="font-heading font-black text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white drop-shadow-[0_2px_6px_rgba(0,0,0,0.7)] leading-[1.1] max-w-4xl mx-auto">
          MORNING ACTIVITIES IN ISLAMORADA
        </h1>
      </div>
    </section>

    <!-- 2. INTRO SECTION: AVOID THE CROWD -->
    <section class="w-full bg-[#f4f5f7] py-10 sm:py-14 px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-[1100px] mx-auto space-y-4">
        <h2 class="font-heading font-black text-xl sm:text-2xl lg:text-3xl text-[#37467a] uppercase tracking-wide leading-snug">
          AVOID THE CROWD: BEST THINGS TO DO IN ISLAMORADA IN THE EARLY MORNING
        </h2>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body max-w-3xl mx-auto">
          Good morning, early birds! Rise with the sun and seize the day in Islamorada. Discover the best spots to kick-start your morning activities and make the most of your day in paradise. The best breakfast to start your day! Here are some of the best things to do in Islamorada in the morning.
        </p>
      </div>
    </section>

    <!-- 3. OPERATION HOURS AT ROBBIE'S - FULL WIDTH 50/50 -->
    <section class="w-full bg-white">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
        <div class="w-full h-full min-h-[280px] sm:min-h-[340px] lg:min-h-[380px]">
          <img 
            src="/assets/morning-activities/imgi_39_early-hours.webp" 
            alt="Islamorada Florida Keys Bridge Aerial View" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

        <div class="p-8 sm:p-12 lg:p-16 flex flex-col justify-center items-start space-y-6 bg-white">
          <h3 class="font-heading font-black text-2xl sm:text-3xl text-[#37467a] uppercase tracking-wide">
            OPERATION HOURS AT ROBBIE'S
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 w-full">
            {operationHours.map((item) => (
              <div class="space-y-1">
                <div class="flex items-center gap-2 text-[#37467a] font-heading font-bold text-xs sm:text-sm uppercase">
                  <Calendar class="w-4 h-4 text-[#37467a] flex-shrink-0" />
                  <span>{item.name}</span>
                </div>
                <p class="text-slate-500 text-xs pl-6 font-medium">{item.hours}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. BREAKFAST TIME! (HUNGRY TARPON RESTAURANT) - FULL WIDTH 50/50 -->
    <section class="w-full bg-white">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch w-full">
        <div class="p-8 sm:p-12 lg:p-16 flex flex-col justify-center items-start space-y-4 bg-white order-2 lg:order-1">
          <div class="space-y-1">
            <h3 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide leading-tight">
              BREAKFAST TIME!
            </h3>
            <span class="text-[#37467a] font-heading font-extrabold text-xs sm:text-sm tracking-widest block">
              Hungry Tarpon Restaurant
            </span>
          </div>

          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-body max-w-xl">
            Indulge in a hearty breakfast at Hungry Tarpon Restaurant, located in the heart of Islamorada. Our breakfast menu is crafted to fuel your day, featuring everything from classic favorites to local specialties. Join us and savor the flavors of the Keys before you embark on your day's journey.
          </p>

          <div class="pt-2">
            <a 
              href="/" 
              class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-3 text-xs sm:text-sm tracking-wider shadow transition-colors duration-200"
            >
              RESERVE A TABLE
            </a>
          </div>
        </div>

        <div class="w-full h-full min-h-[280px] sm:min-h-[340px] lg:min-h-[380px] order-1 lg:order-2">
          <img 
            src="/assets/morning-activities/imgi_45_Breakfast-Time.webp" 
            alt="Breakfast at Hungry Tarpon Restaurant Islamorada" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- 5. ISLAMORADA MORNING ACTIVITIES (3 CARDS GRID) -->
    <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1340px] mx-auto space-y-8">
      <h2 class="text-center font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#37467a] uppercase tracking-wide">
        ISLAMORADA MORNING ACTIVITIES
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {morningCards.map((card) => (
          <a 
            href={card.url}
            class="group relative rounded-2xl overflow-hidden shadow-lg aspect-[3/4] block transform hover:-translate-y-1.5 transition-all duration-300"
          >
            <img 
              src={card.image} 
              alt={card.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent flex items-center justify-center p-6 text-center">
              <h3 class="font-heading font-black text-2xl sm:text-3xl text-white uppercase tracking-wider drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">
                {card.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 6. FISHING CHARTERS SPOTLIGHT BANNER -->
    <section class="relative w-full py-20 sm:py-28 px-6 sm:px-12 lg:px-16 overflow-hidden flex items-center justify-end">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/morning-activities/imgi_69_fishing.webp" 
          alt="Fishing Charters in Islamorada" 
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
      </div>
      <div class="relative z-10 max-w-[1340px] w-full mx-auto flex flex-col items-end text-right space-y-3">
        <h2 class="font-heading font-black text-3xl sm:text-5xl uppercase tracking-tight text-white drop-shadow-[0_2px_6px_rgba(0,0,0,0.8)] leading-tight">
          FISHING CHARTERS
        </h2>
        <p class="text-white text-sm sm:text-base font-semibold drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">
          Check out our Fishing Charters in Islamorada!
        </p>
        <div class="pt-3">
          <a 
            href="/#charter-fishing" 
            class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-8 py-3 text-xs sm:text-sm tracking-wider shadow-lg transition-colors"
          >
            VIEW ALL CHARTERS
          </a>
        </div>
      </div>
    </section>

    <!-- 7. EARLY MORNING CALLOUT BANNER (TURQUOISE BACKGROUND WITH PALM TREES) -->
    <section class="relative w-full py-16 sm:py-20 px-6 text-center overflow-hidden flex items-center justify-center">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/morning-activities/imgi_70_17caced72b55809c117b33b07a05fa49.Reserve-a-table-scaled.webp" 
          alt="Reserve a table at Robbie's Marina" 
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
      </div>
      <div class="relative z-10 max-w-4xl mx-auto space-y-6">
        <p class="text-white text-sm sm:text-base lg:text-lg leading-relaxed font-body font-semibold drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)]">
          Experience the magic of early morning activities in Islamorada. Whether you're casting your line at Robbie's Marina, exploring local trails, or diving into the turquoise waters, there's something for everyone to enjoy at the break of dawn.
        </p>

        <div>
          <a 
            href="/" 
            class="inline-block bg-[#37467a] hover:bg-[#28345c] text-white font-heading font-bold uppercase rounded-full px-9 py-3.5 text-xs sm:text-sm tracking-wider shadow-xl transition-colors duration-200"
          >
            RESERVE A TABLE
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
