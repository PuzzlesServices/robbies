---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/common/Footer.astro';
import { ChevronRight, Clock, Star, Sunrise, Utensils, Anchor, Waves, Fish, Calendar } from '@lucide/astro';

const operationHours = [
  { name: "Robbie's of Islamorada", hours: "Mon-Sun: 7:00am – 5:30pm" },
  { name: "Hungry Tarpon Restaurant", hours: "Mon-Sun: 6:30am – 9:00pm" },
  { name: "Tarpon Booth", hours: "Mon-Sun: 7:00am – 5:00pm" },
  { name: "Captain Michael Fishing", hours: "Mon-Sun: 7:00am – 5:00pm" }
];

const morningCards = [
  {
    title: "SNORKELING",
    image: "/assets/home/imgi_22_snorkeling.webp",
    url: "/snorkeling"
  },
  {
    title: "JET SKI",
    image: "/assets/home/imgi_19_jet-ski.webp",
    url: "/jet-ski-adventures"
  },
  {
    title: "TARPON FEEDING",
    image: "/assets/home/imgi_18_feed-tarpon.webp",
    url: "/tarpon"
  }
];
---

<Layout 
  title="Morning Activities in Islamorada | Robbie's of Islamorada"
  description="Avoid the crowd and discover the best morning activities in Islamorada at Robbie's Marina! Early morning tarpon feeding, hearty breakfast, jet ski rentals, and snorkeling."
  image="/assets/home/imgi_18_feed-tarpon.webp"
  schemaType="TouristAttraction"
>
  <Header />

  <main class="flex-1 bg-slate-50 font-sans selection:bg-robbies-ocean selection:text-white">
    
    <!-- 1. HERO BANNER -->
    <section class="relative bg-[#182A4D] text-white py-24 sm:py-32 lg:py-40 px-4 overflow-hidden border-b border-blue-900/40">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/home/imgi_202_History-scaled.webp" 
          alt="Morning Activities in Islamorada Florida Keys" 
          class="w-full h-full object-cover object-center opacity-45 mix-blend-overlay scale-105 transform"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#182A4D] via-[#182A4D]/50 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1280px] mx-auto text-center space-y-4">
        <div class="inline-flex items-center gap-2 bg-blue-500/20 backdrop-blur-md border border-blue-300/30 rounded-full px-4 py-1.5 text-xs sm:text-sm font-heading font-extrabold uppercase tracking-widest text-blue-200 shadow-sm">
          <Sunrise class="w-4 h-4 text-amber-300" /> EARLY MORNING ADVENTURES
        </div>

        <h1 class="font-heading font-black text-3xl sm:text-5xl lg:text-6xl uppercase tracking-tight text-white drop-shadow-lg leading-tight max-w-4xl mx-auto">
          MORNING ACTIVITIES IN ISLAMORADA
        </h1>

        <!-- Breadcrumbs -->
        <div class="pt-4 flex items-center justify-center gap-2 text-xs text-white/80 font-medium tracking-wider uppercase">
          <a href="/" class="hover:text-blue-200 transition-colors">Home</a>
          <ChevronRight class="w-3.5 h-3.5 text-blue-300" />
          <a href="/activities" class="hover:text-blue-200 transition-colors">Activities</a>
          <ChevronRight class="w-3.5 h-3.5 text-blue-300" />
          <span class="text-white font-bold">Morning Activities</span>
        </div>
      </div>
    </section>

    <!-- 2. INTRO SECTION: AVOID THE CROWD -->
    <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1000px] mx-auto text-center space-y-4">
      <h2 class="font-heading font-black text-xl sm:text-2xl lg:text-3xl text-[#182A4D] uppercase tracking-wide leading-snug">
        AVOID THE CROWD: BEST THINGS TO DO IN ISLAMORADA IN THE EARLY MORNING
      </h2>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-body max-w-3xl mx-auto">
        Good morning, early birds! Rise with the sun and enjoy the day in Islamorada. Discover top spots to kickstart your morning activities and make the most of your day in paradise. The best time to start your day! Here are some of the best things to do in Islamorada in the morning.
      </p>
    </section>

    <!-- 3. OPERATION HOURS AT ROBBIE'S -->
    <section class="py-6 sm:py-10 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center bg-white rounded-3xl p-6 sm:p-10 shadow-xl border border-slate-100">
        <!-- Aerial Bridge Image -->
        <div class="relative group rounded-2xl overflow-hidden shadow-lg aspect-[16/10]">
          <img 
            src="/assets/home/hero-tarpon.jpg" 
            alt="Islamorada Florida Keys Bridge" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            loading="lazy"
          />
        </div>

        <!-- Hours List & Quadrants -->
        <div class="space-y-6">
          <h3 class="font-heading font-black text-2xl sm:text-3xl text-[#182A4D] uppercase tracking-wide">
            OPERATION HOURS AT ROBBIE'S
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {operationHours.map((item) => (
              <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-1.5 shadow-sm hover:border-blue-300 transition-colors">
                <div class="flex items-center gap-2 text-[#2B447A] font-heading font-bold text-xs uppercase">
                  <Clock class="w-4 h-4 text-blue-600 flex-shrink-0" />
                  <span>{item.name}</span>
                </div>
                <p class="text-slate-700 font-semibold text-xs pl-6">{item.hours}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. BREAKFAST TIME! (HUNGRY TARPON RESTAURANT) -->
    <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center bg-white rounded-3xl p-6 sm:p-10 shadow-xl border border-slate-100">
        <div class="space-y-5">
          <div class="space-y-1">
            <span class="text-[#2B447A] font-heading font-extrabold text-xs tracking-widest uppercase block">
              HUNGRY TARPON RESTAURANT
            </span>
            <h3 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#182A4D] uppercase tracking-wide leading-tight">
              BREAKFAST TIME!
            </h3>
          </div>

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-body">
            Indulge in a hearty breakfast at Hungry Tarpon Restaurant, located in the heart of Islamorada. Our breakfast menu is crafted to fuel your day, featuring everything from classic favorites to local specialties. Join us and savour the flavors of the Keys before you embark on your day's journey.
          </p>

          <div>
            <a 
              href="/" 
              class="inline-flex items-center gap-2 bg-[#2B447A] hover:bg-[#182A4D] text-white font-heading font-black uppercase rounded-full px-8 py-3.5 text-xs sm:text-sm tracking-wider shadow-md hover:shadow-xl transition-all"
            >
              RESERVE A TABLE <ChevronRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <div class="relative group rounded-2xl overflow-hidden shadow-lg aspect-[4/3]">
          <img 
            src="/assets/home/imgi_116_Hungry-tarpon1-300x290.webp" 
            alt="Breakfast at Hungry Tarpon Restaurant Islamorada" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- 5. ISLAMORADA MORNING ACTIVITIES (3 CARDS OVERLAY) -->
    <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto space-y-8">
      <h2 class="text-center font-heading font-black text-2xl sm:text-3xl lg:text-4xl text-[#182A4D] uppercase tracking-wide">
        ISLAMORADA MORNING ACTIVITIES
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {morningCards.map((card) => (
          <a 
            href={card.url}
            class="group relative rounded-3xl overflow-hidden shadow-xl aspect-[3/4] block transform hover:-translate-y-1.5 transition-all duration-300"
          >
            <img 
              src={card.image} 
              alt={card.title} 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent flex items-center justify-center p-6 text-center">
              <h3 class="font-heading font-black text-xl sm:text-2xl lg:text-3xl text-white uppercase tracking-widest drop-shadow-md group-hover:text-blue-300 transition-colors">
                {card.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 6. FISHING CHARTERS SPOTLIGHT BANNER -->
    <section class="relative bg-[#182A4D] text-white py-20 sm:py-28 px-4 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/home/imgi_51_TARPON-SHARK-FISHING.webp" 
          alt="Fishing Charters in Islamorada" 
          class="w-full h-full object-cover object-center opacity-45 mix-blend-overlay"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#182A4D]/90 via-[#182A4D]/60 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1280px] mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <h2 class="font-heading font-black text-2xl sm:text-4xl uppercase tracking-wide text-white drop-shadow">
            FISHING CHARTERS
          </h2>
          <p class="text-blue-200 text-sm sm:text-base font-medium">
            Check out our premier Fishing Charters in Islamorada!
          </p>
        </div>

        <div>
          <a 
            href="/#charter-fishing" 
            class="inline-flex items-center gap-2 bg-[#2B447A] hover:bg-white hover:text-[#182A4D] text-white font-heading font-black uppercase rounded-full px-8 py-3.5 text-xs sm:text-sm tracking-wider shadow-lg transition-all transform hover:-translate-y-0.5"
          >
            VIEW ALL CHARTERS <ChevronRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>

    <!-- 7. EARLY MORNING BANNER CTA -->
    <section class="relative bg-[#0284C7] text-white py-16 sm:py-20 px-4 text-center overflow-hidden">
      <div class="relative z-10 max-w-3xl mx-auto space-y-6">
        <p class="text-white/95 text-sm sm:text-base md:text-lg leading-relaxed font-body drop-shadow-sm font-medium">
          Experience the magic of early morning activities in Islamorada. Whether you're casting your line at Robbie's Marina, exploring local trails, or diving into the turquoise waters, there's something for everyone to enjoy at the break of dawn.
        </p>

        <div>
          <a 
            href="/" 
            class="inline-flex items-center gap-2 bg-[#182A4D] hover:bg-white hover:text-[#182A4D] text-white font-heading font-black uppercase rounded-full px-10 py-4 text-xs sm:text-sm tracking-wider shadow-xl transition-all transform hover:-translate-y-0.5"
          >
            RESERVE A TABLE <ChevronRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
